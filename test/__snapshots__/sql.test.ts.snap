exports[`sqlite > create with database ids: MATCH (a:A), (b:B) CREATE (a)-[:T {k: a.k}]->(b), (b)-[:BACK]->(:New) 1`] = `
"MATCH (a:A), (b:B) CREATE (a)-[:T {k: a.k}]->(b), (b)-[:BACK]->(:New)
-- step 1
SELECT n0."id" AS r0, n1."id" AS r1, (n0."properties" -> ('$."' || ? || '"')) AS r2 FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND EXISTS (SELECT 1 FROM json_each(n1."labels") WHERE json_each.value = ?) LIMIT ?
-- values: "k", "A", "B", limit(maxRowsPerStep + 1)
-- step 2 (for each source row)
INSERT INTO "edges" ("start_id", "end_id", "type", "properties") VALUES (?, ?, ?, ?) RETURNING "id" AS id
-- values: row.r0, row.r1, "T", {k: row.r2}
-- step 3 (for each source row)
INSERT INTO "nodes" ("labels", "properties") VALUES (?, ?) RETURNING "id" AS id
-- values: ["New"], {}
-- step 4 (for each source row)
INSERT INTO "edges" ("start_id", "end_id", "type", "properties") VALUES (?, ?, ?, ?) RETURNING "id" AS id
-- values: row.r1, id(entity 1), "BACK", {}"
`;

exports[`sqlite > create with database ids: UNWIND $rows AS row CREATE (:N {v: row.v}) 1`] = `
"UNWIND $rows AS row CREATE (:N {v: row.v})
-- step 1
SELECT ((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value ELSE json_quote(u0.value) END) -> ('$."' || ? || '"')) AS r0 FROM json_each(?) AS u0 WHERE NOT (u0.key IS NULL AND u0.type = 'null') ORDER BY u0.key LIMIT ?
-- values: "v", $rows, limit(maxRowsPerStep + 1)
-- step 2 (for each source row)
INSERT INTO "nodes" ("labels", "properties") VALUES (?, ?) RETURNING "id" AS id
-- values: ["N"], {v: row.r0}"
`;

