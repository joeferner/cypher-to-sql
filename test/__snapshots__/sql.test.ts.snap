exports[`postgres > read: MATCH (n) WHERE (n)-[:T]->() AND NOT EXISTS { (n)<-[r]-(m) WHERE r.w > m.w } RETURN [(n)-->(x) | x.k] 1`] = `
"MATCH (n) WHERE (n)-[:T]->() AND NOT EXISTS { (n)<-[r]-(m) WHERE r.w > m.w } RETURN [(n)-->(x) | x.k]
-- step 1
