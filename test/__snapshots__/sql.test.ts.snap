`;

exports[`postgres > read: MATCH (n) RETURN DISTINCT n.name AS name ORDER BY name 1`] = `
"MATCH (n) RETURN DISTINCT n.name AS name ORDER BY name
-- step 1
SELECT * FROM (SELECT DISTINCT ((n0."properties" -> $1::text))::text AS c0, (CASE (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'datetime' THEN 6 WHEN 'localdatetime' THEN 7 WHEN 'date' THEN 8 WHEN 'time' THEN 9 WHEN 'localtime' THEN 10 WHEN 'duration' THEN 11 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) AS k0, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN ((((n0."properties" -> $1::text) -> $2::text) #>> '{}') COLLATE "C") END) AS k1, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof((n0."properties" -> $1::text)) = 'number' THEN (n0."properties" -> $1::text) END)::numeric END) AS k2, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN (((n0."properties" -> $1::text) #>> '{}') COLLATE "C") END) AS k3, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN (CASE WHEN jsonb_typeof((n0."properties" -> $1::text)) = 'boolean' THEN (n0."properties" -> $1::text) END)::boolean END) AS k4, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) = 'list' THEN ((SELECT COALESCE(string_agg((CASE WHEN lkv.t IN ('integer', 'float') THEN 'I' || (SELECT CASE WHEN f = 'NaN'::float8 THEN 'P' WHEN f = 0 THEN 'M' WHEN f = 'Infinity'::float8 THEN 'O' WHEN f = '-Infinity'::float8 THEN 'K' WHEN f > 0 THEN 'N' || to_char(e + 400, 'FM000') || to_char(abs(f) / power(10::float8, e), 'FM0.000000000000000') ELSE 'L' || to_char(599 - e, 'FM000') || to_char(10 - abs(f) / power(10::float8, e), 'FM0.000000000000000') END FROM (SELECT f, GREATEST(CASE WHEN abs(f) / power(10::float8, e0) >= 10 THEN e0 + 1 WHEN abs(f) / power(10::float8, e0) < 1 THEN e0 - 1 ELSE e0 END, -300) AS e FROM (SELECT f, GREATEST(floor(log(CASE WHEN f = 0 OR f IN ('Infinity'::float8, '-Infinity'::float8, 'NaN'::float8) THEN 1 ELSE abs(f) END))::int, -300) AS e0 FROM (SELECT ((CASE WHEN jsonb_typeof(lkv.v) = 'number' THEN lkv.v END)::double precision)::float8 AS f) AS x) AS y) AS z) WHEN lkv.t = 'string' THEN 'G' || (replace((lkv.v #>> '{}'), chr(1), chr(1) || chr(2)) || chr(1) || chr(1)) WHEN lkv.t = 'boolean' THEN 'H' || (CASE WHEN (CASE WHEN jsonb_typeof(lkv.v) = 'boolean' THEN lkv.v END)::boolean THEN '1' ELSE '0' END) WHEN lkv.t = 'null' THEN 'J' ELSE (CASE lkv.t WHEN 'map' THEN 'B' WHEN 'node' THEN 'C' WHEN 'relationship' THEN 'D' WHEN 'list' THEN 'E' ELSE 'F' END) || (replace((lkv.v)::text, chr(1), chr(1) || chr(2)) || chr(1) || chr(1)) END), '' ORDER BY lkv.o), '') || 'A' FROM (SELECT lk0.value AS v, (CASE jsonb_typeof(lk0.value) WHEN 'number' THEN CASE WHEN (lk0.value)::text ~ '^-?[0-9]+$' AND (lk0.value)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((lk0.value) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t, lk0.ord AS o FROM LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof((n0."properties" -> $1::text)) = 'array' THEN (n0."properties" -> $1::text) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT (n0."properties" -> $1::text), 1 WHERE jsonb_typeof((n0."properties" -> $1::text)) NOT IN ('array', 'null')) AS lk0) AS lkv) COLLATE "C") WHEN (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('map', 'node', 'relationship', 'path') THEN (((n0."properties" -> $1::text))::text COLLATE "C") END) AS k5 FROM "nodes" AS n0) AS d ORDER BY d.k0 ASC, d.k1 ASC, d.k2 ASC, d.k3 ASC, d.k4 ASC, d.k5 ASC LIMIT $3
-- values: "name", "~k", limit(maxRowsPerStep + 1)"
`;

