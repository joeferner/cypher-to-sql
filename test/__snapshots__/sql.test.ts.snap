exports[`postgres > read: MATCH (n) WHERE n.age > 30 AND n.name STARTS WITH $p RETURN n.name, n.age + 1 AS next 1`] = `
"MATCH (n) WHERE n.age > 30 AND n.name STARTS WITH $p RETURN n.name, n.age + 1 AS next
-- step 1
SELECT ((n0."properties" -> $1::text))::text AS c0, ((SELECT (CASE WHEN s2.t0 = 'null' OR s2.t1 = 'null' THEN NULL WHEN s2.t0 = 'integer' AND s2.t1 = 'integer' THEN to_jsonb(((CASE WHEN jsonb_typeof((n0."properties" -> $2::text)) = 'number' THEN (n0."properties" -> $2::text) END)::bigint + (CASE WHEN jsonb_typeof(to_jsonb(($3::bigint))) = 'number' THEN to_jsonb(($3::bigint)) END)::bigint)) WHEN s2.t0 IN ('integer', 'float') AND s2.t1 IN ('integer', 'float') THEN (SELECT CASE WHEN f IN ('NaN'::float8, 'Infinity'::float8, '-Infinity'::float8) THEN NULL WHEN f::text::numeric = trunc(f::text::numeric) THEN to_jsonb(round(f::text::numeric, 1)) ELSE to_jsonb(f::text::numeric) END FROM (SELECT (((CASE WHEN jsonb_typeof((n0."properties" -> $2::text)) = 'number' THEN (n0."properties" -> $2::text) END)::double precision + (CASE WHEN jsonb_typeof(to_jsonb(($3::bigint))) = 'number' THEN to_jsonb(($3::bigint)) END)::double precision))::double precision AS f) AS ft) WHEN s2.t0 = 'string' AND s2.t1 = 'string' THEN to_jsonb((((n0."properties" -> $2::text) #>> '{}') || (to_jsonb(($3::bigint)) #>> '{}'))) WHEN s2.t0 = 'list' OR s2.t1 = 'list' THEN ((CASE WHEN s2.t0 = 'list' THEN (n0."properties" -> $2::text) ELSE jsonb_build_array((n0."properties" -> $2::text)) END) || (CASE WHEN s2.t1 = 'list' THEN to_jsonb(($3::bigint)) ELSE jsonb_build_array(to_jsonb(($3::bigint))) END)) END) FROM (SELECT (CASE jsonb_typeof((n0."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE jsonb_typeof(to_jsonb(($3::bigint))) WHEN 'number' THEN CASE WHEN (to_jsonb(($3::bigint)))::text ~ '^-?[0-9]+$' AND (to_jsonb(($3::big