exports[`postgres > read: MATCH (n)-->(m) RETURN n, collect(DISTINCT m.name), avg(m.age) 1`] = `
"MATCH (n)-->(m) RETURN n, collect(DISTINCT m.name), avg(m.age)
-- step 1
SELECT g.g0_id AS c0_id, (g.g0_labels)::text AS c0_labels, (g.g0_properties)::text AS c0_props, (g.x0)::text AS c1, g.x1 AS c2 FROM (SELECT n0."id" AS g0_id, n0."labels" AS g0_labels, n0."properties" AS g0_properties, COALESCE(jsonb_agg(DISTINCT (n1."properties" -> $1::text)) FILTER (WHERE NOT (COALESCE(jsonb_typeof((n1."properties" -> $1::text)), 'null') = 'null')), '[]'::jsonb) AS x0, AVG(CASE WHEN (CASE jsonb_typeof((n1."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n1."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n1."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n1."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((CASE WHEN jsonb_typeof((n1."properties" -> $2::text)) = 'number' THEN (n1."properties" -> $2::text) END)::numeric)::double precision END) AS x1 FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 CROSS JOIN "edges" AS e2 WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id" GROUP BY n0."id", n0."labels", n0."properties") AS g LIMIT $3
-- values: "name", "age", limit(maxRowsPerStep + 1)"
`;

