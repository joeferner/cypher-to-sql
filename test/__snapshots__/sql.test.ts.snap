exports[`sqlite > read: UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max 1`] = `
"UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max
-- step 1
SELECT (n2."properties" -> ('$."' || ? || '"')) AS c0, (CASE u1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u1.value WHEN 'object' THEN u1.value ELSE json_quote(u1.value) END) AS c1 FROM json_each(?) AS u0 CROSS JOIN json_each((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value ELSE json_quote(u0.value) END)) AS u1 CROSS JOIN "nodes" AS n2 WHERE NOT (u0.key IS NULL AND u0.type = 'null') AND NOT (u1.key IS NULL AND u1.type = 'null') AND EXISTS (SELECT 1 FROM json_each(n2."labels") WHERE json_each.value = ?) ORDER BY u0.key, u1.key, n2."id" LIMIT ?
-- values: "k", $lists, "N", limit($max)"
`;

