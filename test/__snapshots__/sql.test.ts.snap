-- values: "R", "1", "w", limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: MATCH p = (a)-[r]->(b)-[*1..2]->(c) RETURN p, length(p), nodes(p) 1`] = `
"MATCH p = (a)-[r]->(b)-[*1..2]->(c) RETURN p, length(p), nodes(p)
-- step 1
SELECT ((CASE WHEN n0."id" IS NULL OR e2."id" IS NULL OR n1."id" IS NULL OR v4.path IS NULL THEN (NULL::jsonb) ELSE jsonb_build_object('~cypher'::text, 'path'::text, '~nodes'::text, (jsonb_build_array((n0."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n0."id", '~labels'::text, n0."labels")), (n1."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n1."id", '~labels'::text, n1."labels"))) || (CASE WHEN v4.nodes IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, ve."id", '~labels'::text, ve."labels")) ORDER BY vu.i) FROM unnest(v4.nodes) WITH ORDINALITY AS vu(id, i) JOIN "nodes" AS ve ON ve."id" = vu.id), '[]'::jsonb) END)), '~relationships'::text, (jsonb_build_array((e2."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, e2."id", '~type'::text, e2."type", '~start'::text, e2."start_id", '~end'::text, e2."end_id"))) || (CASE WHEN v4.path IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, ve."id", '~type'::text, ve."type", '~start'::text, ve."start_id", '~end'::text, ve."end_id")) ORDER BY vu.i) FROM unnest(v4.path) WITH ORDINALITY AS vu(id, i) JOIN "edges" AS ve ON ve."id" = vu.id), '[]'::jsonb) END))) END))::text AS c0, (SELECT jsonb_array_length(CASE WHEN jsonb_typeof((s0.v0 -> $1::text)) = 'array' THEN (s0.v0 -> $1::text) END) FROM (SELECT x.v0 AS v0, (CASE jsonb_typeof(x.v0) WHEN 'number' THEN CASE WHEN (x.v0)::text ~ '^-?[0-9]+$' AND (x.v0)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v0) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT (CASE WHEN n0."id" IS NULL OR e2."id" IS NULL OR n1."id" IS NULL OR v4.path IS NULL THEN (NULL::jsonb) ELSE jsonb_build_object('~cypher'::text, 'path'::text, '~nodes'::text, (jsonb_build_array((n0."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n0."id", '~labels'::text, n0."labels")), (n1."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n1."id", '~labels'::text, n1."labels"))) || (CASE WHEN v4.nodes IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, ve."id", '~labels'::text, ve."labels")) ORDER BY vu.i) FROM unnest(v4.nodes) WITH ORDINALITY AS vu(id, i) JOIN "nodes" AS ve ON ve."id" = vu.id), '[]'::jsonb) END)), '~relationships'::text, (jsonb_build_array((e2."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, e2."id", '~type'::text, e2."type", '~start'::text, e2."start_id", '~end'::text, e2."end_id"))) || (CASE WHEN v4.path IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, ve."id", '~type'::text, ve."type", '~start'::text, ve."start_id", '~end'::text, ve."end_id")) ORDER BY vu.i) FROM unnest(v4.path) WITH ORDINALITY AS vu(id, i) JOIN "edges" AS ve ON ve."id" = vu.id), '[]'::jsonb) END))) END) AS v0 OFFSET 0) AS x OFFSET 0) AS s0) AS c1, ((SELECT (s1.v0 -> $2::text) FROM (SELECT x.v0 AS v0, (CASE jsonb_typeof(x.v0) WHEN 'number' THEN CASE WHEN (x.v0)::text ~ '^-?[0-9]+$' AND (x.v0)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v0) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT (CASE WHEN n0."id" IS NULL OR e2."id" IS NULL OR n1."id" IS NULL OR v4.path IS NULL THEN (NULL::jsonb) ELSE jsonb_build_object('~cypher'::text, 'path'::text, '~nodes'::text, (jsonb_build_array((n0."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n0."id", '~labels'::text, n0."labels")), (n1."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n1."id", '~labels'::text, n1."labels"))) || (CASE WHEN v4.nodes IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, ve."id", '~labels'::text, ve."labels")) ORDER BY vu.i) FROM unnest(v4.nodes) WITH ORDINALITY AS vu(id, i) JOIN "nodes" AS ve ON ve."id" = vu.id), '[]'::jsonb) END)), '~relationships'::text, (jsonb_build_array((e2."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, e2."id", '~type'::text, e2."type", '~start'::text, e2."start_id", '~end'::text, e2."end_id"))) || (CASE WHEN v4.path IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, ve."id", '~type'::text, ve."type", '~start'::text, ve."start_id", '~end'::text, ve."end_id")) ORDER BY vu.i) FROM unnest(v4.path) WITH ORDINALITY AS vu(id, i) JOIN "edges" AS ve ON ve."id" = vu.id), '[]'::jsonb) END))) END) AS v0 OFFSET 0) AS x OFFSET 0) AS s1))::text AS c2 FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 CROSS JOIN "edges" AS e2 CROSS JOIN "nodes" AS n3 CROSS JOIN (WITH RECURSIVE v4p(s, t, d, path, nodes) AS (SELECT n5."id", n5."id", 0, COALESCE((SELECT array_agg(ve."id") FROM "edges" AS ve WHERE FALSE), '{}'), COALESCE((SELECT array_agg(ve."id") FROM "nodes" AS ve WHERE FALSE), '{}') FROM "nodes" AS n5 UNION ALL SELECT v4p.s, e6."end_id", v4p.d + 1, (v4p.path || e6."id"), (v4p.nodes || e6."end_id") FROM v4p JOIN "edges" AS e6 ON e6."start_id" = v4p.t WHERE v4p.d < $3 AND NOT (e6."id" = ANY(v4p.path))) SELECT s, t, path, nodes FROM v4p WHERE d >= 1) AS v4 WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND v4.s = n1."id" AND v4.t = n3."id" AND NOT (e2."id" = ANY(v4.path)) LIMIT $4
-- values: "~relationships", "~nodes", depth(2), limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: OPTIONAL MATCH (x:Missing) RETURN x 1`] = `
"OPTIONAL MATCH (x:Missing) RETURN x
-- step 1
SELECT n0."id" AS c0_id, (n0."labels")::text AS c0_labels, (n0."properties")::text AS c0_props FROM (SELECT 1 AS one) AS one1 LEFT JOIN "nodes" AS n0 ON (n0."labels" @> jsonb_build_array($1::text)) LIMIT $2
-- values: "Missing", limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: RETURN 1 AS i, 1.5 AS f, 'x' AS s, [1, null] AS l, {k: true} AS m, $p AS p 1`] = `
"RETURN 1 AS i, 1.5 AS f, 'x' AS s, [1, null] AS l, {k: true} AS m, $p AS p
-- step 1
SELECT ($1::bigint) AS c0, ($2::double precision) AS c1, ($3::text) AS c2, (($4::jsonb))::text AS c3, (($5::jsonb))::text AS c4, (($6::jsonb))::text AS c5 LIMIT $7
-- values: "1", 1.5, "x", [1,null], {"k":true}, $p, limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max 1`] = `
"UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max
-- step 1
SELECT ((n2."properties" -> $1::text))::text AS c0, (u1.value)::text AS c1 FROM LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof(($2::jsonb)) = 'array' THEN ($2::jsonb) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT ($2::jsonb), 1 WHERE jsonb_typeof(($2::jsonb)) NOT IN ('array', 'null')) AS u0 CROSS JOIN LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof(u0.value) = 'array' THEN u0.value END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT u0.value, 1 WHERE jsonb_typeof(u0.value) NOT IN ('array', 'null')) AS u1 CROSS JOIN "nodes" AS n2 WHERE (n2."labels" @> jsonb_build_array($3::text)) ORDER BY u0.ord, u1.ord, n2."id" LIMIT $4
-- values: "k", $lists, "N", limit($max)"
`;

exports[`postgres > read: UNWIND $xs AS x WITH x ORDER BY x DESC LIMIT 3 RETURN x 1`] = `
"UNWIND $xs AS x WITH x ORDER BY x DESC LIMIT 3 RETURN x
-- step 1
SELECT (w0.c0)::text AS c0 FROM (SELECT s.*, row_number() OVER () AS o FROM (SELECT u0.value AS c0 FROM LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof(($1::jsonb)) = 'array' THEN ($1::jsonb) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT ($1::jsonb), 1 WHERE jsonb_typeof(($1::jsonb)) NOT IN ('array', 'null')) AS u0 ORDER BY (CASE (CASE jsonb_typeof(u0.value) WHEN 'number' THEN CASE WHEN (u0.value)::text ~ '^-?[0-9]+$' AND (u0.value)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((u0.value) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) DESC, (CASE WHEN (CASE jsonb_typeof(u0.value) WHEN 'number' THEN CASE WHEN (u0.value)::text ~ '^-?[0-9]+$' AND (u0.value)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((u0.value) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof(u0.value) = 'number' THEN u0.value END)::numeric END) DESC, (CASE WHEN (CASE jsonb_typeof(u0.value) WHEN 'number' THEN CASE WHEN (u0.value)::text ~ '^-?[0-9]+$' AND (u0.value)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((u0.value) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN ((u0.value #>> '{}') COLLATE "C") END) DESC, (CASE WHEN (CASE jsonb_typeof(u0.value) WHEN 'number' THEN CASE WHEN (u0.value)::text ~ '^-?[0-9]+$' AND (u0.value)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((u0.value) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN (CASE WHEN jsonb_typeof(u0.value) = 'boolean' THEN u0.value END)::boolean END) DESC, (CASE WHEN (CASE jsonb_typeof(u0.value) WHEN 'number' THEN CASE WHEN (u0.value)::text ~ '^-?[0-9]+$' AND (u0.value)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((u0.value) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('list', 'map', 'node', 'relationship', 'path') THEN (u0.value)::text END) DESC, u0.ord LIMIT $2) AS s) AS w0 ORDER BY w0.o LIMIT $3
-- values: $xs, limit(3), limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: UNWIND [{a: {b: 1}}] AS m RETURN m.a.b 1`] = `
"UNWIND [{a: {b: 1}}] AS m RETURN m.a.b
-- step 1
SELECT (((u0.value -> $1::text) -> $2::text))::text AS c0 FROM LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof(($3::jsonb)) = 'array' THEN ($3::jsonb) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT ($3::jsonb), 1 WHERE jsonb_typeof(($3::jsonb)) NOT IN ('array', 'null')) AS u0 ORDER BY u0.ord LIMIT $4
-- values: "a", "b", [{"a":{"b":1}}], limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: UNWIND [1, 2] AS x RETURN x 1`] = `
"UNWIND [1, 2] AS x RETURN x
-- step 1
SELECT (u0.value)::text AS c0 FROM LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof(($1::jsonb)) = 'array' THEN ($1::jsonb) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT ($1::jsonb), 1 WHERE jsonb_typeof(($1::jsonb)) NOT IN ('array', 'null')) AS u0 ORDER BY u0.ord LIMIT $2
-- values: [1,2], limit(maxRowsPerStep + 1)"
`;

