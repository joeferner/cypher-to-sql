-- values: "v", $rows, $rows, $rows, $rows, limit(maxRowsPerStep + 1)
-- step 2 (for each source row)
INSERT INTO "nodes" ("labels", "properties") VALUES (($1::jsonb), ($2::jsonb)) RETURNING "id" AS id
-- values: ["N"], {v: row.r0}"
`;

