`;

exports[`sqlite > read: MATCH (a:A {k: 1})-[r:T {w: $w}]->(b) RETURN a, r, b 1`] = `
"MATCH (a:A {k: 1})-[r:T {w: $w}]->(b) RETURN a, r, b
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props, e2."id" AS c1_id, e2."type" AS c1_type, e2."start_id" AS c1_start, e2."end_id" AS c1_end, e2."properties" AS c1_props, n1."id" AS c2_id, n1."labels" AS c2_labels, n1."properties" AS c2_props FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 CROSS JOIN "edges" AS e2 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') = ?) ELSE 0 END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) AND e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND e2."type" = ? AND (SELECT (CASE WHEN s1.t0 IS NULL OR s1.t0 = 'null' OR s1.t1 IS NULL OR s1.t1 = 'null' THEN NULL WHEN s1.t0 IN ('integer', 'float') AND s1.t1 IN ('integer', 'float') THEN ((e2."properties" -> ('$."' || ? || '"')) ->> '$') = (? ->> '$') WHEN s1.t0 <> s1.t1 THEN 0 WHEN s1.t0 = 'string' THEN (((e2."properties" -> ('$."' || ? || '"')) ->> '$') = (? ->> '$')) WHEN s1.t0 = 'boolean' THEN (((e2."properties" -> ('$."' || ? || '"')) ->> '$') = (? ->> '$')) ELSE (WITH RECURSIVE w(a, at, b, bt) AS (SELECT CASE WHEN json_type((e2."properties" -> ('$."' || ? || '"'))) IN ('array', 'object') THEN (e2."properties" -> ('$."' || ? || '"')) ELSE (e2."properties" -> ('$."' || ? || '"')) ->> '$' END, json_type((e2."properties" -> ('$."' || ? || '"'))), CASE WHEN json_type(?) IN ('array', 'object') THEN ? ELSE ? ->> '$' END, json_type(?) UNION ALL SELECT x.value, x.type, y.value, y.type FROM w, json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.a END) AS x JOIN json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.b END) AS y ON x.key = y.key) SELECT CASE WHEN SUM(r = 0) > 0 THEN 0 WHEN SUM(r IS NULL) > 0 THEN NULL ELSE 1 END FROM (SELECT CASE WHEN COALESCE(at, 'null') = 'null' OR COALESCE(bt, 'null') = 'null' THEN NULL WHEN CASE at WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE at END <> CASE bt WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE bt END THEN 0 WHEN at = 'array' THEN json_array_length(a) = json_array_length(b) WHEN at = 'object' THEN (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(a) ORDER BY key)) IS (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(b) ORDER BY key)) WHEN at IN ('true', 'false') THEN at = bt ELSE a = b END AS r FROM w)) END) FROM (SELECT (CASE json_type((e2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(?) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s1) LIMIT ?
-- values: "A", "1", "k", "1", "k", "T", "w", $w, "w", $w, "w", $w, "w", "w", "w", "w", $w, $w, $w, $w, "w", $w, limit(maxRowsPerStep + 1)"
`;

