exports[`postgres > read: MATCH (n) WHERE toLower(n.name) STARTS WITH 'a' RETURN size(labels(n)), coalesce(n.x, 0), range(1, $n) 1`] = `
"MATCH (n) WHERE toLower(n.name) STARTS WITH 'a' RETURN size(labels(n)), coalesce(n.x, 0), range(1, $n)
-- step 1
SELECT (SELECT jsonb_array_length(CASE WHEN jsonb_typeof(s2.v0) = 'array' THEN s2.v0 END) FROM (SELECT x.v0 AS v0, (CASE jsonb_typeof(x.v0) WHEN 'number' THEN CASE WHEN (x.v0)::text ~ '^-?[0-9]+$' AND (x.v0)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v0) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT n0."labels" AS v0 OFFSET 0) AS x OFFSET 0) AS s2) AS c0, ((SELECT COALESCE(CASE WHEN s3.t0 <> 'null' THEN (n0."properties" -> $1::text) END, CASE WHEN s3.t1 <> 'null' THEN to_jsonb(($2::bigint)) END) FROM (SELECT (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE jsonb_typeof(to_jsonb(($2::bigint))) WHEN 'number' THEN CASE WHEN (to_jsonb(($2::bigint)))::text ~ '^-?[0-9]+$' AND (to_jsonb(($2::bigint)))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((to_jsonb(($2::bigint))) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t1 OFFSET 0) AS s3))::text AS c1, ((SELECT (CASE WHEN s4.t1 IN ('integer') THEN (SELECT COALESCE(jsonb_agg(g.v ORDER BY g.i), '[]'::jsonb) FROM generate_series((($3::bigint))::bigint, ((CASE WHEN jsonb_typeof(($4::jsonb)) = 'number' THEN ($4::jsonb) END)::bigint)::bigint, (1)::bigint) WITH ORDINALITY AS g(v, i)) END) FROM (SELECT (CASE jsonb_typeof(($4::jsonb)) WHEN 'number' THEN CASE WHEN (($4::jsonb))::text ~ '^-?[0-9]+$' AND (($4::jsonb))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((($4::jsonb)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t1 OFFSET 0) AS s4))::text AS c2 FROM "nodes" AS n0 WHERE (SELECT starts_with(s1.v0, ($5::text)) FROM (SELECT x.v0 AS v0 FROM (SELECT (SELECT (CASE WHEN s0.t0 IN ('string') THEN lower(((n0."properties" -> $6::text) #>> '{}')) END) FROM (SELECT (CASE jsonb_typeof((n0."properties" -> $6::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $6::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $6::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $6::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 OFFSET 0) AS s0) AS v0 OFFSET 0) AS x OFFSET 0) AS s1) LIMIT $7
-- values: "x", "0", "1", $n, "a", "name", limit(maxRowsPerStep + 1)"
