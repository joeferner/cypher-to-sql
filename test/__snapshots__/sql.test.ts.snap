exports[`postgres > read: MATCH (a), (b) WHERE a.k < b.k MATCH p = allShortestPaths((a)-[*..4]-(b)) RETURN length(p) 1`] = `
"MATCH (a), (b) WHERE a.k < b.k MATCH p = allShortestPaths((a)-[*..4]-(b)) RETURN length(p)
-- step 1 (node pairs of shortest path search 1)
SELECT DISTINCT n0."id" AS s, n1."id" AS t FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE WHERE (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR s0.t1 IS NULL OR s0.t1 = 'null' THEN NULL WHEN s0.t0 IN ('integer', 'float') AND s0.t1 IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof((n0."properties" -> $1::text)) = 'number' THEN (n0."properties" -> $1::text) END)::numeric < (CASE WHEN jsonb_typeof((n1."properties" -> $2::text)) = 'number' THEN (n1."properties" -> $2::text) END)::numeric WHEN s0.t0 <> s0.t1 THEN CAST(NULL AS boolean) WHEN s0.t0 IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN ((((n0."properties" -> $1::text) -> $3::text) #>> '{}') COLLATE "C" < (((n1."properties" -> $2::text) -> $4::text) #>> '{}') COLLATE "C") WHEN s0.t0 = 'string' THEN (((n0."properties" -> $1::text) #>> '{}') COLLATE "C" < ((n1."properties" -> $2::text) #>> '{}') COLLATE "C") WHEN s0.t0 = 'boolean' THEN ((CASE WHEN jsonb_typeof((n0."properties" -> $1::text)) = 'boolean' THEN (n0."properties" -> $1::text) END)::boolean < (CASE WHEN jsonb_typeof((n1."properties" -> $2::text)) = 'boolean' THEN (n1."properties" -> $2::text) END)::boolean) ELSE (CASE WHEN s0.t0 = 'list' THEN (CASE COALESCE((SELECT CASE WHEN q.eq IS NULL OR q.cmp IS NULL THEN 2 WHEN q.cmp THEN 1 ELSE 0 END FROM (SELECT la1.ord AS k, (SELECT (CASE WHEN s2.t0 IS NULL OR s2.t0 = 'null' OR s2.t1 IS NULL OR s2.t1 = 'null' THEN NULL WHEN s2.t0 IN ('integer', 'float') AND s2.t1 IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof(s2.v0) = 'number' THEN s2.v0 END)::numeric = (CASE WHEN jsonb_typeof(s2.v1) = 'number' THEN s2.v1 END)::numeric WHEN s2.t0 <> s2.t1 THEN FALSE WHEN s2.t0 IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN (((s2.v0 -> $5::text) #>> '{}') = ((s2.v1 -> $6::text) #>> '{}')) WHEN s2.t0 = 'string' THEN ((s2.v0 #>> '{}') = (s2.v1 #>> '{}')) WHEN s2.t0 = 'boolean' THEN ((CASE WHEN jsonb_typeof(s2.v0) = 'boolean' THEN s2.v0 END)::boolean = (CASE WHEN jsonb_typeof(s2.v1) = 'boolean' THEN s2.v1 END)::boolean) ELSE (WITH RECURSIVE w(a, b) AS (SELECT (s2.v0)::jsonb, (s2.v1)::jsonb UNION ALL SELECT c.a, c.b FROM w, LATERAL (SELECT x.value AS a, y.value AS b FROM jsonb_array_elements(CASE WHEN jsonb_typeof(w.a) = 'array' AND jsonb_typeof(w.b) = 'array' THEN w.a END) WITH ORDINALITY AS x(value, i) JOIN jsonb_array_elements(CASE WHEN jsonb_typeof(w.a) = 'array' AND jsonb_typeof(w.b) = 'array' THEN w.b END) WITH ORDINALITY AS y(value, i) ON x.i = y.i UNION ALL SELECT x.value, y.value FROM jsonb_each(CASE WHEN jsonb_typeof(w.a) = 'object' AND jsonb_typeof(w.b) = 'object' THEN w.a END) AS x JOIN jsonb_each(CASE WHEN jsonb_typeof(w.a) = 'object' AND jsonb_typeof(w.b) = 'object' THEN w.b END) AS y ON x.key = y.key) AS c) SELECT CASE WHEN bool_or(r = FALSE) THEN FALSE WHEN bool_or(r IS NULL) THEN NULL ELSE TRUE END FROM (SELECT CASE WHEN COALESCE(jsonb_typeof(a), 'null') = 'null' OR COALESCE(jsonb_typeof(b), 'null') = 'null' THEN NULL WHEN jsonb_typeof(a) <> jsonb_typeof(b) THEN FALSE WHEN jsonb_typeof(a) = 'array' THEN jsonb_array_length(a) = jsonb_array_length(b) WHEN jsonb_typeof(a) = 'object' THEN ARRAY(SELECT jsonb_object_keys(a) ORDER BY 1) = ARRAY(SELECT jsonb_object_keys(b) ORDER BY 1) ELSE a = b END AS r FROM w) AS t) END) FROM (SELECT x.v0 AS v0, (CASE jsonb_typeof(x.v0) WHEN 'number' THEN CASE WHEN (x.v0)::text ~ '^-?[0-9]+$' AND (x.v0)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v0) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0, x.v1 AS v1, (CASE jsonb_typeof(x.v1) WHEN 'number' THEN CASE WHEN (x.v1)::text ~ '^-?[0-9]+$' AND (x.v1)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v1) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT la1.value AS v0, lb1.value AS v1 OFFSET 0) AS x OFFSET 0) AS s2) AS eq, (SELECT (CASE WHEN s3.t0 IS NULL OR s3.t0 = 'null' OR s3.t1 IS NULL OR s3.t1 = 'null' THEN NULL WHEN s3.t0 IN ('integer', 'float') AND s3.t1 IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof(s3.v0) = 'number' THEN s3.v0 END)::numeric < (CASE WHEN jsonb_typeof(s3.v1) = 'number' THEN s3.v1 END)::numeric WHEN s3.t0 <> s3.t1 THEN CAST(NULL AS boolean) WHEN s3.t0 IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN (((s3.v0 -> $7::text) #>> '{}') COLLATE "C" < ((s3.v1 -> $8::text) #>> '{}') COLLATE "C") WHEN s3.t0 = 'string' THEN ((s3.v0 #>> '{}') COLLATE "C" < (s3.v1 #>> '{}') COLLATE "C") WHEN s3.t0 = 'boolean' THEN ((CASE WHEN jsonb_typeof(s3.v0) = 'boolean' THEN s3.v0 END)::boolean < (CASE WHEN jsonb_typeof(s3.v1) = 'boolean' THEN s3.v1 END)::boolean) ELSE (CASE WHEN s3.t0 = 'list' THEN CAST(NULL AS boolean) END) END) FROM (SELECT x.v0 AS v0, (CASE jsonb_typeof(x.v0) WHEN 'number' THEN CASE WHEN (x.v0)::text ~ '^-?[0-9]+$' AND (x.v0)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v0) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0, x.v1 AS v1, (CASE jsonb_typeof(x.v1) WHEN 'number' THEN CASE WHEN (x.v1)::text ~ '^-?[0-9]+$' AND (x.v1)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v1) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT la1.value AS v0, lb1.value AS v1 OFFSET 0) AS x OFFSET 0) AS s3) AS cmp FROM LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof((n0."properties" -> $1::text)) = 'array' THEN (n0."properties" -> $1::text) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT (n0."properties" -> $1::text), 1 WHERE jsonb_typeof((n0."properties" -> $1::text)) NOT IN ('array', 'null')) AS la1 CROSS JOIN LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof((n1."properties" -> $2::text)) = 'array' THEN (n1."properties" -> $2::text) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT (n1."properties" -> $2::text), 1 WHERE jsonb_typeof((n1."properties" -> $2::text)) NOT IN ('array', 'null')) AS lb1 WHERE la1.ord = lb1.ord OFFSET 0) AS q WHERE NOT COALESCE(q.eq, FALSE) ORDER BY q.k LIMIT 1), CASE WHEN jsonb_array_length(CASE WHEN jsonb_typeof((n0."properties" -> $1::text)) = 'array' THEN (n0."properties" -> $1::text) END) < jsonb_array_length(CASE WHEN jsonb_typeof((n1."properties" -> $2::text)) = 'array' THEN (n1."properties" -> $2::text) END) THEN 1 ELSE 0 END) WHEN 1 THEN TRUE WHEN 0 THEN FALSE END) END) END) FROM (SELECT (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE jsonb_typeof((n1."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n1."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n1."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n1."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t1 OFFSET 0) AS s0) LIMIT $9
-- values: "k", "k", "~k", "~k", "~k", "~k", "~k", "~k", limit(maxRowsPerStep + 1)
-- search 1: breadth-first, one step per depth (all shortest paths per pair, depth 1..depth(4))
SELECT f, r, t FROM (SELECT e2."start_id" AS f, e2."id" AS r, e2."end_id" AS t FROM "edges" AS e2 WHERE e2."start_id" = ANY(ARRAY(SELECT (jsonb_populate_record(NULL::"nodes", jsonb_build_object('id', x.value)))."id" FROM jsonb_array_elements(($1::jsonb)) AS x)) UNION ALL SELECT e2."end_id" AS f, e2."id" AS r, e2."start_id" AS t FROM "edges" AS e2 WHERE e2."end_id" = ANY(ARRAY(SELECT (jsonb_populate_record(NULL::"nodes", jsonb_build_object('id', x.value)))."id" FROM jsonb_array_elements(($1::jsonb)) AS x))) AS x ORDER BY r, f LIMIT $2
-- values: frontier, limit(maxRowsPerStep + 1)
-- step 2
SELECT (SELECT jsonb_array_length(CASE WHEN jsonb_typeof((s4.v0 -> $1::text)) = 'array' THEN (s4.v0 -> $1::text) END) FROM (SELECT x.v0 AS v0, (CASE jsonb_typeof(x.v0) WHEN 'number' THEN CASE WHEN (x.v0)::text ~ '^-?[0-9]+$' AND (x.v0)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v0) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT (CASE WHEN n0."id" IS NULL OR v3.path IS NULL THEN (NULL::jsonb) ELSE jsonb_build_object('~cypher'::text, 'path'::text, '~nodes'::text, (jsonb_build_array((n0."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n0."id", '~labels'::text, n0."labels"))) || (CASE WHEN v3.nodes IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, ve."id", '~labels'::text, ve."labels")) ORDER BY vu.i) FROM unnest(v3.nodes) WITH ORDINALITY AS vu(id, i) JOIN "nodes" AS ve ON ve."id" = vu.id), '[]'::jsonb) END)), '~relationships'::text, (CASE WHEN v3.path IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, ve."id", '~type'::text, ve."type", '~start'::text, ve."start_id", '~end'::text, ve."end_id")) ORDER BY vu.i) FROM unnest(v3.path) WITH ORDINALITY AS vu(id, i) JOIN "edges" AS ve ON ve."id" = vu.id), '[]'::jsonb) END)) END) AS v0 OFFSET 0) AS x OFFSET 0) AS s4) AS c0 FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE JOIN (SELECT (jsonb_populate_record(NULL::"nodes", jsonb_build_object('id', j.value -> 's')))."id" AS s, (jsonb_populate_record(NULL::"nodes", jsonb_build_object('id', j.value -> 't')))."id" AS t, ARRAY(SELECT (jsonb_populate_record(NULL::"edges", jsonb_build_object('id', x.value)))."id" FROM jsonb_array_elements(j.value -> 'r') WITH ORDINALITY AS x(value, i) ORDER BY x.i) AS path, ARRAY(SELECT (jsonb_populate_record(NULL::"nodes", jsonb_build_object('id', x.value)))."id" FROM jsonb_array_elements(j.value -> 'n') WITH ORDINALITY AS x(value, i) ORDER BY x.i) AS nodes FROM jsonb_array_elements(($2::jsonb)) AS j) AS v3 ON TRUE WHERE (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR s0.t1 IS NULL OR s0.t1 = 'null' THEN NULL WHEN s0.t0 IN ('integer', 'float') AND s0.t1 IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof((n0."properties" -> $3::text)) = 'number' THEN (n0."properties" -> $3::text) END)::numeric < (CASE WHEN jsonb_typeof((n1."properties" -> $4::text)) = 'number' THEN (n1."properties" -> $4::text) END)::numeric WHEN s0.t0 <> s0.t1 THEN CAST(NULL AS boolean) WHEN s0.t0 IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN ((((n0."properties" -> $3::text) -> $5::text) #>> '{}') COLLATE "C" < (((n1."properties" -> $4::text) -> $6::text) #>> '{}') COLLATE "C") WHEN s0.t0 = 'string' THEN (((n0."properties" -> $3::text) #>> '{}') COLLATE "C" < ((n1."properties" -> $4::text) #>> '{}') COLLATE "C") WHEN s0.t0 = 'boolean' THEN ((CASE WHEN jsonb_typeof((n0."properties" -> $3::text)) = 'boolean' THEN (n0."properties" -> $3::text) END)::boolean < (CASE WHEN jsonb_typeof((n1."properties" -> $4::text)) = 'boolean' THEN (n1."properties" -> $4::text) END)::boolean) ELSE (CASE WHEN s0.t0 = 'list' THEN (CASE COALESCE((SELECT CASE WHEN q.eq IS NULL OR q.cmp IS NULL THEN 2 WHEN q.cmp THEN 1 ELSE 0 END FROM (SELECT la1.ord AS k, (SELECT (CASE WHEN s2.t0 IS NULL OR s2.t0 = 'null' OR s2.t1 IS NULL OR s2.t1 = 'null' THEN NULL WHEN s2.t0 IN ('integer', 'float') AND s2.t1 IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof(s2.v0) = 'number' THEN s2.v0 END)::numeric = (CASE WHEN jsonb_typeof(s2.v1) = 'number' THEN s2.v1 END)::numeric WHEN s2.t0 <> s2.t1 THEN FALSE WHEN s2.t0 IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN (((s2.v0 -> $7::text) #>> '{}') = ((s2.v1 -> $8::text) #>> '{}')) WHEN s2.t0 = 'string' THEN ((s2.v0 #>> '{}') = (s2.v1 #>> '{}')) WHEN s2.t0 = 'boolean' THEN ((CASE WHEN jsonb_typeof(s2.v0) = 'boolean' THEN s2.v0 END)::boolean = (CASE WHEN jsonb_typeof(s2.v1) = 'boolean' THEN s2.v1 END)::boolean) ELSE (WITH RECURSIVE w(a, b) AS (SELECT (s2.v0)::jsonb, (s2.v1)::jsonb UNION ALL SELECT c.a, c.b FROM w, LATERAL (SELECT x.value AS a, y.value AS b FROM jsonb_array_elements(CASE WHEN jsonb_typeof(w.a) = 'array' AND jsonb_typeof(w.b) = 'array' THEN w.a END) WITH ORDINALITY AS x(value, i) JOIN jsonb_array_elements(CASE WHEN jsonb_typeof(w.a) = 'array' AND jsonb_typeof(w.b) = 'array' THEN w.b END) WITH ORDINALITY AS y(value, i) ON x.i = y.i UNION ALL SELECT x.value, y.value FROM jsonb_each(CASE WHEN jsonb_typeof(w.a) = 'object' AND jsonb_typeof(w.b) = 'object' THEN w.a END) AS x JOIN jsonb_each(CASE WHEN jsonb_typeof(w.a) = 'object' AND jsonb_typeof(w.b) = 'object' THEN w.b END) AS y ON x.key = y.key) AS c) SELECT CASE WHEN bool_or(r = FALSE) THEN FALSE WHEN bool_or(r IS NULL) THEN NULL ELSE TRUE END FROM (SELECT CASE WHEN COALESCE(jsonb_typeof(a), 'null') = 'null' OR COALESCE(jsonb_typeof(b), 'null') = 'null' THEN NULL WHEN jsonb_typeof(a) <> jsonb_typeof(b) THEN FALSE WHEN jsonb_typeof(a) = 'array' THEN jsonb_array_length(a) = jsonb_array_length(b) WHEN jsonb_typeof(a) = 'object' THEN ARRAY(SELECT jsonb_object_keys(a) ORDER BY 1) = ARRAY(SELECT jsonb_object_keys(b) ORDER BY 1) ELSE a = b END AS r FROM w) AS t) END) FROM (SELECT x.v0 AS v0, (CASE jsonb_typeof(x.v0) WHEN 'number' THEN CASE WHEN (x.v0)::text ~ '^-?[0-9]+$' AND (x.v0)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v0) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0, x.v1 AS v1, (CASE jsonb_typeof(x.v1) WHEN 'number' THEN CASE WHEN (x.v1)::text ~ '^-?[0-9]+$' AND (x.v1)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v1) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT la1.value AS v0, lb1.value AS v1 OFFSET 0) AS x OFFSET 0) AS s2) AS eq, (SELECT (CASE WHEN s3.t0 IS NULL OR s3.t0 = 'null' OR s3.t1 IS NULL OR s3.t1 = 'null' THEN NULL WHEN s3.t0 IN ('integer', 'float') AND s3.t1 IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof(s3.v0) = 'number' THEN s3.v0 END)::numeric < (CASE WHEN jsonb_typeof(s3.v1) = 'number' THEN s3.v1 END)::numeric WHEN s3.t0 <> s3.t1 THEN CAST(NULL AS boolean) WHEN s3.t0 IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN (((s3.v0 -> $9::text) #>> '{}') COLLATE "C" < ((s3.v1 -> $10::text) #>> '{}') COLLATE "C") WHEN s3.t0 = 'string' THEN ((s3.v0 #>> '{}') COLLATE "C" < (s3.v1 #>> '{}') COLLATE "C") WHEN s3.t0 = 'boolean' THEN ((CASE WHEN jsonb_typeof(s3.v0) = 'boolean' THEN s3.v0 END)::boolean < (CASE WHEN jsonb_typeof(s3.v1) = 'boolean' THEN s3.v1 END)::boolean) ELSE (CASE WHEN s3.t0 = 'list' THEN CAST(NULL AS boolean) END) END) FROM (SELECT x.v0 AS v0, (CASE jsonb_typeof(x.v0) WHEN 'number' THEN CASE WHEN (x.v0)::text ~ '^-?[0-9]+$' AND (x.v0)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v0) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0, x.v1 AS v1, (CASE jsonb_typeof(x.v1) WHEN 'number' THEN CASE WHEN (x.v1)::text ~ '^-?[0-9]+$' AND (x.v1)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v1) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT la1.value AS v0, lb1.value AS v1 OFFSET 0) AS x OFFSET 0) AS s3) AS cmp FROM LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof((n0."properties" -> $3::text)) = 'array' THEN (n0."properties" -> $3::text) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT (n0."properties" -> $3::text), 1 WHERE jsonb_typeof((n0."properties" -> $3::text)) NOT IN ('array', 'null')) AS la1 CROSS JOIN LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof((n1."properties" -> $4::text)) = 'array' THEN (n1."properties" -> $4::text) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT (n1."properties" -> $4::text), 1 WHERE jsonb_typeof((n1."properties" -> $4::text)) NOT IN ('array', 'null')) AS lb1 WHERE la1.ord = lb1.ord OFFSET 0) AS q WHERE NOT COALESCE(q.eq, FALSE) ORDER BY q.k LIMIT 1), CASE WHEN jsonb_array_length(CASE WHEN jsonb_typeof((n0."properties" -> $3::text)) = 'array' THEN (n0."properties" -> $3::text) END) < jsonb_array_length(CASE WHEN jsonb_typeof((n1."properties" -> $4::text)) = 'array' THEN (n1."properties" -> $4::text) END) THEN 1 ELSE 0 END) WHEN 1 THEN TRUE WHEN 0 THEN FALSE END) END) END) FROM (SELECT (CASE jsonb_typeof((n0."properties" -> $3::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $3::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $3::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $3::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE jsonb_typeof((n1."properties" -> $4::text)) WHEN 'number' THEN CASE WHEN ((n1."properties" -> $4::text))::text ~ '^-?[0-9]+$' AND ((n1."properties" -> $4::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n1."properties" -> $4::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t1 OFFSET 0) AS s0) AND v3.s = n0."id" AND v3.t = n1."id" LIMIT $11
-- values: "~relationships", shortestPaths(search 1), "k", "k", "~k", "~k", "~k", "~k", "~k", "~k", limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: MATCH (a)<-[:T|U]-(b)-[r]-(c) RETURN r.w 1`] = `
"MATCH (a)<-[:T|U]-(b)-[r]-(c) RETURN r.w
-- step 1
SELECT ((e4."properties" -> $1::text))::text AS c0 FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE JOIN "edges" AS e2 ON TRUE JOIN "nodes" AS n3 ON TRUE JOIN "edges" AS e4 ON TRUE WHERE e2."start_id" = n1."id" AND e2."end_id" = n0."id" AND e2."type" IN ($2, $3) AND ((e4."start_id" = n1."id" AND e4."end_id" = n3."id") OR (e4."start_id" = n3."id" AND e4."end_id" = n1."id")) AND e2."id" <> e4."id" LIMIT $4
-- values: "w", "T", "U", limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: MATCH (a)-[*]-(b), (b)<-[*0..2]-(c) RETURN count(*) 1`] = `
"MATCH (a)-[*]-(b), (b)<-[*0..2]-(c) RETURN count(*)
-- step 1
SELECT g.x0 AS c0 FROM (SELECT COUNT(*) AS x0 FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE JOIN (WITH RECURSIVE v2p(s, t, d, path) AS (SELECT n3."id", n3."id", 0, COALESCE((SELECT array_agg(ve."id") FROM "edges" AS ve WHERE FALSE), '{}') FROM "nodes" AS n3 UNION ALL SELECT v2p.s, CASE WHEN e4."start_id" = v2p.t THEN e4."end_id" ELSE e4."start_id" END, v2p.d + 1, (v2p.path || e4."id") FROM v2p JOIN "edges" AS e4 ON (e4."start_id" = v2p.t OR e4."end_id" = v2p.t) WHERE v2p.d < $1 AND NOT (e4."id" = ANY(v2p.path))) SELECT (CASE WHEN row_number() OVER () > ($2::bigint) THEN ((('!cypher:0' || CASE WHEN random() >= 0 THEN '' END)::int))::bigint ELSE v2l.s END) AS s, v2l.t AS t, v2l.path AS path FROM (SELECT s, t, path FROM v2p WHERE d >= 1 LIMIT $3) AS v2l) AS v2 ON TRUE JOIN "nodes" AS n5 ON TRUE JOIN (WITH RECURSIVE v6p(s, t, d, path) AS (SELECT n7."id", n7."id", 0, COALESCE((SELECT array_agg(ve."id") FROM "edges" AS ve WHERE FALSE), '{}') FROM "nodes" AS n7 UNION ALL SELECT v6p.s, e8."start_id", v6p.d + 1, (v6p.path || e8."id") FROM v6p JOIN "edges" AS e8 ON e8."end_id" = v6p.t WHERE v6p.d < $4 AND NOT (e8."id" = ANY(v6p.path))) SELECT (CASE WHEN row_number() OVER () > ($5::bigint) THEN ((('!cypher:1' || CASE WHEN random() >= 0 THEN '' END)::int))::bigint ELSE v6l.s END) AS s, v6l.t AS t, v6l.path AS path FROM (SELECT s, t, path FROM v6p WHERE d >= 0 LIMIT $6) AS v6l) AS v6 ON TRUE WHERE v2.s = n0."id" AND v2.t = n1."id" AND v6.s = n1."id" AND v6.t = n5."id" AND NOT (v2.path && v6.path)) AS g LIMIT $7
-- values: maxPathDepth, maxRowsPerStep, limit(maxRowsPerStep + 1), depth(2), maxRowsPerStep, limit(maxRowsPerStep + 1), limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: MATCH (a)-[r]->(b) MATCH (b)-[r2]->(c), (c)-[r]->(a) RETURN r2 1`] = `
"MATCH (a)-[r]->(b) MATCH (b)-[r2]->(c), (c)-[r]->(a) RETURN r2
-- step 1
SELECT e4."id" AS c0_id, e4."type" AS c0_type, e4."start_id" AS c0_start, e4."end_id" AS c0_end, (e4."properties")::text AS c0_props FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE JOIN "edges" AS e2 ON TRUE JOIN "nodes" AS n3 ON TRUE JOIN "edges" AS e4 ON TRUE WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND e4."start_id" = n1."id" AND e4."end_id" = n3."id" AND e2."start_id" = n3."id" AND e2."end_id" = n0."id" AND e4."id" <> e2."id" LIMIT $1
-- values: limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: MATCH (a:A {k: 1}), (b:B) MATCH p = shortestPath((a)-[:T* {w: 1}]->(b)) RETURN p 1`] = `
"MATCH (a:A {k: 1}), (b:B) MATCH p = shortestPath((a)-[:T* {w: 1}]->(b)) RETURN p
-- step 1 (node pairs of shortest path search 1)
SELECT DISTINCT n0."id" AS s, n1."id" AS t FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE WHERE (n0."labels" @> jsonb_build_array($1::text)) AND (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ($2::bigint) IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN ((CASE WHEN jsonb_typeof((n0."properties" -> $3::text)) = 'number' THEN (n0."properties" -> $3::text) END)::numeric = ($2::bigint)) ELSE FALSE END) FROM (SELECT (CASE jsonb_typeof((n0."properties" -> $3::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $3::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $3::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $3::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 OFFSET 0) AS s0) AND (n1."labels" @> jsonb_build_array($4::text)) LIMIT $5
-- values: "A", "1", "k", "B", limit(maxRowsPerStep + 1)
-- search 1: breadth-first, one step per depth (one shortest path per pair, depth 1..maxPathDepth)
SELECT f, r, t FROM (SELECT e2."start_id" AS f, e2."id" AS r, e2."end_id" AS t FROM "edges" AS e2 WHERE e2."start_id" = ANY(ARRAY(SELECT (jsonb_populate_record(NULL::"nodes", jsonb_build_object('id', x.value)))."id" FROM jsonb_array_elements(($1::jsonb)) AS x)) AND e2."type" = $2 AND (SELECT (CASE WHEN s1.t0 IS NULL OR s1.t0 = 'null' OR ($3::bigint) IS NULL THEN NULL WHEN s1.t0 IN ('integer', 'float') THEN ((CASE WHEN jsonb_typeof((e2."properties" -> $4::text)) = 'number' THEN (e2."properties" -> $4::text) END)::numeric = ($3::bigint)) ELSE FALSE END) FROM (SELECT (CASE jsonb_typeof((e2."properties" -> $4::text)) WHEN 'number' THEN CASE WHEN ((e2."properties" -> $4::text))::text ~ '^-?[0-9]+$' AND ((e2."properties" -> $4::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((e2."properties" -> $4::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 OFFSET 0) AS s1)) AS x ORDER BY r, f LIMIT $5
-- values: frontier, "T", "1", "w", limit(maxRowsPerStep + 1)
-- step 2
SELECT ((CASE WHEN n0."id" IS NULL OR v3.path IS NULL THEN (NULL::jsonb) ELSE jsonb_build_object('~cypher'::text, 'path'::text, '~nodes'::text, (jsonb_build_array((n0."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n0."id", '~labels'::text, n0."labels"))) || (CASE WHEN v3.nodes IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, ve."id", '~labels'::text, ve."labels")) ORDER BY vu.i) FROM unnest(v3.nodes) WITH ORDINALITY AS vu(id, i) JOIN "nodes" AS ve ON ve."id" = vu.id), '[]'::jsonb) END)), '~relationships'::text, (CASE WHEN v3.path IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, ve."id", '~type'::text, ve."type", '~start'::text, ve."start_id", '~end'::text, ve."end_id")) ORDER BY vu.i) FROM unnest(v3.path) WITH ORDINALITY AS vu(id, i) JOIN "edges" AS ve ON ve."id" = vu.id), '[]'::jsonb) END)) END))::text AS c0 FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE JOIN (SELECT (jsonb_populate_record(NULL::"nodes", jsonb_build_object('id', j.value -> 's')))."id" AS s, (jsonb_populate_record(NULL::"nodes", jsonb_build_object('id', j.value -> 't')))."id" AS t, ARRAY(SELECT (jsonb_populate_record(NULL::"edges", jsonb_build_object('id', x.value)))."id" FROM jsonb_array_elements(j.value -> 'r') WITH ORDINALITY AS x(value, i) ORDER BY x.i) AS path, ARRAY(SELECT (jsonb_populate_record(NULL::"nodes", jsonb_build_object('id', x.value)))."id" FROM jsonb_array_elements(j.value -> 'n') WITH ORDINALITY AS x(value, i) ORDER BY x.i) AS nodes FROM jsonb_array_elements(($1::jsonb)) AS j) AS v3 ON TRUE WHERE (n0."labels" @> jsonb_build_array($2::text)) AND (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ($3::bigint) IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN ((CASE WHEN jsonb_typeof((n0."properties" -> $4::text)) = 'number' THEN (n0."properties" -> $4::text) END)::numeric = ($3::bigint)) ELSE FALSE END) FROM (SELECT (CASE jsonb_typeof((n0."properties" -> $4::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $4::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $4::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $4::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 OFFSET 0) AS s0) AND (n1."labels" @> jsonb_build_array($5::text)) AND v3.s = n0."id" AND v3.t = n1."id" LIMIT $6
-- values: shortestPaths(search 1), "A", "1", "k", "B", limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: MATCH (a:A {k: 1})-[r:T {w: $w}]->(b) RETURN a, r, b 1`] = `
"MATCH (a:A {k: 1})-[r:T {w: $w}]->(b) RETURN a, r, b
-- step 1
SELECT n0."id" AS c0_id, (n0."labels")::text AS c0_labels, (n0."properties")::text AS c0_props, e2."id" AS c1_id, e2."type" AS c1_type, e2."start_id" AS c1_start, e2."end_id" AS c1_end, (e2."properties")::text AS c1_props, n1."id" AS c2_id, (n1."labels")::text AS c2_labels, (n1."properties")::text AS c2_props FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE JOIN "edges" AS e2 ON TRUE WHERE (n0."labels" @> jsonb_build_array($1::text)) AND (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ($2::bigint) IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN ((CASE WHEN jsonb_typeof((n0."properties" -> $3::text)) = 'number' THEN (n0."properties" -> $3::text) END)::numeric = ($2::bigint)) ELSE FALSE END) FROM (SELECT (CASE jsonb_typeof((n0."properties" -> $3::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $3::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $3::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $3::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 OFFSET 0) AS s0) AND e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND e2."type" = $4 AND (SELECT (CASE WHEN s1.t0 IS NULL OR s1.t0 = 'null' OR s1.t1 IS NULL OR s1.t1 = 'null' THEN NULL WHEN s1.t0 IN ('integer', 'float') AND s1.t1 IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof((e2."properties" -> $5::text)) = 'number' THEN (e2."properties" -> $5::text) END)::numeric = (CASE WHEN jsonb_typeof(($6::jsonb)) = 'number' THEN ($6::jsonb) END)::numeric WHEN s1.t0 <> s1.t1 THEN FALSE WHEN s1.t0 IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN ((((e2."properties" -> $5::text) -> $7::text) #>> '{}') = ((($6::jsonb) -> $8::text) #>> '{}')) WHEN s1.t0 = 'string' THEN (((e2."properties" -> $5::text) #>> '{}') = (($6::jsonb) #>> '{}')) WHEN s1.t0 = 'boolean' THEN ((CASE WHEN jsonb_typeof((e2."properties" -> $5::text)) = 'boolean' THEN (e2."properties" -> $5::text) END)::boolean = (CASE WHEN jsonb_typeof(($6::jsonb)) = 'boolean' THEN ($6::jsonb) END)::boolean) ELSE (WITH RECURSIVE w(a, b) AS (SELECT ((e2."properties" -> $5::text))::jsonb, (($6::jsonb))::jsonb UNION ALL SELECT c.a, c.b FROM w, LATERAL (SELECT x.value AS a, y.value AS b FROM jsonb_array_elements(CASE WHEN jsonb_typeof(w.a) = 'array' AND jsonb_typeof(w.b) = 'array' THEN w.a END) WITH ORDINALITY AS x(value, i) JOIN jsonb_array_elements(CASE WHEN jsonb_typeof(w.a) = 'array' AND jsonb_typeof(w.b) = 'array' THEN w.b END) WITH ORDINALITY AS y(value, i) ON x.i = y.i UNION ALL SELECT x.value, y.value FROM jsonb_each(CASE WHEN jsonb_typeof(w.a) = 'object' AND jsonb_typeof(w.b) = 'object' THEN w.a END) AS x JOIN jsonb_each(CASE WHEN jsonb_typeof(w.a) = 'object' AND jsonb_typeof(w.b) = 'object' THEN w.b END) AS y ON x.key = y.key) AS c) SELECT CASE WHEN bool_or(r = FALSE) THEN FALSE WHEN bool_or(r IS NULL) THEN NULL ELSE TRUE END FROM (SELECT CASE WHEN COALESCE(jsonb_typeof(a), 'null') = 'null' OR COALESCE(jsonb_typeof(b), 'null') = 'null' THEN NULL WHEN jsonb_typeof(a) <> jsonb_typeof(b) THEN FALSE WHEN jsonb_typeof(a) = 'array' THEN jsonb_array_length(a) = jsonb_array_length(b) WHEN jsonb_typeof(a) = 'object' THEN ARRAY(SELECT jsonb_object_keys(a) ORDER BY 1) = ARRAY(SELECT jsonb_object_keys(b) ORDER BY 1) ELSE a = b END AS r FROM w) AS t) END) FROM (SELECT (CASE jsonb_typeof((e2."properties" -> $5::text)) WHEN 'number' THEN CASE WHEN ((e2."properties" -> $5::text))::text ~ '^-?[0-9]+$' AND ((e2."properties" -> $5::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((e2."properties" -> $5::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE jsonb_typeof(($6::jsonb)) WHEN 'number' THEN CASE WHEN (($6::jsonb))::text ~ '^-?[0-9]+$' AND (($6::jsonb))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((($6::jsonb)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t1 OFFSET 0) AS s1) LIMIT $9
-- values: "A", "1", "k", "T", "w", $w, "~k", "~k", limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: MATCH (a:A), (b) RETURN * 1`] = `
"MATCH (a:A), (b) RETURN *
-- step 1
SELECT n0."id" AS c0_id, (n0."labels")::text AS c0_labels, (n0."properties")::text AS c0_props, n1."id" AS c1_id, (n1."labels")::text AS c1_labels, (n1."properties")::text AS c1_props FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE WHERE (n0."labels" @> jsonb_build_array($1::text)) LIMIT $2
-- values: "A", limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: MATCH (a:A)-[r:T*1..3 {k: 1}]->(b)-[s]-(c) RETURN r, b 1`] = `
"MATCH (a:A)-[r:T*1..3 {k: 1}]->(b)-[s]-(c) RETURN r, b
-- step 1
SELECT ((CASE WHEN v2.path IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, ve."id", '~type'::text, ve."type", '~start'::text, ve."start_id", '~end'::text, ve."end_id")) ORDER BY vu.i) FROM unnest(v2.path) WITH ORDINALITY AS vu(id, i) JOIN "edges" AS ve ON ve."id" = vu.id), '[]'::jsonb) END))::text AS c0, n1."id" AS c1_id, (n1."labels")::text AS c1_labels, (n1."properties")::text AS c1_props FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE JOIN (WITH RECURSIVE v2p(s, t, d, path) AS (SELECT n3."id", n3."id", 0, COALESCE((SELECT array_agg(ve."id") FROM "edges" AS ve WHERE FALSE), '{}') FROM "nodes" AS n3 WHERE n3."id" IN (SELECT n0."id" FROM "nodes" AS n0 WHERE (n0."labels" @> jsonb_build_array($1::text))) UNION ALL SELECT v2p.s, e4."end_id", v2p.d + 1, (v2p.path || e4."id") FROM v2p JOIN "edges" AS e4 ON e4."start_id" = v2p.t WHERE v2p.d < $2 AND NOT (e4."id" = ANY(v2p.path)) AND e4."type" = $3 AND (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ($4::bigint) IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN ((CASE WHEN jsonb_typeof((e4."properties" -> $5::text)) = 'number' THEN (e4."properties" -> $5::text) END)::numeric = ($4::bigint)) ELSE FALSE END) FROM (SELECT (CASE jsonb_typeof((e4."properties" -> $5::text)) WHEN 'number' THEN CASE WHEN ((e4."properties" -> $5::text))::text ~ '^-?[0-9]+$' AND ((e4."properties" -> $5::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((e4."properties" -> $5::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 OFFSET 0) AS s0)) SELECT (CASE WHEN row_number() OVER () > ($6::bigint) THEN ((('!cypher:0' || CASE WHEN random() >= 0 THEN '' END)::int))::bigint ELSE v2l.s END) AS s, v2l.t AS t, v2l.path AS path FROM (SELECT s, t, path FROM v2p WHERE d >= 1 LIMIT $7) AS v2l) AS v2 ON TRUE JOIN "nodes" AS n5 ON TRUE JOIN "edges" AS e6 ON TRUE WHERE (n0."labels" @> jsonb_build_array($1::text)) AND v2.s = n0."id" AND v2.t = n1."id" AND ((e6."start_id" = n1."id" AND e6."end_id" = n5."id") OR (e6."start_id" = n5."id" AND e6."end_id" = n1."id")) AND NOT (e6."id" = ANY(v2.path)) LIMIT $8
-- values: "A", depth(3), "T", "1", "k", maxRowsPerStep, limit(maxRowsPerStep + 1), limit(maxRowsPerStep + 1)"
`;

