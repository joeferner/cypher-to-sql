SELECT ((n0."properties" -> $1::text))::text AS c0, n0."id" AS c1_id, (n0."labels")::text AS c1_labels, (n0."properties")::text AS c1_props FROM "nodes" AS n0 WHERE (n0."labels" @> jsonb_build_array($2::text)) AND (n0."labels" @> jsonb_build_array($3::text)) LIMIT $4
