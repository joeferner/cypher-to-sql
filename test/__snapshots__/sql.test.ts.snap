8623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT r0.value AS f))) ELSE json_quote(r0.value) END) -> ('$."' || ? || '"')) ->> '$') WHERE NOT (r0.key IS NULL AND r0.type = 'null') ORDER BY r0.key) AS s) AS w0 LEFT JOIN "nodes" AS n1 ON n1."id" = w0.c0 LEFT JOIN "edges" AS e2 ON e2."id" = w0.c1 LEFT JOIN "nodes" AS n3 ON n3."id" = w0.c2 WHERE (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((n1."properties" -> ('$."' || ? || '"')) ->> '$') > ?) ELSE NULL END) FROM (SELECT (CASE json_type((n1."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n1."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) ORDER BY w0.o LIMIT ?
