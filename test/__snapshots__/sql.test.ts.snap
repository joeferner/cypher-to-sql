exports[`postgres > read: MATCH (n) RETURN n.team AS team, count(*) AS c, max(n.age) - min(n.age) AS spread ORDER BY c DESC 1`] = `
"MATCH (n) RETURN n.team AS team, count(*) AS c, max(n.age) - min(n.age) AS spread ORDER BY c DESC
-- step 1
SELECT (g.g0)::text AS c0, g.x0 AS c1, ((SELECT (CASE WHEN s0.t0 = 'null' OR s0.t1 = 'null' THEN NULL WHEN s0.t0 = 'integer' AND s0.t1 = 'integer' THEN to_jsonb(((CASE WHEN jsonb_typeof(g.x1) = 'number' THEN g.x1 END)::bigint - (CASE WHEN jsonb_typeof(g.x2) = 'number' THEN g.x2 END)::bigint)) WHEN s0.t0 IN ('integer', 'float') AND s0.t1 IN ('integer', 'float') THEN (SELECT CASE WHEN f IN ('NaN'::float8, 'Infinity'::float8, '-Infinity'::float8) THEN NULL WHEN f::text::numeric = trunc(f::text::numeric) THEN to_jsonb(round(f::text::numeric, 1)) ELSE to_jsonb(f::text::numeric) END FROM (SELECT (((CASE WHEN jsonb_typeof(g.x1) = 'number' THEN g.x1 END)::double precision - (CASE WHEN jsonb_typeof(g.x2) = 'number' THEN g.x2 END)::double precision))::double precision AS f) AS ft) END) FROM (SELECT (CASE jsonb_typeof(g.x1) WHEN 'number' THEN CASE WHEN (g.x1)::text ~ '^-?[0-9]+$' AND (g.x1)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((g.x1) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE jsonb_typeof(g.x2) WHEN 'number' THEN CASE WHEN (g.x2)::text ~ '^-?[0-9]+$' AND (g.x2)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((g.x2) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t1 OFFSET 0) AS s0))::text AS c2 FROM (SELECT (n0."properties" -> $1::text) AS g0, COUNT(*) AS x0, (COALESCE(jsonb_agg((n0."properties" -> $2::text) ORDER BY (CASE (CASE jsonb_typeof((n0."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) DESC, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof((n0."properties" -> $2::text)) = 'number' THEN (n0."properties" -> $2::text) END)::numeric END) DESC, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN (((n0."properties" -> $2::text) #>> '{}') COLLATE "C") END) DESC, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN (CASE WHEN jsonb_typeof((n0."properties" -> $2::text)) = 'boolean' THEN (n0."properties" -> $2::text) END)::boolean END) DESC, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('list', 'map', 'node', 'relationship', 'path') THEN ((n0."properties" -> $2::text))::text END) DESC) FILTER (WHERE NOT (COALESCE(jsonb_typeof((n0."properties" -> $2::text)), 'null') = 'null')), '[]'::jsonb) -> (0)::int) AS x1, (COALESCE(jsonb_agg((n0."properties" -> $2::text) ORDER BY (CASE (CASE jsonb_typeof((n0."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) ASC, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $2::text)) ->> '~cypher', '