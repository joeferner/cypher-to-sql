SELECT ((n2."properties" -> $1::text))::text AS c0 FROM (SELECT g.g0_id AS c0, g.x0 AS c1 FROM (SELECT n0."id" AS g0_id, n0."labels" AS g0_labels, n0."properties" AS g0_properties, COUNT(*) AS x0 FROM "nodes" AS n0 GROUP BY n0."id", n0."labels", n0."properties") AS g) AS w0 LEFT JOIN "nodes" AS n1 ON n1."id" = w0.c0 JOIN "nodes" AS n2 ON TRUE JOIN "edges" AS e3 ON TRUE WHERE (w0.c1 > ($2::bigint)) AND e3."start_id" = n1."id" AND e3."end_id" = n2."id" ORDER BY (CASE (CASE jsonb_typeof((n2."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n2."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n2."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n2."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'datetime' THEN 6 WHEN 'localdatetime' THEN 7 WHEN 'date' THEN 8 WHEN 'time' THEN 9 WHEN 'localtime' THEN 10 WHEN 'duration' THEN 11 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) ASC, (CASE WHEN (CASE jsonb_typeof((n2."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n2."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n2."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n2."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN ((((n2."properties" -> $1::text) -> $3::text) #>> '{}') COLLATE "C") END) ASC, (CASE WHEN (CASE jsonb_typeof((n2."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n2."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n2."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n2."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof((n2."properties" -> $1::text)) = 'number' THEN (n2."properties" -> $1::text) END)::numeric END) ASC, (CASE WHEN (CASE jsonb_typeof((n2."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n2."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n2."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n2."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN (((n2."properties" -> $1::text) #>> '{}') COLLATE "C") END) ASC, (CASE WHEN (CASE jsonb_typeof((n2."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n2."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n2."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n2."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN (CASE WHEN jsonb_typeof((n2."properties" -> $1::text)) = 'boolean' THEN (n2."properties" -> $1::text) END)::boolean END) ASC, (CASE WHEN (CASE jsonb_typeof((n2."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n2."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n2."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n2."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) = 'list' THEN ((SELECT COALESCE(string_agg((CASE WHEN lkv.t IN ('integer', 'float') THEN 'I' || (SELECT CASE WHEN f = 'NaN'::float8 THEN 'P' WHEN f = 0 THEN 'M' WHEN f = 'Infinity'::float8 THEN 'O' WHEN f = '-Infinity'::float8 THEN 'K' WHEN f > 0 THEN 'N' || to_char(e + 400, 'FM000') || to_char(abs(f) / power(10::float8, e), 'FM0.000000000000000') ELSE 'L' || to_char(599 - e, 'FM000') || to_char(10 - abs(f) / power(10::float8, e), 'FM0.000000000000000') END FROM (SELECT f, GREATEST(CASE WHEN abs(f) / power(10::float8, e0) >= 10 THEN e0 + 1 WHEN abs(f) / power(10::float8, e0) < 1 THEN e0 - 1 ELSE e0 END, -300) AS e FROM (SELECT f, GREATEST(floor(log(CASE WHEN f = 0 OR f IN ('Infinity'::float8, '-Infinity'::float8, 'NaN'::float8) THEN 1 ELSE abs(f) END))::int, -300) AS e0 FROM (SELECT ((CASE WHEN jsonb_typeof(lkv.v) = 'number' THEN lkv.v END)::double precision)::float8 AS f) AS x) AS y) AS z) WHEN lkv.t = 'string' THEN 'G' || (replace((lkv.v #>> '{}'), chr(1), chr(1) || chr(2)) || chr(1) || chr(1)) WHEN lkv.t = 'boolean' THEN 'H' || (CASE WHEN (CASE WHEN jsonb_typeof(lkv.v) = 'boolean' THEN lkv.v END)::boolean THEN '1' ELSE '0' END) WHEN lkv.t = 'null' THEN 'J' ELSE (CASE lkv.t WHEN 'map' THEN 'B' WHEN 'node' THEN 'C' WHEN 'relationship' THEN 'D' WHEN 'list' THEN 'E' ELSE 'F' END) || (replace((lkv.v)::text, chr(1), chr(1) || chr(2)) || chr(1) || chr(1)) END), '' ORDER BY lkv.o), '') || 'A' FROM (SELECT lk0.value AS v, (CASE jsonb_typeof(lk0.value) WHEN 'number' THEN CASE WHEN (lk0.value)::text ~ '^-?[0-9]+$' AND (lk0.value)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((lk0.value) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t, lk0.ord AS o FROM LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof((n2."properties" -> $1::text)) = 'array' THEN (n2."properties" -> $1::text) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT (n2."properties" -> $1::text), 1 WHERE jsonb_typeof((n2."properties" -> $1::text)) NOT IN ('array', 'null')) AS lk0) AS lkv) COLLATE "C") WHEN (CASE jsonb_typeof((n2."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n2."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n2."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n2."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('map', 'node', 'relationship', 'path') THEN (((n2."properties" -> $1::text))::text COLLATE "C") END) ASC LIMIT $4
-- values: "name", "1", "~k", limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: MATCH (n)-->(m) RETURN n, collect(DISTINCT m.name), avg(m.age) 1`] = `
"MATCH (n)-->(m) RETURN n, collect(DISTINCT m.name), avg(m.age)
-- step 1
SELECT g.g0_id AS c0_id, (g.g0_labels)::text AS c0_labels, (g.g0_properties)::text AS c0_props, (g.x0)::text AS c1, g.x1 AS c2 FROM (SELECT n0."id" AS g0_id, n0."labels" AS g0_labels, n0."properties" AS g0_properties, COALESCE(jsonb_agg(DISTINCT (n1."properties" -> $1::text)) FILTER (WHERE NOT (COALESCE(jsonb_typeof((n1."properties" -> $1::text)), 'null') = 'null')), '[]'::jsonb) AS x0, AVG(CASE WHEN (CASE jsonb_typeof((n1."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n1."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n1."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n1."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((CASE WHEN jsonb_typeof((n1."properties" -> $2::text)) = 'number' THEN (n1."properties" -> $2::text) END)::numeric)::double precision END) AS x1 FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE JOIN "edges" AS e2 ON TRUE WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id" GROUP BY n0."id", n0."labels", n0."properties") AS g LIMIT $3
-- values: "name", "age", limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: MATCH (n:Person:Admin) RETURN n.name AS name, n 1`] = `
"MATCH (n:Person:Admin) RETURN n.name AS name, n
-- step 1
SELECT ((n0."properties" -> $1::text))::text AS c0, n0."id" AS c1_id, (n0."labels")::text AS c1_labels, (n0."properties")::text AS c1_props FROM "nodes" AS n0 WHERE (n0."labels" @> jsonb_build_array($2::text)) AND (n0."labels" @> jsonb_build_array($3::text)) LIMIT $4
-- values: "name", "Person", "Admin", limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: MATCH (p) OPTIONAL MATCH (p)-[r:R]->(q) WHERE r.w > 1 RETURN p, q 1`] = `
"MATCH (p) OPTIONAL MATCH (p)-[r:R]->(q) WHERE r.w > 1 RETURN p, q
-- step 1
SELECT n0."id" AS c0_id, (n0."labels")::text AS c0_labels, (n0."properties")::text AS c0_props, n1."id" AS c1_id, (n1."labels")::text AS c1_labels, (n1."properties")::text AS c1_props FROM "nodes" AS n0 LEFT JOIN ("nodes" AS n1 JOIN "edges" AS e2 ON TRUE) ON e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND e2."type" = $1 AND (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ($2::bigint) IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN ((CASE WHEN jsonb_typeof((e2."properties" -> $3::text)) = 'number' THEN (e2."properties" -> $3::text) END)::numeric > ($2::bigint)) ELSE CAST(NULL AS boolean) END) FROM (SELECT (CASE jsonb_typeof((e2."properties" -> $3::text)) WHEN 'number' THEN CASE WHEN ((e2."properties" -> $3::text))::text ~ '^-?[0-9]+$' AND ((e2."properties" -> $3::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((e2."properties" -> $3::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 OFFSET 0) AS s0) LIMIT $4
-- values: "R", "1", "w", limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: MATCH p = (a)-[r]->(b)-[*1..2]->(c) RETURN p, length(p), nodes(p) 1`] = `
"MATCH p = (a)-[r]->(b)-[*1..2]->(c) RETURN p, length(p), nodes(p)
-- step 1
SELECT ((CASE WHEN n0."id" IS NULL OR e2."id" IS NULL OR n1."id" IS NULL OR v4.path IS NULL THEN (NULL::jsonb) ELSE jsonb_build_object('~cypher'::text, 'path'::text, '~nodes'::text, (jsonb_build_array((n0."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n0."id", '~labels'::text, n0."labels")), (n1."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n1."id", '~labels'::text, n1."labels"))) || (CASE WHEN v4.nodes IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, ve."id", '~labels'::text, ve."labels")) ORDER BY vu.i) FROM unnest(v4.nodes) WITH ORDINALITY AS vu(id, i) JOIN "nodes" AS ve ON ve."id" = vu.id), '[]'::jsonb) END)), '~relationships'::text, (jsonb_build_array((e2."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, e2."id", '~type'::text, e2."type", '~start'::text, e2."start_id", '~end'::text, e2."end_id"))) || (CASE WHEN v4.path IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, ve."id", '~type'::text, ve."type", '~start'::text, ve."start_id", '~end'::text, ve."end_id")) ORDER BY vu.i) FROM unnest(v4.path) WITH ORDINALITY AS vu(id, i) JOIN "edges" AS ve ON ve."id" = vu.id), '[]'::jsonb) END))) END))::text AS c0, (SELECT jsonb_array_length(CASE WHEN jsonb_typeof((s0.v0 -> $1::text)) = 'array' THEN (s0.v0 -> $1::text) END) FROM (SELECT x.v0 AS v0, (CASE jsonb_typeof(x.v0) WHEN 'number' THEN CASE WHEN (x.v0)::text ~ '^-?[0-9]+$' AND (x.v0)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v0) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT (CASE WHEN n0."id" IS NULL OR e2."id" IS NULL OR n1."id" IS NULL OR v4.path IS NULL THEN (NULL::jsonb) ELSE jsonb_build_object('~cypher'::text, 'path'::text, '~nodes'::text, (jsonb_build_array((n0."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n0."id", '~labels'::text, n0."labels")), (n1."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n1."id", '~labels'::text, n1."labels"))) || (CASE WHEN v4.nodes IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, ve."id", '~labels'::text, ve."labels")) ORDER BY vu.i) FROM unnest(v4.nodes) WITH ORDINALITY AS vu(id, i) JOIN "nodes" AS ve ON ve."id" = vu.id), '[]'::jsonb) END)), '~relationships'::text, (jsonb_build_array((e2."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, e2."id", '~type'::text, e2."type", '~start'::text, e2."start_id", '~end'::text, e2."end_id"))) || (CASE WHEN v4.path IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, ve."id", '~type'::text, ve."type", '~start'::text, ve."start_id", '~end'::text, ve."end_id")) ORDER BY vu.i) FROM unnest(v4.path) WITH ORDINALITY AS vu(id, i) JOIN "edges" AS ve ON ve."id" = vu.id), '[]'::jsonb) END))) END) AS v0 OFFSET 0) AS x OFFSET 0) AS s0) AS c1, ((SELECT (s1.v0 -> $2::text) FROM (SELECT x.v0 AS v0, (CASE jsonb_typeof(x.v0) WHEN 'number' THEN CASE WHEN (x.v0)::text ~ '^-?[0-9]+$' AND (x.v0)::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((x.v0) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT (CASE WHEN n0."id" IS NULL OR e2."id" IS NULL OR n1."id" IS NULL OR v4.path IS NULL THEN (NULL::jsonb) ELSE jsonb_build_object('~cypher'::text, 'path'::text, '~nodes'::text, (jsonb_build_array((n0."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n0."id", '~labels'::text, n0."labels")), (n1."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, n1."id", '~labels'::text, n1."labels"))) || (CASE WHEN v4.nodes IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'node', '~id'::text, ve."id", '~labels'::text, ve."labels")) ORDER BY vu.i) FROM unnest(v4.nodes) WITH ORDINALITY AS vu(id, i) JOIN "nodes" AS ve ON ve."id" = vu.id), '[]'::jsonb) END)), '~relationships'::text, (jsonb_build_array((e2."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, e2."id", '~type'::text, e2."type", '~start'::text, e2."start_id", '~end'::text, e2."end_id"))) || (CASE WHEN v4.path IS NULL THEN NULL ELSE COALESCE((SELECT jsonb_agg((ve."properties" || jsonb_build_object('~cypher'::text, 'relationship', '~id'::text, ve."id", '~type'::text, ve."type", '~start'::text, ve."start_id", '~end'::text, ve."end_id")) ORDER BY vu.i) FROM unnest(v4.path) WITH ORDINALITY AS vu(id, i) JOIN "edges" AS ve ON ve."id" = vu.id), '[]'::jsonb) END))) END) AS v0 OFFSET 0) AS x OFFSET 0) AS s1))::text AS c2 FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE JOIN "edges" AS e2 ON TRUE JOIN "nodes" AS n3 ON TRUE JOIN (WITH RECURSIVE v4p(s, t, d, path, nodes) AS (SELECT n5."id", n5."id", 0, COALESCE((SELECT array_agg(ve."id") FROM "edges" AS ve WHERE FALSE), '{}'), COALESCE((SELECT array_agg(ve."id") FROM "nodes" AS ve WHERE FALSE), '{}') FROM "nodes" AS n5 WHERE n5."id" IN (SELECT n1."id" FROM "nodes" AS n0 JOIN "nodes" AS n1 ON TRUE JOIN "edges" AS e2 ON TRUE WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id") UNION ALL SELECT v4p.s, e6."end_id", v4p.d + 1, (v4p.path || e6."id"), (v4p.nodes || e6."end_id") FROM v4p JOIN "edges" AS e6 ON e6."start_id" = v4p.t WHERE v4p.d < $3 AND NOT (e6."id" = ANY(v4p.path))) SELECT (CASE WHEN row_number() OVER () > ($4::bigint) THEN ((('!cypher:0' || CASE WHEN random() >= 0 THEN '' END)::int))::bigint ELSE v4l.s END) AS s, v4l.t AS t, v4l.path AS path, v4l.nodes AS nodes FROM (SELECT s, t, path, nodes FROM v4p WHERE d >= 1 LIMIT $5) AS v4l) AS v4 ON TRUE WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND v4.s = n1."id" AND v4.t = n3."id" AND NOT (e2."id" = ANY(v4.path)) LIMIT $6
-- values: "~relationships", "~nodes", depth(2), maxRowsPerStep, limit(maxRowsPerStep + 1), limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: OPTIONAL MATCH (x:Missing) RETURN x 1`] = `
"OPTIONAL MATCH (x:Missing) RETURN x
-- step 1
SELECT n0."id" AS c0_id, (n0."labels")::text AS c0_labels, (n0."properties")::text AS c0_props FROM (SELECT 1 AS one) AS one1 LEFT JOIN "nodes" AS n0 ON (n0."labels" @> jsonb_build_array($1::text)) LIMIT $2
-- values: "Missing", limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: RETURN 1 AS i, 1.5 AS f, 'x' AS s, [1, null] AS l, {k: true} AS m, $p AS p 1`] = `
"RETURN 1 AS i, 1.5 AS f, 'x' AS s, [1, null] AS l, {k: true} AS m, $p AS p
-- step 1
SELECT ($1::bigint) AS c0, ($2::double precision) AS c1, ($3::text) AS c2, (($4::jsonb))::text AS c3, (($5::jsonb))::text AS c4, (($6::jsonb))::text AS c5 LIMIT $7
-- values: "1", 1.5, "x", [1,null], {"k":true}, $p, limit(maxRowsPerStep + 1)"
`;

exports[`postgres > read: UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max 1`] = `
"UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max
-- step 1
SELECT ((n2."properties" -> $1::text))::text AS c0, (u1.value)::text AS c1 FROM LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof(($2::jsonb)) = 'array' THEN ($2::jsonb) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT ($2::jsonb), 1 WHERE jsonb_typeof(($2::jsonb)) NOT IN ('array', 'null')) AS u0 JOIN LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof(u0.value) = 'array' THEN u0.value END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT u0.value, 1 WHERE jsonb_typeof(u0.value) NOT IN ('array', 'null')) AS u1 ON TRUE JOIN "nodes" AS n2 ON TRUE WHERE (n2."labels" @> jsonb_build_array($3::text)) ORDER BY u0.ord, u1.ord, n2."id" LIMIT $4
-- values: "k", $lists, "N", limit($max)"
`;

exports[`postgres > read: UNWIND $xs AS x WITH x ORDER BY x DESC LIMIT 3 RETURN x 1`] = `
"UNWIND $xs AS x WITH x ORDER BY x DESC LIMIT 3 RETURN x
