-- step 1
SELECT w0.c0 AS c0 FROM (SELECT s.*, row_number() OVER () AS o FROM (SELECT (CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END) AS c0 FROM json_each(?) AS u0 WHERE NOT (u0.key IS NULL AND u0.type = 'null') ORDER BY (CASE (CASE json_type((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f