exports[`postgres > read: MATCH (n) RETURN n.list[0], n.list[1..-1], n[$key], all(x IN [1, 2] WHERE x < n.max) 1`] = `
"MATCH (n) RETURN n.list[0], n.list[1..-1], n[$key], all(x IN [1, 2] WHERE x < n.max)
-- step 1
