exports[`postgres > read: MATCH (n) WITH n, count(*) AS c WHERE c > 1 MATCH (n)-->(m) RETURN m.name ORDER BY m.name 1`] = `
"MATCH (n) WITH n, count(*) AS c WHERE c > 1 MATCH (n)-->(m) RETURN m.name ORDER BY m.name
-- step 1
SELECT ((n2."properties" -> $1::text))::text AS c0 FROM (SELECT g.g0_id AS c0, g.x0 AS c1 FROM (SELECT n0."id" AS g0_id, n0."labels" AS g0_labels, n0."properties" AS g0_properties, COUNT(*) AS x0 FROM "nodes" AS n0 GROUP BY n0."id", n0."labels", n0."properties") AS g) AS w0 LEFT JOIN "nodes" AS n1 ON n1."id" = w0.c0 CROSS JOIN "nodes" AS n2 CROSS JOIN "edges" AS e3 WHERE (w0.c1 > ($2::bigint)) AND e3."start_id" = n1."id" AND e3."end_id" = n2."id" ORDER BY (CASE (CASE jsonb_typeof((n2."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n2."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n2."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n2."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) ASC, (CASE WHEN (CASE jsonb_typeof((n2."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n2."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n2."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n2."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof((n2."properties" -> $1::text)) = 'number' THEN (n2."properties" -> $1::text) END)::numeric END) ASC, (CASE WHEN (CASE jsonb_typeof((n2."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n2."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n2."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n2."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN (((n2."properties" -> $1::text) #>> '{}') COLLATE "C") END) ASC, (CASE WHEN (CASE jsonb_typeof((n2."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n2."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n2."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n2."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN (CASE WHEN jsonb_typeof((n2."properties" -> $1::text)) = 'boolean' THEN (n2."properties" -> $1::text) END)::boolean END) ASC, (CASE WHEN (CASE jsonb_typeof((n2."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n2."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n2."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n2."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('list', 'map', 'node', 'relationship', 'path') THEN ((n2."properties" -> $1::text))::text END) ASC LIMIT $3
