exports[`sqlite > read: MATCH (a), (b) WHERE a.k < b.k MATCH p = allShortestPaths((a)-[*..4]-(b)) RETURN length(p) 1`] = `
"MATCH (a), (b) WHERE a.k < b.k MATCH p = allShortestPaths((a)-[*..4]-(b)) RETURN length(p)
-- step 1 (node pairs of shortest path search 1)
SELECT DISTINCT n0."id" AS s, n1."id" AS t FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 WHERE (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR s0.t1 IS NULL OR s0.t1 = 'null' THEN NULL WHEN s0.t0 IN ('integer', 'float') AND s0.t1 IN ('integer', 'float') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') < ((n1."properties" -> ('$."' || ? || '"')) ->> '$') WHEN s0.t0 <> s0.t1 THEN NULL WHEN s0.t0 = 'string' THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') < ((n1."properties" -> ('$."' || ? || '"')) ->> '$')) WHEN s0.t0 = 'boolean' THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') < ((n1."properties" -> ('$."' || ? || '"')) ->> '$')) ELSE (CASE WHEN s0.t0 = 'list' THEN (CASE COALESCE((SELECT CASE WHEN q.eq IS NULL OR q.cmp IS NULL THEN 2 WHEN q.cmp THEN 1 ELSE 0 END FROM (SELECT la1.key AS k, (SELECT (CASE WHEN s2.t0 IS NULL OR s2.t0 = 'null' OR s2.t1 IS NULL OR s2.t1 = 'null' THEN NULL WHEN s2.t0 IN ('integer', 'float') AND s2.t1 IN ('integer', 'float') THEN (s2.v0 ->> '$') = (s2.v1 ->> '$') WHEN s2.t0 <> s2.t1 THEN 0 WHEN s2.t0 = 'string' THEN ((s2.v0 ->> '$') = (s2.v1 ->> '$')) WHEN s2.t0 = 'boolean' THEN ((s2.v0 ->> '$') = (s2.v1 ->> '$')) ELSE (WITH RECURSIVE w(a, at, b, bt) AS (SELECT CASE WHEN json_type(s2.v0) IN ('array', 'object') THEN s2.v0 ELSE s2.v0 ->> '$' END, json_type(s2.v0), CASE WHEN json_type(s2.v1) IN ('array', 'object') THEN s2.v1 ELSE s2.v1 ->> '$' END, json_type(s2.v1) UNION ALL SELECT x.value, x.type, y.value, y.type FROM w, json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.a END) AS x JOIN json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.b END) AS y ON x.key = y.key) SELECT CASE WHEN SUM(r = 0) > 0 THEN 0 WHEN SUM(r IS NULL) > 0 THEN NULL ELSE 1 END FROM (SELECT CASE WHEN COALESCE(at, 'null') = 'null' OR COALESCE(bt, 'null') = 'null' THEN NULL WHEN CASE at WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE at END <> CASE bt WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE bt END THEN 0 WHEN at = 'array' THEN json_array_length(a) = json_array_length(b) WHEN at = 'object' THEN (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(a) ORDER BY key)) IS (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(b) ORDER BY key)) WHEN at IN ('true', 'false') THEN at = bt ELSE a = b END AS r FROM w)) END) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, x.v1 AS v1, (CASE json_type(x.v1) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v1, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT (CASE la1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN la1.value WHEN 'object' THEN la1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT la1.value AS f))) ELSE json_quote(la1.value) END) AS v0, (CASE lb1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lb1.value WHEN 'object' THEN lb1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT lb1.value AS f))) ELSE json_quote(lb1.value) END) AS v1 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s2) AS eq, (SELECT (CASE WHEN s3.t0 IS NULL OR s3.t0 = 'null' OR s3.t1 IS NULL OR s3.t1 = 'null' THEN NULL WHEN s3.t0 IN ('integer', 'float') AND s3.t1 IN ('integer', 'float') THEN (s3.v0 ->> '$') < (s3.v1 ->> '$') WHEN s3.t0 <> s3.t1 THEN NULL WHEN s3.t0 = 'string' THEN ((s3.v0 ->> '$') < (s3.v1 ->> '$')) WHEN s3.t0 = 'boolean' THEN ((s3.v0 ->> '$') < (s3.v1 ->> '$')) ELSE (CASE WHEN s3.t0 = 'list' THEN NULL END) END) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, x.v1 AS v1, (CASE json_type(x.v1) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v1, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT (CASE la1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN la1.value WHEN 'object' THEN la1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT la1.value AS f))) ELSE json_quote(la1.value) END) AS v0, (CASE lb1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lb1.value WHEN 'object' THEN lb1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT lb1.value AS f))) ELSE json_quote(lb1.value) END) AS v1 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s3) AS cmp FROM json_each((n0."properties" -> ('$."' || ? || '"'))) AS la1 CROSS JOIN json_each((n1."properties" -> ('$."' || ? || '"'))) AS lb1 WHERE la1.key = lb1.key AND NOT (la1.key IS NULL AND la1.type = 'null') AND NOT (lb1.key IS NULL AND lb1.type = 'null') LIMIT -1 OFFSET 0) AS q WHERE NOT COALESCE(q.eq, 0) ORDER BY q.k LIMIT 1), CASE WHEN json_array_length((n0."properties" -> ('$."' || ? || '"'))) < json_array_length((n1."properties" -> ('$."' || ? || '"'))) THEN 1 ELSE 0 END) WHEN 1 THEN 1 WHEN 0 THEN 0 END) END) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type((n1."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n1."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s0) LIMIT ?
-- values: "k", "k", "k", "k", "k", "k", "k", "k", "k", "k", "k", "k", "k", "k", limit(maxRowsPerStep + 1)
-- search 1: breadth-first, one step per depth (all shortest paths per pair, depth 1..depth(4))
SELECT f, r, t FROM (SELECT e2."start_id" AS f, e2."id" AS r, e2."end_id" AS t FROM "edges" AS e2 WHERE e2."start_id" IN (SELECT value FROM json_each(?)) UNION ALL SELECT e2."end_id" AS f, e2."id" AS r, e2."start_id" AS t FROM "edges" AS e2 WHERE e2."end_id" IN (SELECT value FROM json_each(?))) AS x ORDER BY r, f LIMIT ?
-- values: frontier, frontier, limit(maxRowsPerStep + 1)
-- step 2
SELECT (SELECT json_array_length((s4.v0 -> ('$."' || ? || '"'))) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT (CASE WHEN n0."id" IS NULL OR v3.path IS NULL THEN NULL ELSE json_object('~cypher', 'path', '~nodes', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(n0."properties", json_object('~cypher', 'node', '~id', n0."id", '~labels', json(n0."labels")))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v3.nodes IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'node', '~id', ve."id", '~labels', json(ve."labels")))) ORDER BY vj.key) FROM json_each(v3.nodes) AS vj JOIN "nodes" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k))), '~relationships', json((CASE WHEN v3.path IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'relationship', '~id', ve."id", '~type', ve."type", '~start', ve."start_id", '~end', ve."end_id"))) ORDER BY vj.key) FROM json_each(v3.path) AS vj JOIN "edges" AS ve ON ve."id" = vj.value) END))) END) AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s4) AS c0 FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 CROSS JOIN (SELECT j.value ->> '$.s' AS s, j.value ->> '$.t' AS t, j.value -> '$.r' AS path, j.value -> '$.n' AS nodes FROM json_each(?) AS j) AS v3 WHERE (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR s0.t1 IS NULL OR s0.t1 = 'null' THEN NULL WHEN s0.t0 IN ('integer', 'float') AND s0.t1 IN ('integer', 'float') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') < ((n1."properties" -> ('$."' || ? || '"')) ->> '$') WHEN s0.t0 <> s0.t1 THEN NULL WHEN s0.t0 = 'string' THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') < ((n1."properties" -> ('$."' || ? || '"')) ->> '$')) WHEN s0.t0 = 'boolean' THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') < ((n1."properties" -> ('$."' || ? || '"')) ->> '$')) ELSE (CASE WHEN s0.t0 = 'list' THEN (CASE COALESCE((SELECT CASE WHEN q.eq IS NULL OR q.cmp IS NULL THEN 2 WHEN q.cmp THEN 1 ELSE 0 END FROM (SELECT la1.key AS k, (SELECT (CASE WHEN s2.t0 IS NULL OR s2.t0 = 'null' OR s2.t1 IS NULL OR s2.t1 = 'null' THEN NULL WHEN s2.t0 IN ('integer', 'float') AND s2.t1 IN ('integer', 'float') THEN (s2.v0 ->> '$') = (s2.v1 ->> '$') WHEN s2.t0 <> s2.t1 THEN 0 WHEN s2.t0 = 'string' THEN ((s2.v0 ->> '$') = (s2.v1 ->> '$')) WHEN s2.t0 = 'boolean' THEN ((s2.v0 ->> '$') = (s2.v1 ->> '$')) ELSE (WITH RECURSIVE w(a, at, b, bt) AS (SELECT CASE WHEN json_type(s2.v0) IN ('array', 'object') THEN s2.v0 ELSE s2.v0 ->> '$' END, json_type(s2.v0), CASE WHEN json_type(s2.v1) IN ('array', 'object') THEN s2.v1 ELSE s2.v1 ->> '$' END, json_type(s2.v1) UNION ALL SELECT x.value, x.type, y.value, y.type FROM w, json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.a END) AS x JOIN json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.b END) AS y ON x.key = y.key) SELECT CASE WHEN SUM(r = 0) > 0 THEN 0 WHEN SUM(r IS NULL) > 0 THEN NULL ELSE 1 END FROM (SELECT CASE WHEN COALESCE(at, 'null') = 'null' OR COALESCE(bt, 'null') = 'null' THEN NULL WHEN CASE at WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE at END <> CASE bt WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE bt END THEN 0 WHEN at = 'array' THEN json_array_length(a) = json_array_length(b) WHEN at = 'object' THEN (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(a) ORDER BY key)) IS (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(b) ORDER BY key)) WHEN at IN ('true', 'false') THEN at = bt ELSE a = b END AS r FROM w)) END) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, x.v1 AS v1, (CASE json_type(x.v1) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v1, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT (CASE la1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN la1.value WHEN 'object' THEN la1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT la1.value AS f))) ELSE json_quote(la1.value) END) AS v0, (CASE lb1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lb1.value WHEN 'object' THEN lb1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT lb1.value AS f))) ELSE json_quote(lb1.value) END) AS v1 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s2) AS eq, (SELECT (CASE WHEN s3.t0 IS NULL OR s3.t0 = 'null' OR s3.t1 IS NULL OR s3.t1 = 'null' THEN NULL WHEN s3.t0 IN ('integer', 'float') AND s3.t1 IN ('integer', 'float') THEN (s3.v0 ->> '$') < (s3.v1 ->> '$') WHEN s3.t0 <> s3.t1 THEN NULL WHEN s3.t0 = 'string' THEN ((s3.v0 ->> '$') < (s3.v1 ->> '$')) WHEN s3.t0 = 'boolean' THEN ((s3.v0 ->> '$') < (s3.v1 ->> '$')) ELSE (CASE WHEN s3.t0 = 'list' THEN NULL END) END) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, x.v1 AS v1, (CASE json_type(x.v1) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v1, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT (CASE la1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN la1.value WHEN 'object' THEN la1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT la1.value AS f))) ELSE json_quote(la1.value) END) AS v0, (CASE lb1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lb1.value WHEN 'object' THEN lb1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT lb1.value AS f))) ELSE json_quote(lb1.value) END) AS v1 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s3) AS cmp FROM json_each((n0."properties" -> ('$."' || ? || '"'))) AS la1 CROSS JOIN json_each((n1."properties" -> ('$."' || ? || '"'))) AS lb1 WHERE la1.key = lb1.key AND NOT (la1.key IS NULL AND la1.type = 'null') AND NOT (lb1.key IS NULL AND lb1.type = 'null') LIMIT -1 OFFSET 0) AS q WHERE NOT COALESCE(q.eq, 0) ORDER BY q.k LIMIT 1), CASE WHEN json_array_length((n0."properties" -> ('$."' || ? || '"'))) < json_array_length((n1."properties" -> ('$."' || ? || '"'))) THEN 1 ELSE 0 END) WHEN 1 THEN 1 WHEN 0 THEN 0 END) END) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type((n1."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n1."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s0) AND v3.s = n0."id" AND v3.t = n1."id" LIMIT ?
-- values: "~relationships", shortestPaths(search 1), "k", "k", "k", "k", "k", "k", "k", "k", "k", "k", "k", "k", "k", "k", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a)<-[:T|U]-(b)-[r]-(c) RETURN r.w 1`] = `
"MATCH (a)<-[:T|U]-(b)-[r]-(c) RETURN r.w
-- step 1
SELECT (e4."properties" -> ('$."' || ? || '"')) AS c0 FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 CROSS JOIN "edges" AS e2 CROSS JOIN "nodes" AS n3 CROSS JOIN "edges" AS e4 WHERE e2."start_id" = n1."id" AND e2."end_id" = n0."id" AND e2."type" IN (?, ?) AND ((e4."start_id" = n1."id" AND e4."end_id" = n3."id") OR (e4."start_id" = n3."id" AND e4."end_id" = n1."id")) AND e2."id" <> e4."id" LIMIT ?
-- values: "w", "T", "U", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a)-[*]-(b), (b)<-[*0..2]-(c) RETURN count(*) 1`] = `
"MATCH (a)-[*]-(b), (b)<-[*0..2]-(c) RETURN count(*)
-- step 1
SELECT g.x0 AS c0 FROM (SELECT COUNT(*) AS x0 FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 CROSS JOIN (WITH RECURSIVE v2p(s, t, d, path) AS (SELECT n3."id", n3."id", 0, json_array() FROM "nodes" AS n3 UNION ALL SELECT v2p.s, CASE WHEN e4."start_id" = v2p.t THEN e4."end_id" ELSE e4."start_id" END, v2p.d + 1, json_insert(v2p.path, '$[#]', e4."id") FROM v2p JOIN "edges" AS e4 ON (e4."start_id" = v2p.t OR e4."end_id" = v2p.t) WHERE v2p.d < ? AND NOT EXISTS (SELECT 1 FROM json_each(v2p.path) AS vj WHERE vj.value = e4."id")) SELECT s, t, path FROM v2p WHERE d >= 1) AS v2 CROSS JOIN "nodes" AS n5 CROSS JOIN (WITH RECURSIVE v6p(s, t, d, path) AS (SELECT n7."id", n7."id", 0, json_array() FROM "nodes" AS n7 UNION ALL SELECT v6p.s, e8."start_id", v6p.d + 1, json_insert(v6p.path, '$[#]', e8."id") FROM v6p JOIN "edges" AS e8 ON e8."end_id" = v6p.t WHERE v6p.d < ? AND NOT EXISTS (SELECT 1 FROM json_each(v6p.path) AS vj WHERE vj.value = e8."id")) SELECT s, t, path FROM v6p WHERE d >= 0) AS v6 WHERE v2.s = n0."id" AND v2.t = n1."id" AND v6.s = n1."id" AND v6.t = n5."id" AND NOT EXISTS (SELECT 1 FROM json_each(v2.path) AS vl JOIN json_each(v6.path) AS vr ON vl.value = vr.value)) AS g LIMIT ?
-- values: maxPathDepth, depth(2), limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a)-[r]->(b) MATCH (b)-[r2]->(c), (c)-[r]->(a) RETURN r2 1`] = `
"MATCH (a)-[r]->(b) MATCH (b)-[r2]->(c), (c)-[r]->(a) RETURN r2
-- step 1
SELECT e4."id" AS c0_id, e4."type" AS c0_type, e4."start_id" AS c0_start, e4."end_id" AS c0_end, e4."properties" AS c0_props FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 CROSS JOIN "edges" AS e2 CROSS JOIN "nodes" AS n3 CROSS JOIN "edges" AS e4 WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND e4."start_id" = n1."id" AND e4."end_id" = n3."id" AND e2."start_id" = n3."id" AND e2."end_id" = n0."id" AND e4."id" <> e2."id" LIMIT ?
-- values: limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a:A {k: 1}), (b:B) MATCH p = shortestPath((a)-[:T* {w: 1}]->(b)) RETURN p 1`] = `
"MATCH (a:A {k: 1}), (b:B) MATCH p = shortestPath((a)-[:T* {w: 1}]->(b)) RETURN p
-- step 1 (node pairs of shortest path search 1)
SELECT DISTINCT n0."id" AS s, n1."id" AS t FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') = ?) ELSE 0 END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) AND EXISTS (SELECT 1 FROM json_each(n1."labels") WHERE json_each.value = ?) LIMIT ?
-- values: "A", "1", "k", "1", "k", "k", "B", limit(maxRowsPerStep + 1)
-- search 1: breadth-first, one step per depth (one shortest path per pair, depth 1..maxPathDepth)
SELECT f, r, t FROM (SELECT e2."start_id" AS f, e2."id" AS r, e2."end_id" AS t FROM "edges" AS e2 WHERE e2."start_id" IN (SELECT value FROM json_each(?)) AND e2."type" = ? AND (SELECT (CASE WHEN s1.t0 IS NULL OR s1.t0 = 'null' OR ? IS NULL THEN NULL WHEN s1.t0 IN ('integer', 'float') THEN (((e2."properties" -> ('$."' || ? || '"')) ->> '$') = ?) ELSE 0 END) FROM (SELECT (CASE json_type((e2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((e2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s1)) AS x ORDER BY r, f LIMIT ?
-- values: frontier, "T", "1", "w", "1", "w", "w", limit(maxRowsPerStep + 1)
-- step 2
SELECT (CASE WHEN n0."id" IS NULL OR v3.path IS NULL THEN NULL ELSE json_object('~cypher', 'path', '~nodes', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(n0."properties", json_object('~cypher', 'node', '~id', n0."id", '~labels', json(n0."labels")))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v3.nodes IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'node', '~id', ve."id", '~labels', json(ve."labels")))) ORDER BY vj.key) FROM json_each(v3.nodes) AS vj JOIN "nodes" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k))), '~relationships', json((CASE WHEN v3.path IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'relationship', '~id', ve."id", '~type', ve."type", '~start', ve."start_id", '~end', ve."end_id"))) ORDER BY vj.key) FROM json_each(v3.path) AS vj JOIN "edges" AS ve ON ve."id" = vj.value) END))) END) AS c0 FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 CROSS JOIN (SELECT j.value ->> '$.s' AS s, j.value ->> '$.t' AS t, j.value -> '$.r' AS path, j.value -> '$.n' AS nodes FROM json_each(?) AS j) AS v3 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') = ?) ELSE 0 END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) AND EXISTS (SELECT 1 FROM json_each(n1."labels") WHERE json_each.value = ?) AND v3.s = n0."id" AND v3.t = n1."id" LIMIT ?
-- values: shortestPaths(search 1), "A", "1", "k", "1", "k", "k", "B", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a:A {k: 1})-[r:T {w: $w}]->(b) RETURN a, r, b 1`] = `
"MATCH (a:A {k: 1})-[r:T {w: $w}]->(b) RETURN a, r, b
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props, e2."id" AS c1_id, e2."type" AS c1_type, e2."start_id" AS c1_start, e2."end_id" AS c1_end, e2."properties" AS c1_props, n1."id" AS c2_id, n1."labels" AS c2_labels, n1."properties" AS c2_props FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 CROSS JOIN "edges" AS e2 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') = ?) ELSE 0 END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) AND e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND e2."type" = ? AND (SELECT (CASE WHEN s1.t0 IS NULL OR s1.t0 = 'null' OR s1.t1 IS NULL OR s1.t1 = 'null' THEN NULL WHEN s1.t0 IN ('integer', 'float') AND s1.t1 IN ('integer', 'float') THEN ((e2."properties" -> ('$."' || ? || '"')) ->> '$') = (? ->> '$') WHEN s1.t0 <> s1.t1 THEN 0 WHEN s1.t0 = 'string' THEN (((e2."properties" -> ('$."' || ? || '"')) ->> '$') = (? ->> '$')) WHEN s1.t0 = 'boolean' THEN (((e2."properties" -> ('$."' || ? || '"')) ->> '$') = (? ->> '$')) ELSE (WITH RECURSIVE w(a, at, b, bt) AS (SELECT CASE WHEN json_type((e2."properties" -> ('$."' || ? || '"'))) IN ('array', 'object') THEN (e2."properties" -> ('$."' || ? || '"')) ELSE (e2."properties" -> ('$."' || ? || '"')) ->> '$' END, json_type((e2."properties" -> ('$."' || ? || '"'))), CASE WHEN json_type(?) IN ('array', 'object') THEN ? ELSE ? ->> '$' END, json_type(?) UNION ALL SELECT x.value, x.type, y.value, y.type FROM w, json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.a END) AS x JOIN json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.b END) AS y ON x.key = y.key) SELECT CASE WHEN SUM(r = 0) > 0 THEN 0 WHEN SUM(r IS NULL) > 0 THEN NULL ELSE 1 END FROM (SELECT CASE WHEN COALESCE(at, 'null') = 'null' OR COALESCE(bt, 'null') = 'null' THEN NULL WHEN CASE at WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE at END <> CASE bt WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE bt END THEN 0 WHEN at = 'array' THEN json_array_length(a) = json_array_length(b) WHEN at = 'object' THEN (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(a) ORDER BY key)) IS (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(b) ORDER BY key)) WHEN at IN ('true', 'false') THEN at = bt ELSE a = b END AS r FROM w)) END) FROM (SELECT (CASE json_type((e2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((e2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(?) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(?, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s1) LIMIT ?
-- values: "A", "1", "k", "1", "k", "k", "T", "w", $w, "w", $w, "w", $w, "w", "w", "w", "w", $w, $w, $w, $w, "w", "w", $w, $w, limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a:A), (b) RETURN * 1`] = `
"MATCH (a:A), (b) RETURN *
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props, n1."id" AS c1_id, n1."labels" AS c1_labels, n1."properties" AS c1_props FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) LIMIT ?
-- values: "A", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a:A)-[r:T*1..3 {k: 1}]->(b)-[s]-(c) RETURN r, b 1`] = `
"MATCH (a:A)-[r:T*1..3 {k: 1}]->(b)-[s]-(c) RETURN r, b
-- step 1
SELECT (CASE WHEN v2.path IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'relationship', '~id', ve."id", '~type', ve."type", '~start', ve."start_id", '~end', ve."end_id"))) ORDER BY vj.key) FROM json_each(v2.path) AS vj JOIN "edges" AS ve ON ve."id" = vj.value) END) AS c0, n1."id" AS c1_id, n1."labels" AS c1_labels, n1."properties" AS c1_props FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 CROSS JOIN (WITH RECURSIVE v2p(s, t, d, path) AS (SELECT n3."id", n3."id", 0, json_array() FROM "nodes" AS n3 UNION ALL SELECT v2p.s, e4."end_id", v2p.d + 1, json_insert(v2p.path, '$[#]', e4."id") FROM v2p JOIN "edges" AS e4 ON e4."start_id" = v2p.t WHERE v2p.d < ? AND NOT EXISTS (SELECT 1 FROM json_each(v2p.path) AS vj WHERE vj.value = e4."id") AND e4."type" = ? AND (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((e4."properties" -> ('$."' || ? || '"')) ->> '$') = ?) ELSE 0 END) FROM (SELECT (CASE json_type((e4."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((e4."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0)) SELECT s, t, path FROM v2p WHERE d >= 1) AS v2 CROSS JOIN "nodes" AS n5 CROSS JOIN "edges" AS e6 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND v2.s = n0."id" AND v2.t = n1."id" AND ((e6."start_id" = n1."id" AND e6."end_id" = n5."id") OR (e6."start_id" = n5."id" AND e6."end_id" = n1."id")) AND NOT EXISTS (SELECT 1 FROM json_each(v2.path) AS vj WHERE vj.value = e6."id") LIMIT ?
-- values: depth(3), "T", "1", "k", "1", "k", "k", "A", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) RETURN DISTINCT n.name AS name ORDER BY name 1`] = `
"MATCH (n) RETURN DISTINCT n.name AS name ORDER BY name
-- step 1
SELECT * FROM (SELECT DISTINCT (n0."properties" -> ('$."' || ? || '"')) AS c0, (CASE (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) AS k0, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) AS k1, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) AS k2, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) AS k3, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('list', 'map', 'node', 'relationship', 'path') THEN (n0."properties" -> ('$."' || ? || '"')) END) AS k4 FROM "nodes" AS n0) AS d ORDER BY d.k0 ASC, d.k1 ASC, d.k2 ASC, d.k3 ASC, d.k4 ASC LIMIT ?
-- values: "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) RETURN n LIMIT 10 1`] = `
"MATCH (n) RETURN n LIMIT 10
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props FROM "nodes" AS n0 LIMIT ?
-- values: limit(10)"
`;

exports[`sqlite > read: MATCH (n) RETURN n.name AS name ORDER BY name DESC, n.age SKIP $s LIMIT 10 1`] = `
"MATCH (n) RETURN n.name AS name ORDER BY name DESC, n.age SKIP $s LIMIT 10
-- step 1
SELECT (n0."properties" -> ('$."' || ? || '"')) AS c0 FROM "nodes" AS n0 ORDER BY (CASE (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('list', 'map', 'node', 'relationship', 'path') THEN (n0."properties" -> ('$."' || ? || '"')) END) DESC, (CASE (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) ASC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('list', 'map', 'node', 'relationship', 'path') THEN (n0."properties" -> ('$."' || ? || '"')) END) ASC LIMIT ? OFFSET ?
-- values: "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", limit(10), skip($s)"
`;

exports[`sqlite > read: MATCH (n) RETURN n.team AS team, count(*) AS c, max(n.age) - min(n.age) AS spread ORDER BY c DESC 1`] = `
"MATCH (n) RETURN n.team AS team, count(*) AS c, max(n.age) - min(n.age) AS spread ORDER BY c DESC
-- step 1
SELECT g.g0 AS c0, g.x0 AS c1, (SELECT (CASE WHEN s0.t0 = 'null' OR s0.t1 = 'null' THEN NULL WHEN s0.t0 = 'integer' AND s0.t1 = 'integer' THEN json_quote(((g.x1 ->> '$') - (g.x2 ->> '$'))) WHEN s0.t0 IN ('integer', 'float') AND s0.t1 IN ('integer', 'float') THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT ((g.x1 ->> '$') - (g.x2 ->> '$')) AS f))) END) FROM (SELECT (CASE json_type(g.x1) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(g.x1, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(g.x2) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(g.x2, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s0) AS c2 FROM (SELECT (n0."properties" -> ('$."' || ? || '"')) AS g0, COUNT(*) AS x0, (json_group_array(json((n0."properties" -> ('$."' || ? || '"'))) ORDER BY (CASE (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('list', 'map', 'node', 'relationship', 'path') THEN (n0."properties" -> ('$."' || ? || '"')) END) DESC) FILTER (WHERE NOT (COALESCE(json_type((n0."properties" -> ('$."' || ? || '"'))), 'null') = 'null')) -> ('$[' || CASE WHEN 0 < 0 THEN '#' || 0 ELSE 0 END || ']')) AS x1, (json_group_array(json((n0."properties" -> ('$."' || ? || '"'))) ORDER BY (CASE (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) ASC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('list', 'map', 'node', 'relationship', 'path') THEN (n0."properties" -> ('$."' || ? || '"')) END) ASC) FILTER (WHERE NOT (COALESCE(json_type((n0."properties" -> ('$."' || ? || '"'))), 'null') = 'null')) -> ('$[' || CASE WHEN 0 < 0 THEN '#' || 0 ELSE 0 END || ']')) AS x2 FROM "nodes" AS n0 GROUP BY (n0."properties" -> ('$."' || ? || '"'))) AS g ORDER BY g.x0 DESC NULLS FIRST LIMIT ?
-- values: "team", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "team", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) WHERE n.age > 30 AND n.name STARTS WITH $p RETURN n.name, n.age + 1 AS next 1`] = `
"MATCH (n) WHERE n.age > 30 AND n.name STARTS WITH $p RETURN n.name, n.age + 1 AS next
-- step 1
SELECT (n0."properties" -> ('$."' || ? || '"')) AS c0, (SELECT (CASE WHEN s2.t0 = 'null' OR s2.t1 = 'null' THEN NULL WHEN s2.t0 = 'integer' AND s2.t1 = 'integer' THEN json_quote((((n0."properties" -> ('$."' || ? || '"')) ->> '$') + (json_quote(?) ->> '$'))) WHEN s2.t0 IN ('integer', 'float') AND s2.t1 IN ('integer', 'float') THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT (((n0."properties" -> ('$."' || ? || '"')) ->> '$') + (json_quote(?) ->> '$')) AS f))) WHEN s2.t0 = 'string' AND s2.t1 = 'string' THEN json_quote((((n0."properties" -> ('$."' || ? || '"')) ->> '$') || (json_quote(?) ->> '$'))) WHEN s2.t0 = 'list' OR s2.t1 = 'list' THEN (SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each((CASE WHEN s2.t0 = 'list' THEN (n0."properties" -> ('$."' || ? || '"')) ELSE json_array(json((n0."properties" -> ('$."' || ? || '"')))) END)) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN s2.t1 = 'list' THEN json_quote(?) ELSE json_array(json(json_quote(?))) END)) AS b ORDER BY side, k)) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(json_quote(?)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(json_quote(?), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s2) AS c1 FROM "nodes" AS n0 WHERE ((SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') > ?) ELSE NULL END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) AND (SELECT (CASE WHEN s1.t0 = 'string' AND s1.t1 = 'string' THEN (substr(((n0."properties" -> ('$."' || ? || '"')) ->> '$'), 1, length((? ->> '$'))) = (? ->> '$')) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(?) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(?, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s1)) LIMIT ?
-- values: "name", "age", "1", "age", "1", "age", "1", "age", "age", "1", "1", "age", "age", "1", "1", "30", "age", "30", "age", "age", "name", $p, $p, "name", "name", $p, $p, limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) WHERE toLower(n.name) STARTS WITH 'a' RETURN size(labels(n)), coalesce(n.x, 0), range(1, $n) 1`] = `
"MATCH (n) WHERE toLower(n.name) STARTS WITH 'a' RETURN size(labels(n)), coalesce(n.x, 0), range(1, $n)
-- step 1
SELECT (SELECT json_array_length(s2.v0) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT n0."labels" AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s2) AS c0, (SELECT COALESCE(CASE WHEN s3.t0 <> 'null' THEN (n0."properties" -> ('$."' || ? || '"')) END, CASE WHEN s3.t1 <> 'null' THEN json_quote(?) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(json_quote(?)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(json_quote(?), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s3) AS c1, (SELECT (CASE WHEN s4.t1 IN ('integer') THEN (WITH RECURSIVE rg(v) AS (SELECT ? UNION ALL SELECT v + 1 FROM rg WHERE (1 > 0 AND v + 1 <= (? ->> '$')) OR (1 < 0 AND v + 1 >= (? ->> '$'))) SELECT json_group_array(v) FROM rg WHERE (1 > 0 AND v <= (? ->> '$')) OR (1 < 0 AND v >= (? ->> '$'))) END) FROM (SELECT (CASE json_type(?) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(?, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s4) AS c2 FROM "nodes" AS n0 WHERE (SELECT (substr(s1.v0, 1, length(?)) = ?) FROM (SELECT x.v0 AS v0 FROM (SELECT (SELECT (CASE WHEN s0.t0 IN ('string') THEN lower(((n0."properties" -> ('$."' || ? || '"')) ->> '$')) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s1) LIMIT ?
-- values: "x", "0", "x", "x", "0", "0", "1", $n, $n, $n, $n, $n, $n, "a", "a", "name", "name", "name", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) WITH n, count(*) AS c WHERE c > 1 MATCH (n)-->(m) RETURN m.name ORDER BY m.name 1`] = `
"MATCH (n) WITH n, count(*) AS c WHERE c > 1 MATCH (n)-->(m) RETURN m.name ORDER BY m.name
-- step 1
SELECT (n2."properties" -> ('$."' || ? || '"')) AS c0 FROM (SELECT g.g0_id AS c0, g.x0 AS c1 FROM (SELECT n0."id" AS g0_id, n0."labels" AS g0_labels, n0."properties" AS g0_properties, COUNT(*) AS x0 FROM "nodes" AS n0 GROUP BY n0."id", n0."labels", n0."properties") AS g) AS w0 LEFT JOIN "nodes" AS n1 ON n1."id" = w0.c0 CROSS JOIN "nodes" AS n2 CROSS JOIN "edges" AS e3 WHERE (w0.c1 > ?) AND e3."start_id" = n1."id" AND e3."end_id" = n2."id" ORDER BY (CASE (CASE json_type((n2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) ASC, (CASE WHEN (CASE json_type((n2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((n2."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN ((n2."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((n2."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('list', 'map', 'node', 'relationship', 'path') THEN (n2."properties" -> ('$."' || ? || '"')) END) ASC LIMIT ?
-- values: "name", "1", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n)-->(m) RETURN n, collect(DISTINCT m.name), avg(m.age) 1`] = `
"MATCH (n)-->(m) RETURN n, collect(DISTINCT m.name), avg(m.age)
-- step 1
SELECT g.g0_id AS c0_id, g.g0_labels AS c0_labels, g.g0_properties AS c0_props, g.x0 AS c1, g.x1 AS c2 FROM (SELECT n0."id" AS g0_id, n0."labels" AS g0_labels, n0."properties" AS g0_properties, json_group_array(DISTINCT json((n1."properties" -> ('$."' || ? || '"')))) FILTER (WHERE NOT (COALESCE(json_type((n1."properties" -> ('$."' || ? || '"'))), 'null') = 'null')) AS x0, AVG(CASE WHEN (CASE json_type((n1."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n1."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN CAST(((n1."properties" -> ('$."' || ? || '"')) ->> '$') AS REAL) END) AS x1 FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 CROSS JOIN "edges" AS e2 WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id" GROUP BY n0."id", n0."labels", n0."properties") AS g LIMIT ?
-- values: "name", "name", "age", "age", "age", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n:Person:Admin) RETURN n.name AS name, n 1`] = `
"MATCH (n:Person:Admin) RETURN n.name AS name, n
-- step 1
SELECT (n0."properties" -> ('$."' || ? || '"')) AS c0, n0."id" AS c1_id, n0."labels" AS c1_labels, n0."properties" AS c1_props FROM "nodes" AS n0 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) LIMIT ?
-- values: "name", "Person", "Admin", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (p) OPTIONAL MATCH (p)-[r:R]->(q) WHERE r.w > 1 RETURN p, q 1`] = `
"MATCH (p) OPTIONAL MATCH (p)-[r:R]->(q) WHERE r.w > 1 RETURN p, q
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props, n1."id" AS c1_id, n1."labels" AS c1_labels, n1."properties" AS c1_props FROM "nodes" AS n0 LEFT JOIN ("nodes" AS n1 CROSS JOIN "edges" AS e2) ON e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND e2."type" = ? AND (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((e2."properties" -> ('$."' || ? || '"')) ->> '$') > ?) ELSE NULL END) FROM (SELECT (CASE json_type((e2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((e2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) LIMIT ?
-- values: "R", "1", "w", "1", "w", "w", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH p = (a)-[r]->(b)-[*1..2]->(c) RETURN p, length(p), nodes(p) 1`] = `
"MATCH p = (a)-[r]->(b)-[*1..2]->(c) RETURN p, length(p), nodes(p)
-- step 1
SELECT (CASE WHEN n0."id" IS NULL OR e2."id" IS NULL OR n1."id" IS NULL OR v4.path IS NULL THEN NULL ELSE json_object('~cypher', 'path', '~nodes', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(n0."properties", json_object('~cypher', 'node', '~id', n0."id", '~labels', json(n0."labels")))), json(json_patch(n1."properties", json_object('~cypher', 'node', '~id', n1."id", '~labels', json(n1."labels")))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v4.nodes IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'node', '~id', ve."id", '~labels', json(ve."labels")))) ORDER BY vj.key) FROM json_each(v4.nodes) AS vj JOIN "nodes" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k))), '~relationships', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(e2."properties", json_object('~cypher', 'relationship', '~id', e2."id", '~type', e2."type", '~start', e2."start_id", '~end', e2."end_id"))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v4.path IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'relationship', '~id', ve."id", '~type', ve."type", '~start', ve."start_id", '~end', ve."end_id"))) ORDER BY vj.key) FROM json_each(v4.path) AS vj JOIN "edges" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k)))) END) AS c0, (SELECT json_array_length((s0.v0 -> ('$."' || ? || '"'))) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT (CASE WHEN n0."id" IS NULL OR e2."id" IS NULL OR n1."id" IS NULL OR v4.path IS NULL THEN NULL ELSE json_object('~cypher', 'path', '~nodes', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(n0."properties", json_object('~cypher', 'node', '~id', n0."id", '~labels', json(n0."labels")))), json(json_patch(n1."properties", json_object('~cypher', 'node', '~id', n1."id", '~labels', json(n1."labels")))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v4.nodes IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'node', '~id', ve."id", '~labels', json(ve."labels")))) ORDER BY vj.key) FROM json_each(v4.nodes) AS vj JOIN "nodes" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k))), '~relationships', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(e2."properties", json_object('~cypher', 'relationship', '~id', e2."id", '~type', e2."type", '~start', e2."start_id", '~end', e2."end_id"))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v4.path IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'relationship', '~id', ve."id", '~type', ve."type", '~start', ve."start_id", '~end', ve."end_id"))) ORDER BY vj.key) FROM json_each(v4.path) AS vj JOIN "edges" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k)))) END) AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s0) AS c1, (SELECT (s1.v0 -> ('$."' || ? || '"')) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT (CASE WHEN n0."id" IS NULL OR e2."id" IS NULL OR n1."id" IS NULL OR v4.path IS NULL THEN NULL ELSE json_object('~cypher', 'path', '~nodes', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(n0."properties", json_object('~cypher', 'node', '~id', n0."id", '~labels', json(n0."labels")))), json(json_patch(n1."properties", json_object('~cypher', 'node', '~id', n1."id", '~labels', json(n1."labels")))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v4.nodes IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'node', '~id', ve."id", '~labels', json(ve."labels")))) ORDER BY vj.key) FROM json_each(v4.nodes) AS vj JOIN "nodes" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k))), '~relationships', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(e2."properties", json_object('~cypher', 'relationship', '~id', e2."id", '~type', e2."type", '~start', e2."start_id", '~end', e2."end_id"))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v4.path IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'relationship', '~id', ve."id", '~type', ve."type", '~start', ve."start_id", '~end', ve."end_id"))) ORDER BY vj.key) FROM json_each(v4.path) AS vj JOIN "edges" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k)))) END) AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s1) AS c2 FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 CROSS JOIN "edges" AS e2 CROSS JOIN "nodes" AS n3 CROSS JOIN (WITH RECURSIVE v4p(s, t, d, path, nodes) AS (SELECT n5."id", n5."id", 0, json_array(), json_array() FROM "nodes" AS n5 UNION ALL SELECT v4p.s, e6."end_id", v4p.d + 1, json_insert(v4p.path, '$[#]', e6."id"), json_insert(v4p.nodes, '$[#]', e6."end_id") FROM v4p JOIN "edges" AS e6 ON e6."start_id" = v4p.t WHERE v4p.d < ? AND NOT EXISTS (SELECT 1 FROM json_each(v4p.path) AS vj WHERE vj.value = e6."id")) SELECT s, t, path, nodes FROM v4p WHERE d >= 1) AS v4 WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND v4.s = n1."id" AND v4.t = n3."id" AND NOT EXISTS (SELECT 1 FROM json_each(v4.path) AS vj WHERE vj.value = e2."id") LIMIT ?
-- values: "~relationships", "~nodes", depth(2), limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: OPTIONAL MATCH (x:Missing) RETURN x 1`] = `
"OPTIONAL MATCH (x:Missing) RETURN x
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props FROM (SELECT 1 AS one) AS one1 LEFT JOIN "nodes" AS n0 ON EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) LIMIT ?
-- values: "Missing", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: RETURN 1 AS i, 1.5 AS f, 'x' AS s, [1, null] AS l, {k: true} AS m, $p AS p 1`] = `
"RETURN 1 AS i, 1.5 AS f, 'x' AS s, [1, null] AS l, {k: true} AS m, $p AS p
-- step 1
SELECT ? AS c0, CAST(? AS REAL) AS c1, ? AS c2, ? AS c3, ? AS c4, ? AS c5 LIMIT ?
-- values: "1", 1.5, "x", [1,null], {"k":true}, $p, limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max 1`] = `
"UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max
-- step 1
SELECT (n2."properties" -> ('$."' || ? || '"')) AS c0, (CASE u1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u1.value WHEN 'object' THEN u1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u1.value AS f))) ELSE json_quote(u1.value) END) AS c1 FROM json_each(?) AS u0 CROSS JOIN json_each((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END)) AS u1 CROSS JOIN "nodes" AS n2 WHERE NOT (u0.key IS NULL AND u0.type = 'null') AND NOT (u1.key IS NULL AND u1.type = 'null') AND EXISTS (SELECT 1 FROM json_each(n2."labels") WHERE json_each.value = ?) ORDER BY u0.key, u1.key, n2."id" LIMIT ?
-- values: "k", $lists, "N", limit($max)"
`;

exports[`sqlite > read: UNWIND $xs AS x WITH x ORDER BY x DESC LIMIT 3 RETURN x 1`] = `
"UNWIND $xs AS x WITH x ORDER BY x DESC LIMIT 3 RETURN x
-- step 1
SELECT w0.c0 AS c0 FROM (SELECT s.*, row_number() OVER () AS o FROM (SELECT (CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END) AS c0 FROM json_each(?) AS u0 WHERE NOT (u0.key IS NULL AND u0.type = 'null') ORDER BY (CASE (CASE json_type((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) DESC, (CASE WHEN (CASE json_type((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END) ->> '$') END) DESC, (CASE WHEN (CASE json_type((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN ((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END) ->> '$') END) DESC, (CASE WHEN (CASE json_type((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END) ->> '$') END) DESC, (CASE WHEN (CASE json_type((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('list', 'map', 'node', 'relationship', 'path') THEN (CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END) END) DESC, u0.key LIMIT ?) AS s) AS w0 ORDER BY w0.o LIMIT ?
-- values: $xs, limit(3), limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: UNWIND [{a: {b: 1}}] AS m RETURN m.a.b 1`] = `
"UNWIND [{a: {b: 1}}] AS m RETURN m.a.b
-- step 1
SELECT (((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END) -> ('$."' || ? || '"')) -> ('$."' || ? || '"')) AS c0 FROM json_each(?) AS u0 WHERE NOT (u0.key IS NULL AND u0.type = 'null') ORDER BY u0.key LIMIT ?
-- values: "a", "b", [{"a":{"b":1}}], limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: UNWIND [1, 2] AS x RETURN x 1`] = `
"UNWIND [1, 2] AS x RETURN x
-- step 1
SELECT (CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END) AS c0 FROM json_each(?) AS u0 WHERE NOT (u0.key IS NULL AND u0.type = 'null') ORDER BY u0.key LIMIT ?
-- values: [1,2], limit(maxRowsPerStep + 1)"
`;
