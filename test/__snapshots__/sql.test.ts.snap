exports[`postgres > create with database ids: CREATE (a:A {name: 'x', n: null})-[:T {w: 1.5}]->(b:B $props)<-[:U]-(a) 1`] = `
"CREATE (a:A {name: 'x', n: null})-[:T {w: 1.5}]->(b:B $props)<-[:U]-(a)
-- step 1
INSERT INTO "nodes" ("labels", "properties") VALUES (($1::jsonb), ($2::jsonb)) RETURNING "id" AS id
-- values: ["A"], {name: "x", n: null}
-- step 2
INSERT INTO "nodes" ("labels", "properties") VALUES (($1::jsonb), ($2::jsonb)) RETURNING "id" AS id
-- values: ["B"], $props
-- step 3
