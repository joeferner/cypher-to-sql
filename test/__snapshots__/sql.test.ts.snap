EN abs(f) / pow(10, e0) < 1 THEN e0 - 1 ELSE e0 END, -300) AS e FROM (SELECT f, max(CAST(floor(log10(CASE WHEN f = 0 OR abs(f) > 1.7976931348623157e308 THEN 1 ELSE abs(f) END)) AS INTEGER), -300) AS e0 FROM (SELECT ((lkv.v ->> '$')) AS f)))) WHEN lkv.t = 'string' THEN 'G' || (replace((lkv.v ->> '$'), char(1), char(1, 2)) || char(1, 1)) WHEN lkv.t = 'boolean' THEN 'H' || (CASE WHEN (lkv.v ->> '$') THEN '1' ELSE '0' END) WHEN lkv.t = 'null' THEN 'J' ELSE (CASE lkv.t WHEN 'map' THEN 'B' WHEN 'node' THEN 'C' WHEN 'relationship' THEN 'D' WHEN 'list' THEN 'E' ELSE 'F' END) || (replace(lkv.v, char(1), char(1, 2)) || char(1, 1)) END), '' ORDER BY lkv.o), '') || 'A' FROM (SELECT (CASE lk1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lk1.value WHEN 'object' THEN lk1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lk1.value AS f))) ELSE json_quote(lk1.value) END) AS v, (CASE json_type((CASE lk1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lk1.value WHEN 'object' THEN lk1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lk1.value AS f))) ELSE json_quote(lk1.value) END)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((CASE lk1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lk1.value WHEN 'object' THEN lk1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lk1.value AS f))) ELSE json_quote(lk1.value) END), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t, lk1.key AS o FROM json_each((n0."properties" -> ('$."' || ? || '"'))) AS lk1 WHERE NOT (lk1.key IS NULL AND lk1.type = 'null')) AS lkv) WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('map', 'node', 'relationship', 'path') THEN (n0."properties" -> ('$."' || ? || '"')) END) ASC) FILTER (WHERE NOT (COALESCE(json_type((n0."properties" -> ('$."' || ? || '"'))), 'null') = 'null')) -> ('$[' || CASE WHEN 0 < 0 THEN '#' || 0 ELSE 0 END || ']')) AS x2 FROM "nodes" AS n0 GROUP BY (n0."properties" -> ('$."' || ? || '"'))) AS g ORDER BY g.x0 DESC NULLS FIRST LIMIT ?
-- values: "team", "age", "age", "age", "age", "age", "age", "~k", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "~k", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "age", "team", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) WHERE (n)-[:T]->() AND NOT EXISTS { (n)<-[r]-(m) WHERE r.w > m.w } RETURN [(n)-->(x) | x.k] 1`] = `
"MATCH (n) WHERE (n)-[:T]->() AND NOT EXISTS { (n)<-[r]-(m) WHERE r.w > m.w } RETURN [(n)-->(x) | x.k]
-- step 1
SELECT (SELECT json_group_array(json((q2_n0."properties" -> ('$."' || ? || '"'))) ORDER BY q2_n0."id", q2_e1."id") FILTER (WHERE 1) FROM "nodes" AS q2_n0 JOIN "edges" AS q2_e1 ON 1 WHERE q2_e1."start_id" = n0."id" AND q2_e1."end_id" = q2_n0."id") AS c0 FROM "nodes" AS n0 WHERE (EXISTS (SELECT 1 FROM "nodes" AS q0_n0 JOIN "edges" AS q0_e1 ON 1 WHERE q0_e1."start_id" = n0."id" AND q0_e1."end_id" = q0_n0."id" AND q0_e1."type" = ?) AND (NOT EXISTS (SELECT 1 FROM "nodes" AS q1_n0 JOIN "edges" AS q1_e1 ON 1 WHERE q1_e1."start_id" = q1_n0."id" AND q1_e1."end_id" = n0."id" AND (SELECT (CASE WHEN sq1_0.t0 IS NULL OR sq1_0.t0 = 'null' OR sq1_0.t1 IS NULL OR sq1_0.t1 = 'null' THEN NULL WHEN sq1_0.t0 IN ('integer', 'float') AND sq1_0.t1 IN ('integer', 'float') THEN ((q1_e1."properties" -> ('$."' || ? || '"')) ->> '$') > ((q1_n0."properties" -> ('$."' || ? || '"')) ->> '$') WHEN sq1_0.t0 <> sq1_0.t1 THEN NULL WHEN sq1_0.t0 IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN ((((q1_e1."properties" -> ('$."' || ? || '"')) -> ('$."' || ? || '"')) ->> '$') > (((q1_n0."properties" -> ('$."' || ? || '"')) -> ('$."' || ? || '"')) ->> '$')) WHEN sq1_0.t0 = 'string' THEN (((q1_e1."properties" -> ('$."' || ? || '"')) ->> '$') > ((q1_n0."properties" -> ('$."' || ? || '"')) ->> '$')) WHEN sq1_0.t0 = 'boolean' THEN (((q1_e1."properties" -> ('$."' || ? || '"')) ->> '$') > ((q1_n0."properties" -> ('$."' || ? || '"')) ->> '$')) ELSE (CASE WHEN sq1_0.t0 = 'list' THEN (CASE COALESCE((SELECT CASE WHEN q.eq IS NULL OR q.cmp IS NULL THEN 2 WHEN q.cmp THEN 1 ELSE 0 END FROM (SELECT laq1_1.key AS k, (SELECT (CASE WHEN sq1_2.t0 IS NULL OR sq1_2.t0 = 'null' OR sq1_2.t1 IS NULL OR sq1_2.t1 = 'null' THEN NULL WHEN sq1_2.t0 IN ('integer', 'float') AND sq1_2.t1 IN ('integer', 'float') THEN (sq1_2.v0 ->> '$') = (sq1_2.v1 ->> '$') WHEN sq1_2.t0 <> sq1_2.t1 THEN 0 WHEN sq1_2.t0 IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN (((sq1_2.v0 -> ('$."' || ? || '"')) ->> '$') = ((sq1_2.v1 -> ('$."' || ? || '"')) ->> '$')) WHEN sq1_2.t0 = 'string' THEN ((sq1_2.v0 ->> '$') = (sq1_2.v1 ->> '$')) WHEN sq1_2.t0 = 'boolean' THEN ((sq1_2.v0 ->> '$') = (sq1_2.v1 ->> '$')) ELSE (WITH RECURSIVE w(a, at, b, bt) AS (SELECT CASE WHEN json_type(sq1_2.v0) IN ('array', 'object') THEN sq1_2.v0 ELSE sq1_2.v0 ->> '$' END, json_type(sq1_2.v0), CASE WHEN json_type(sq1_2.v1) IN ('array', 'object') THEN sq1_2.v1 ELSE sq1_2.v1 ->> '$' END, json_type(sq1_2.v1) UNION ALL SELECT x.value, x.type, y.value, y.type FROM w, json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.a END) AS x JOIN json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.b END) AS y ON x.key = y.key) SELECT CASE WHEN SUM(r = 0) > 0 THEN 0 WHEN SUM(r IS NULL) > 0 THEN NULL ELSE 1 END FROM (SELECT CASE WHEN COALESCE(at, 'null') = 'null' OR COALESCE(bt, 'null') = 'null' THEN NULL WHEN CASE at WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE at END <> CASE bt WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE bt END THEN 0 WHEN at = 'array' THEN json_array_length(a) = json_array_length(b) WHEN at = 'object' THEN (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(a) ORDER BY key)) IS (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(b) ORDER BY key)) WHEN at IN ('true', 'false') THEN at = bt ELSE a = b END AS r FROM w)) END) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, x.v1 AS v1, (CASE json_type(x.v1) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v1, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT (CASE laq1_1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN laq1_1.value WHEN 'object' THEN laq1_1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT laq1_1.value AS f))) ELSE json_quote(laq1_1.value) END) AS v0, (CASE lbq1_1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lbq1_1.value WHEN 'object' THEN lbq1_1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lbq1_1.value AS f))) ELSE json_quote(lbq1_1.value) END) AS v1 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS sq1_2) AS eq, (SELECT (CASE WHEN sq1_3.t0 IS NULL OR sq1_3.t0 = 'null' OR sq1_3.t1 IS NULL OR sq1_3.t1 = 'null' THEN NULL WHEN sq1_3.t0 IN ('integer', 'float') AND sq1_3.t1 IN ('integer', 'float') THEN (sq1_3.v0 ->> '$') > (sq1_3.v1 ->> '$') WHEN sq1_3.t0 <> sq1_3.t1 THEN NULL WHEN sq1_3.t0 IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN (((sq1_3.v0 -> ('$."' || ? || '"')) ->> '$') > ((sq1_3.v1 -> ('$."' || ? || '"')) ->> '$')) WHEN sq1_3.t0 = 'string' THEN ((sq1_3.v0 ->> '$') > (sq1_3.v1 ->> '$')) WHEN sq1_3.t0 = 'boolean' THEN ((sq1_3.v0 ->> '$') > (sq1_3.v1 ->> '$')) ELSE (CASE WHEN sq1_3.t0 = 'list' THEN NULL END) END) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, x.v1 AS v1, (CASE json_type(x.v1) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v1, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT (CASE laq1_1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN laq1_1.value WHEN 'object' THEN laq1_1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT laq1_1.value AS f))) ELSE json_quote(laq1_1.value) END) AS v0, (CASE lbq1_1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lbq1_1.value WHEN 'object' THEN lbq1_1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lbq1_1.value AS f))) ELSE json_quote(lbq1_1.value) END) AS v1 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS sq1_3) AS cmp FROM json_each((q1_e1."properties" -> ('$."' || ? || '"'))) AS laq1_1 CROSS JOIN json_each((q1_n0."properties" -> ('$."' || ? || '"'))) AS lbq1_1 WHERE laq1_1.key = lbq1_1.key AND NOT (laq1_1.key IS NULL AND laq1_1.type = 'null') AND NOT (lbq1_1.key IS NULL AND lbq1_1.type = 'null') LIMIT -1 OFFSET 0) AS q WHERE NOT COALESCE(q.eq, 0) ORDER BY q.k LIMIT 1), CASE WHEN json_array_length((q1_e1."properties" -> ('$."' || ? || '"'))) > json_array_length((q1_n0."properties" -> ('$."' || ? || '"'))) THEN 1 ELSE 0 END) WHEN 1 THEN 1 WHEN 0 THEN 0 END) END) END) FROM (SELECT (CASE json_type((q1_e1."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((q1_e1."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type((q1_n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((q1_n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS sq1_0)))) LIMIT ?
-- values: "k", "T", "w", "w", "w", "~k", "w", "~k", "w", "w", "w", "w", "~k", "~k", "~k", "~k", "w", "w", "w", "w", "w", "w", "w", "w", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) WHERE EXISTS { MATCH (n)-->(m) WITH n, count(*) AS c WHERE c > 2 RETURN c } RETURN n 1`] = `
"MATCH (n) WHERE EXISTS { MATCH (n)-->(m) WITH n, count(*) AS c WHERE c > 2 RETURN c } RETURN n
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props FROM "nodes" AS n0 WHERE EXISTS (SELECT q0_w0.c1 AS c0 FROM (SELECT g.g0_id AS c0, g.x0 AS c1 FROM (SELECT n0."id" AS g0_id, n0."labels" AS g0_labels, n0."properties" AS g0_properties, COUNT(*) AS x0 FROM "nodes" AS q0_n0 JOIN "edges" AS q0_e1 ON 1 WHERE q0_e1."start_id" = n0."id" AND q0_e1."end_id" = q0_n0."id" HAVING COUNT(*) > 0) AS g) AS q0_w0 LEFT JOIN "nodes" AS q0_n1 ON q0_n1."id" = q0_w0.c0 WHERE (q0_w0.c1 > ?) LIMIT ?) LIMIT ?
-- values: "2", limit(maxRowsPerStep + 1), limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) WHERE any(t IN n.tags WHERE t STARTS WITH $p) RETURN [t IN n.tags WHERE t <> $p | toUpper(t)] 1`] = `
"MATCH (n) WHERE any(t IN n.tags WHERE t STARTS WITH $p) RETURN [t IN n.tags WHERE t <> $p | toUpper(t)]
-- step 1
SELECT (SELECT (CASE WHEN s3.t0 = 'list' THEN (SELECT json_group_array(json(json_quote((SELECT (CASE WHEN (s6.t0 IS NULL OR s6.t0 = 'null') THEN NULL WHEN s6.t0 IN ('string') THEN upper((s6.v0 ->> '$')) ELSE json_extract('{}', '!cypher:1' || substr(random(), 1, 0)) END) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT (CASE lc4.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lc4.value WHEN 'object' THEN lc4.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lc4.value AS f))) ELSE json_quote(lc4.value) END) AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s6))) ORDER BY lc4.key) FILTER (WHERE (SELECT (CASE WHEN s5.t0 IS NULL OR s5.t0 = 'null' OR s5.t1 IS NULL OR s5.t1 = 'null' THEN NULL WHEN s5.t0 IN ('integer', 'float') AND s5.t1 IN ('integer', 'float') THEN (s5.v0 ->> '$') <> (? ->> '$') WHEN s5.t0 <> s5.t1 THEN 1 WHEN s5.t0 IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN (((s5.v0 -> ('$."' || ? || '"')) ->> '$') <> ((? -> ('$."' || ? || '"')) ->> '$')) WHEN s5.t0 = 'string' THEN ((s5.v0 ->> '$') <> (? ->> '$')) WHEN s5.t0 = 'boolean' THEN ((s5.v0 ->> '$') <> (? ->> '$')) ELSE (NOT (WITH RECURSIVE w(a, at, b, bt) AS (SELECT CASE WHEN json_type(s5.v0) IN ('array', 'object') THEN s5.v0 ELSE s5.v0 ->> '$' END, json_type(s5.v0), CASE WHEN json_type(?) IN ('array', 'object') THEN ? ELSE ? ->> '$' END, json_type(?) UNION ALL SELECT x.value, x.type, y.value, y.type FROM w, json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.a END) AS x JOIN json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.b END) AS y ON x.key = y.key) SELECT CASE WHEN SUM(r = 0) > 0 THEN 0 WHEN SUM(r IS NULL) > 0 THEN NULL ELSE 1 END FROM (SELECT CASE WHEN COALESCE(at, 'null') = 'null' OR COALESCE(bt, 'null') = 'null' THEN NULL WHEN CASE at WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE at END <> CASE bt WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE bt END THEN 0 WHEN at = 'array' THEN json_array_length(a) = json_array_length(b) WHEN at = 'object' THEN (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(a) ORDER BY key)) IS (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(b) ORDER BY key)) WHEN at IN ('true', 'false') THEN at = bt ELSE a = b END AS r FROM w))) END) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(?) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(?, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT (CASE lc4.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lc4.value WHEN 'object' THEN lc4.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lc4.value AS f))) ELSE json_quote(lc4.value) END) AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s5)) FROM json_each((n0."properties" -> ('$."' || ? || '"'))) AS lc4 WHERE NOT (lc4.key IS NULL AND lc4.type = 'null')) WHEN (s3.t0 IS NULL OR s3.t0 = 'null') THEN NULL ELSE json_extract('{}', '!cypher:2' || substr(random(), 1, 0)) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s3) AS c0 FROM "nodes" AS n0 WHERE (SELECT (CASE WHEN s0.t0 = 'list' THEN (SELECT (CASE WHEN SUM(CASE WHEN p THEN 1 ELSE 0 END) > 0 THEN 1 WHEN SUM(CASE WHEN p IS NULL THEN 1 ELSE 0 END) > 0 THEN NULL ELSE 0 END) FROM (SELECT (SELECT (CASE WHEN s2.t0 = 'string' AND s2.t1 = 'string' THEN (substr((s2.v0 ->> '$'), 1, length((? ->> '$'))) = (? ->> '$')) END) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(?) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(?, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT (CASE lq1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lq1.value WHEN 'object' THEN lq1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lq1.value AS f))) ELSE json_quote(lq1.value) END) AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s2) AS p FROM json_each((n0."properties" -> ('$."' || ? || '"'))) AS lq1 WHERE NOT (lq1.key IS NULL AND lq1.type = 'null')) AS q1) WHEN (s0.t0 IS NULL OR s0.t0 = 'null') THEN NULL ELSE json_extract('{}', '!cypher:0' || substr(random(), 1, 0)) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) LIMIT ?
-- values: $p, "~k", $p, "~k", $p, $p, $p, $p, $p, $p, $p, $p, "tags", "tags", "tags", $p, $p, $p, $p, "tags", "tags", "tags", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) WHERE n.age > 30 AND n.name STARTS WITH $p RETURN n.name, n.age + 1 AS next 1`] = `
"MATCH (n) WHERE n.age > 30 AND n.name STARTS WITH $p RETURN n.name, n.age + 1 AS next
-- step 1
SELECT (n0."properties" -> ('$."' || ? || '"')) AS c0, (SELECT (CASE WHEN (s2.t0 IS NULL OR s2.t0 = 'null') OR (s2.t1 IS NULL OR s2.t1 = 'null') THEN NULL WHEN s2.t0 = 'integer' AND s2.t1 = 'integer' THEN json_quote((CASE WHEN typeof((((n0."properties" -> ('$."' || ? || '"')) ->> '$') + (json_quote(?) ->> '$'))) = 'real' THEN json_extract('{}', '!cypher:0' || substr(random(), 1, 0)) ELSE (((n0."properties" -> ('$."' || ? || '"')) ->> '$') + (json_quote(?) ->> '$')) END)) WHEN s2.t0 IN ('integer', 'float') AND s2.t1 IN ('integer', 'float') THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT (((n0."properties" -> ('$."' || ? || '"')) ->> '$') + (json_quote(?) ->> '$')) AS f))) WHEN s2.t0 = 'string' AND s2.t1 = 'string' THEN json_quote((((n0."properties" -> ('$."' || ? || '"')) ->> '$') || (json_quote(?) ->> '$'))) WHEN (s2.t0 = 'string' AND s2.t1 IN ('integer', 'float', 'boolean')) OR (s2.t0 IN ('integer', 'float', 'boolean') AND s2.t1 = 'string') THEN json_quote(((CASE s2.t0 WHEN 'string' THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') WHEN 'integer' THEN CAST(((n0."properties" -> ('$."' || ? || '"')) ->> '$') AS TEXT) WHEN 'float' THEN (SELECT CASE WHEN f IS NULL THEN NULL WHEN abs(f) > 1.7976931348623157e308 THEN (CASE WHEN f > 0 THEN 'Infinity' ELSE '-Infinity' END) ELSE (CASE WHEN digits = '' THEN sign || '0.0' WHEN exponent >= 7 OR exponent < -3 THEN sign || substr(digits, 1, 1) || '.' || (CASE WHEN length(digits) > 1 THEN substr(digits, 2) ELSE '0' END) || 'E' || exponent WHEN exponent >= 0 THEN sign || substr(digits || '0000000', 1, exponent + 1) || '.' || (CASE WHEN length(digits) > exponent + 1 THEN substr(digits, exponent + 2) ELSE '0' END) ELSE sign || '0.' || substr('00', 1, -exponent - 1) || digits END) END FROM (SELECT f, CASE WHEN substr(printf('%e', f), 1, 1) = '-' THEN '-' ELSE '' END AS sign, rtrim(replace(substr(x, 1, instr(x, 'e') - 1), '.', ''), '0') AS digits, CAST(substr(x, instr(x, 'e') + 1) AS INTEGER) AS exponent FROM (SELECT f, CASE WHEN CAST(printf('%!.14e', abs(f)) AS REAL) = abs(f) THEN printf('%!.14e', abs(f)) WHEN CAST(printf('%!.15e', abs(f)) AS REAL) = abs(f) THEN printf('%!.15e', abs(f)) ELSE printf('%!.16e', abs(f)) END AS x FROM (SELECT ((n0."properties" -> ('$."' || ? || '"')) ->> '$') AS f)))) WHEN 'boolean' THEN (CASE WHEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') THEN 'true' WHEN NOT ((n0."properties" -> ('$."' || ? || '"')) ->> '$') THEN 'false' END) END) || (CASE s2.t1 WHEN 'string' THEN (json_quote(?) ->> '$') WHEN 'integer' THEN CAST((json_quote(?) ->> '$') AS TEXT) WHEN 'float' THEN (SELECT CASE WHEN f IS NULL THEN NULL WHEN abs(f) > 1.7976931348623157e308 THEN (CASE WHEN f > 0 THEN 'Infinity' ELSE '-Infinity' END) ELSE (CASE WHEN digits = '' THEN sign || '0.0' WHEN exponent >= 7 OR exponent < -3 THEN sign || substr(digits, 1, 1) || '.' || (CASE WHEN length(digits) > 1 THEN substr(digits, 2) ELSE '0' END) || 'E' || exponent WHEN exponent >= 0 THEN sign || substr(digits || '0000000', 1, exponent + 1) || '.' || (CASE WHEN length(digits) > exponent + 1 THEN substr(digits, exponent + 2) ELSE '0' END) ELSE sign || '0.' || substr('00', 1, -exponent - 1) || digits END) END FROM (SELECT f, CASE WHEN substr(printf('%e', f), 1, 1) = '-' THEN '-' ELSE '' END AS sign, rtrim(replace(substr(x, 1, instr(x, 'e') - 1), '.', ''), '0') AS digits, CAST(substr(x, instr(x, 'e') + 1) AS INTEGER) AS exponent FROM (SELECT f, CASE WHEN CAST(printf('%!.14e', abs(f)) AS REAL) = abs(f) THEN printf('%!.14e', abs(f)) WHEN CAST(printf('%!.15e', abs(f)) AS REAL) = abs(f) THEN printf('%!.15e', abs(f)) ELSE printf('%!.16e', abs(f)) END AS x FROM (SELECT (json_quote(?) ->> '$') AS f)))) WHEN 'boolean' THEN (CASE WHEN (json_quote(?) ->> '$') THEN 'true' WHEN NOT (json_quote(?) ->> '$') THEN 'false' END) END))) WHEN s2.t0 = 'list' OR s2.t1 = 'list' THEN (SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each((CASE WHEN s2.t0 = 'list' THEN (n0."properties" -> ('$."' || ? || '"')) ELSE json_array(json((n0."properties" -> ('$."' || ? || '"')))) END)) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN s2.t1 = 'list' THEN json_quote(?) ELSE json_array(json(json_quote(?))) END)) AS b ORDER BY side, k)) ELSE json_extract('{}', '!cypher:1' || substr(random(), 1, 0)) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(json_quote(?)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(json_quote(?), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s2) AS c1 FROM "nodes" AS n0 WHERE ((SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') > ?) ELSE NULL END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) AND (SELECT (CASE WHEN s1.t0 = 'string' AND s1.t1 = 'string' THEN (substr(((n0."properties" -> ('$."' || ? || '"')) ->> '$'), 1, length((? ->> '$'))) = (? ->> '$')) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(?) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(?, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s1)) LIMIT ?
-- values: "name", "age", "1", "age", "1", "age", "1", "age", "1", "age", "age", "age", "age", "age", "1", "1", "1", "1", "1", "age", "age", "1", "1", "age", "age", "1", "1", "30", "age", "30", "age", "age", "name", $p, $p, "name", "name", $p, $p, limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) WHERE toLower(n.name) STARTS WITH 'a' RETURN size(labels(n)), coalesce(n.x, 0), range(1, $n) 1`] = `
"MATCH (n) WHERE toLower(n.name) STARTS WITH 'a' RETURN size(labels(n)), coalesce(n.x, 0), range(1, $n)
-- step 1
SELECT (SELECT json_array_length(s2.v0) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT n0."labels" AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s2) AS c0, (SELECT COALESCE(CASE WHEN s3.t0 <> 'null' THEN (n0."properties" -> ('$."' || ? || '"')) END, CASE WHEN s3.t1 <> 'null' THEN json_quote(?) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(json_quote(?)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(json_quote(?), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s3) AS c1, (SELECT (CASE WHEN (s4.t1 IS NULL OR s4.t1 = 'null') THEN NULL WHEN s4.t1 IN ('integer') THEN (WITH RECURSIVE rg(v) AS (SELECT ? UNION ALL SELECT v + 1 FROM rg WHERE (1 > 0 AND v + 1 <= (? ->> '$')) OR (1 < 0 AND v + 1 >= (? ->> '$'))) SELECT json_group_array(v) FROM rg WHERE (1 > 0 AND v <= (? ->> '$')) OR (1 < 0 AND v >= (? ->> '$'))) ELSE json_extract('{}', '!cypher:1' || substr(random(), 1, 0)) END) FROM (SELECT (CASE json_type(?) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(?, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s4) AS c2 FROM "nodes" AS n0 WHERE (SELECT (substr(s1.v0, 1, length(?)) = ?) FROM (SELECT x.v0 AS v0 FROM (SELECT (SELECT (CASE WHEN (s0.t0 IS NULL OR s0.t0 = 'null') THEN NULL WHEN s0.t0 IN ('string') THEN lower(((n0."properties" -> ('$."' || ? || '"')) ->> '$')) ELSE json_extract('{}', '!cypher:0' || substr(random(), 1, 0)) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s1) LIMIT ?
-- values: "x", "0", "x", "x", "0", "0", "1", $n, $n, $n, $n, $n, $n, "a", "a", "name", "name", "name", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) WITH n, count(*) AS c WHERE c > 1 MATCH (n)-->(m) RETURN m.name ORDER BY m.name 1`] = `
"MATCH (n) WITH n, count(*) AS c WHERE c > 1 MATCH (n)-->(m) RETURN m.name ORDER BY m.name
-- step 1
SELECT (n2."properties" -> ('$."' || ? || '"')) AS c0 FROM (SELECT g.g0_id AS c0, g.x0 AS c1 FROM (SELECT n0."id" AS g0_id, n0."labels" AS g0_labels, n0."properties" AS g0_properties, COUNT(*) AS x0 FROM "nodes" AS n0 GROUP BY n0."id", n0."labels", n0."properties") AS g) AS w0 LEFT JOIN "nodes" AS n1 ON n1."id" = w0.c0 JOIN "nodes" AS n2 ON 1 JOIN "edges" AS e3 ON 1 WHERE (w0.c1 > ?) AND e3."start_id" = n1."id" AND e3."end_id" = n2."id" ORDER BY (CASE (CASE json_type((n2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'datetime' THEN 6 WHEN 'localdatetime' THEN 7 WHEN 'date' THEN 8 WHEN 'time' THEN 9 WHEN 'localtime' THEN 10 WHEN 'duration' THEN 11 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) ASC, (CASE WHEN (CASE json_type((n2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN (((n2."properties" -> ('$."' || ? || '"')) -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((n2."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN ((n2."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((n2."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) = 'list' THEN (SELECT COALESCE(group_concat((CASE WHEN lkv.t IN ('integer', 'float') THEN 'I' || (SELECT CASE WHEN f = 0 THEN 'M' WHEN f > 1.7976931348623157e308 THEN 'O' WHEN f < -1.7976931348623157e308 THEN 'K' WHEN f > 0 THEN 'N' || printf('%03d', e + 400) || printf('%.15f', abs(f) / pow(10, e)) ELSE 'L' || printf('%03d', 599 - e) || printf('%.15f', 10 - abs(f) / pow(10, e)) END FROM (SELECT f, max(CASE WHEN abs(f) / pow(10, e0) >= 10 THEN e0 + 1 WHEN abs(f) / pow(10, e0) < 1 THEN e0 - 1 ELSE e0 END, -300) AS e FROM (SELECT f, max(CAST(floor(log10(CASE WHEN f = 0 OR abs(f) > 1.7976931348623157e308 THEN 1 ELSE abs(f) END)) AS INTEGER), -300) AS e0 FROM (SELECT ((lkv.v ->> '$')) AS f)))) WHEN lkv.t = 'string' THEN 'G' || (replace((lkv.v ->> '$'), char(1), char(1, 2)) || char(1, 1)) WHEN lkv.t = 'boolean' THEN 'H' || (CASE WHEN (lkv.v ->> '$') THEN '1' ELSE '0' END) WHEN lkv.t = 'null' THEN 'J' ELSE (CASE lkv.t WHEN 'map' THEN 'B' WHEN 'node' THEN 'C' WHEN 'relationship' THEN 'D' WHEN 'list' THEN 'E' ELSE 'F' END) || (replace(lkv.v, char(1), char(1, 2)) || char(1, 1)) END), '' ORDER BY lkv.o), '') || 'A' FROM (SELECT (CASE lk0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lk0.value WHEN 'object' THEN lk0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lk0.value AS f))) ELSE json_quote(lk0.value) END) AS v, (CASE json_type((CASE lk0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lk0.value WHEN 'object' THEN lk0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lk0.value AS f))) ELSE json_quote(lk0.value) END)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((CASE lk0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lk0.value WHEN 'object' THEN lk0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lk0.value AS f))) ELSE json_quote(lk0.value) END), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t, lk0.key AS o FROM json_each((n2."properties" -> ('$."' || ? || '"'))) AS lk0 WHERE NOT (lk0.key IS NULL AND lk0.type = 'null')) AS lkv) WHEN (CASE json_type((n2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('map', 'node', 'relationship', 'path') THEN (n2."properties" -> ('$."' || ? || '"')) END) ASC LIMIT ?
-- values: "name", "1", "name", "name", "name", "name", "name", "~k", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n)-->(m) RETURN n, collect(DISTINCT m.name), avg(m.age) 1`] = `
"MATCH (n)-->(m) RETURN n, collect(DISTINCT m.name), avg(m.age)
-- step 1
SELECT g.g0_id AS c0_id, g.g0_labels AS c0_labels, g.g0_properties AS c0_props, g.x0 AS c1, g.x1 AS c2 FROM (SELECT n0."id" AS g0_id, n0."labels" AS g0_labels, n0."properties" AS g0_properties, json_group_array(DISTINCT json((n1."properties" -> ('$."' || ? || '"')))) FILTER (WHERE NOT (COALESCE(json_type((n1."properties" -> ('$."' || ? || '"'))), 'null') = 'null')) AS x0, AVG(CASE WHEN (CASE json_type((n1."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n1."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN CAST(((n1."properties" -> ('$."' || ? || '"')) ->> '$') AS REAL) END) AS x1 FROM "nodes" AS n0 JOIN "nodes" AS n1 ON 1 JOIN "edges" AS e2 ON 1 WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id" GROUP BY n0."id", n0."labels", n0."properties") AS g LIMIT ?
-- values: "name", "name", "age", "age", "age", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n:Person:Admin) RETURN n.name AS name, n 1`] = `
"MATCH (n:Person:Admin) RETURN n.name AS name, n
-- step 1
SELECT (n0."properties" -> ('$."' || ? || '"')) AS c0, n0."id" AS c1_id, n0."labels" AS c1_labels, n0."properties" AS c1_props FROM "nodes" AS n0 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) LIMIT ?
-- values: "name", "Person", "Admin", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (p) OPTIONAL MATCH (p)-[r:R]->(q) WHERE r.w > 1 RETURN p, q 1`] = `
"MATCH (p) OPTIONAL MATCH (p)-[r:R]->(q) WHERE r.w > 1 RETURN p, q
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props, n1."id" AS c1_id, n1."labels" AS c1_labels, n1."properties" AS c1_props FROM "nodes" AS n0 LEFT JOIN ("nodes" AS n1 JOIN "edges" AS e2 ON 1) ON e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND e2."type" = ? AND (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((e2."properties" -> ('$."' || ? || '"')) ->> '$') > ?) ELSE NULL END) FROM (SELECT (CASE json_type((e2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((e2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) LIMIT ?
-- values: "R", "1", "w", "1", "w", "w", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH p = (a)-[r]->(b)-[*1..2]->(c) RETURN p, length(p), nodes(p) 1`] = `
"MATCH p = (a)-[r]->(b)-[*1..2]->(c) RETURN p, length(p), nodes(p)
-- step 1
SELECT (CASE WHEN n0."id" IS NULL OR e2."id" IS NULL OR n1."id" IS NULL OR v4.path IS NULL THEN NULL ELSE json_object('~cypher', 'path', '~nodes', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(n0."properties", json_object('~cypher', 'node', '~id', n0."id", '~labels', json(n0."labels")))), json(json_patch(n1."properties", json_object('~cypher', 'node', '~id', n1."id", '~labels', json(n1."labels")))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v4.nodes IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'node', '~id', ve."id", '~labels', json(ve."labels")))) ORDER BY vj.key) FROM json_each(v4.nodes) AS vj JOIN "nodes" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k))), '~relationships', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(e2."properties", json_object('~cypher', 'relationship', '~id', e2."id", '~type', e2."type", '~start', e2."start_id", '~end', e2."end_id"))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v4.path IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'relationship', '~id', ve."id", '~type', ve."type", '~start', ve."start_id", '~end', ve."end_id"))) ORDER BY vj.key) FROM json_each(v4.path) AS vj JOIN "edges" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k)))) END) AS c0, (SELECT json_array_length((s0.v0 -> ('$."' || ? || '"'))) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT (CASE WHEN n0."id" IS NULL OR e2."id" IS NULL OR n1."id" IS NULL OR v4.path IS NULL THEN NULL ELSE json_object('~cypher', 'path', '~nodes', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(n0."properties", json_object('~cypher', 'node', '~id', n0."id", '~labels', json(n0."labels")))), json(json_patch(n1."properties", json_object('~cypher', 'node', '~id', n1."id", '~labels', json(n1."labels")))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v4.nodes IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'node', '~id', ve."id", '~labels', json(ve."labels")))) ORDER BY vj.key) FROM json_each(v4.nodes) AS vj JOIN "nodes" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k))), '~relationships', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(e2."properties", json_object('~cypher', 'relationship', '~id', e2."id", '~type', e2."type", '~start', e2."start_id", '~end', e2."end_id"))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v4.path IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'relationship', '~id', ve."id", '~type', ve."type", '~start', ve."start_id", '~end', ve."end_id"))) ORDER BY vj.key) FROM json_each(v4.path) AS vj JOIN "edges" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k)))) END) AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s0) AS c1, (SELECT (s1.v0 -> ('$."' || ? || '"')) FROM (SELECT x.v0 AS v0, (CASE json_type(x.v0) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(x.v0, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 FROM (SELECT (CASE WHEN n0."id" IS NULL OR e2."id" IS NULL OR n1."id" IS NULL OR v4.path IS NULL THEN NULL ELSE json_object('~cypher', 'path', '~nodes', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(n0."properties", json_object('~cypher', 'node', '~id', n0."id", '~labels', json(n0."labels")))), json(json_patch(n1."properties", json_object('~cypher', 'node', '~id', n1."id", '~labels', json(n1."labels")))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v4.nodes IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'node', '~id', ve."id", '~labels', json(ve."labels")))) ORDER BY vj.key) FROM json_each(v4.nodes) AS vj JOIN "nodes" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k))), '~relationships', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(e2."properties", json_object('~cypher', 'relationship', '~id', e2."id", '~type', e2."type", '~start', e2."start_id", '~end', e2."end_id"))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v4.path IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'relationship', '~id', ve."id", '~type', ve."type", '~start', ve."start_id", '~end', ve."end_id"))) ORDER BY vj.key) FROM json_each(v4.path) AS vj JOIN "edges" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k)))) END) AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s1) AS c2 FROM "nodes" AS n0 JOIN "nodes" AS n1 ON 1 JOIN "edges" AS e2 ON 1 JOIN "nodes" AS n3 ON 1 JOIN (WITH RECURSIVE v4p(s, t, d, path, nodes) AS (SELECT n5."id", n5."id", 0, json_array(), json_array() FROM "nodes" AS n5 WHERE n5."id" IN (SELECT n1."id" FROM "nodes" AS n0 JOIN "nodes" AS n1 ON 1 JOIN "edges" AS e2 ON 1 WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id") UNION ALL SELECT v4p.s, e6."end_id", v4p.d + 1, json_insert(v4p.path, '$[#]', e6."id"), json_insert(v4p.nodes, '$[#]', e6."end_id") FROM v4p JOIN "edges" AS e6 ON e6."start_id" = v4p.t WHERE v4p.d < ? AND NOT EXISTS (SELECT 1 FROM json_each(v4p.path) AS vj WHERE vj.value = e6."id")) SELECT (CASE WHEN row_number() OVER () > ? THEN json_extract('{}', '!cypher:0' || substr(random(), 1, 0)) ELSE v4l.s END) AS s, v4l.t AS t, v4l.path AS path, v4l.nodes AS nodes FROM (SELECT s, t, path, nodes FROM v4p WHERE d >= 1 LIMIT ?) AS v4l) AS v4 ON 1 WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND v4.s = n1."id" AND v4.t = n3."id" AND NOT EXISTS (SELECT 1 FROM json_each(v4.path) AS vj WHERE vj.value = e2."id") LIMIT ?
-- values: "~relationships", "~nodes", depth(2), maxRowsPerStep, limit(maxRowsPerStep + 1), limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: OPTIONAL MATCH (x:Missing) RETURN x 1`] = `
"OPTIONAL MATCH (x:Missing) RETURN x
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props FROM (SELECT 1 AS one) AS one1 LEFT JOIN "nodes" AS n0 ON EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) LIMIT ?
-- values: "Missing", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: RETURN 1 AS i, 1.5 AS f, 'x' AS s, [1, null] AS l, {k: true} AS m, $p AS p 1`] = `
"RETURN 1 AS i, 1.5 AS f, 'x' AS s, [1, null] AS l, {k: true} AS m, $p AS p
-- step 1
SELECT ? AS c0, CAST(? AS REAL) AS c1, ? AS c2, ? AS c3, ? AS c4, ? AS c5 LIMIT ?
-- values: "1", 1.5, "x", [1,null], {"k":true}, $p, limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max 1`] = `
"UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max
-- step 1
SELECT (n2."properties" -> ('$."' || ? || '"')) AS c0, (CASE u1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u1.value WHEN 'object' THEN u1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT u1.value AS f))) ELSE json_quote(u1.value) END) AS c1 FROM json_each(?) AS u0 JOIN json_each((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END)) AS u1 ON 1 JOIN "nodes" AS n2 ON 1 WHERE NOT (u0.key IS NULL AND u0.type = 'null') AND NOT (u1.key IS NULL AND u1.type = 'null') AND EXISTS (SELECT 1 FROM json_each(n2."labels") WHERE json_each.value = ?) ORDER BY u0.key, u1.key, n2."id" LIMIT ?
-- values: "k", $lists, "N", limit($max)"
`;

exports[`sqlite > read: UNWIND $xs AS x WITH x ORDER BY x DESC LIMIT 3 RETURN x 1`] = `
