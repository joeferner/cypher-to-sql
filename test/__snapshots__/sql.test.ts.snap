"MATCH (n) RETURN DISTINCT n.name AS name ORDER BY name
-- step 1
SELECT * FROM (SELECT DISTINCT (n0."properties" -> ('$."' || ? || '"')) AS c0, (CASE (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'list' THEN 4 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) AS k0, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) AS k1, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) IN ('string') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) AS k2, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) AS k3, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) IN ('list', 'map') THEN (n0."properties" -> ('$."' || ? || '"')) END) AS k4 FROM "nodes" AS n0) AS d ORDER BY d.k0 ASC, d.k1 ASC, d.k2 ASC, d.k3 ASC, d.k4 ASC LIMIT ?
-- values: "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) RETURN n LIMIT 10 1`] = `
"MATCH (n) RETURN n LIMIT 10
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props FROM "nodes" AS n0 LIMIT ?
-- values: limit(10)"
`;

exports[`sqlite > read: MATCH (n) RETURN n.name AS name ORDER BY name DESC, n.age SKIP $s LIMIT 10 1`] = `
"MATCH (n) RETURN n.name AS name ORDER BY name DESC, n.age SKIP $s LIMIT 10
-- step 1
SELECT (n0."properties" -> ('$."' || ? || '"')) AS c0 FROM "nodes" AS n0 ORDER BY (CASE (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'list' THEN 4 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) IN ('string') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) IN ('list', 'map') THEN (n0."properties" -> ('$."' || ? || '"')) END) DESC, (CASE (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'list' THEN 4 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) ASC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) IN ('string') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) ASC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) IN ('list', 'map') THEN (n0."properties" -> ('$."' || ? || '"')) END) ASC LIMIT ? OFFSET ?
-- values: "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "age", "age", "age", "age", "age", "age", "age", "age", "age", limit(10), skip($s)"
`;

exports[`sqlite > read: MATCH (n) WHERE n.age > 30 AND n.name STARTS WITH $p RETURN n.name, n.age + 1 AS next 1`] = `
"MATCH (n) WHERE n.age > 30 AND n.name STARTS WITH $p RETURN n.name, n.age + 1 AS next
-- step 1
SELECT (n0."properties" -> ('$."' || ? || '"')) AS c0, (SELECT (CASE WHEN s2.t0 = 'null' OR s2.t1 = 'null' THEN NULL WHEN s2.t0 = 'integer' AND s2.t1 = 'integer' THEN json_quote((((n0."properties" -> ('$."' || ? || '"')) ->> '$') + (json_quote(?) ->> '$'))) WHEN s2.t0 IN ('integer', 'float') AND s2.t1 IN ('integer', 'float') THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT (((n0."properties" -> ('$."' || ? || '"')) ->> '$') + (json_quote(?) ->> '$')) AS f))) WHEN s2.t0 = 'string' AND s2.t1 = 'string' THEN json_quote((((n0."properties" -> ('$."' || ? || '"')) ->> '$') || (json_quote(?) ->> '$'))) WHEN s2.t0 = 'list' OR s2.t1 = 'list' THEN (SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each((CASE WHEN s2.t0 = 'list' THEN (n0."properties" -> ('$."' || ? || '"')) ELSE json_array(json((n0."properties" -> ('$."' || ? || '"')))) END)) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN s2.t1 = 'list' THEN json_quote(?) ELSE json_array(json(json_quote(?))) END)) AS b ORDER BY side, k)) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(json_quote(?)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s2) AS c1 FROM "nodes" AS n0 WHERE ((SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') > ?) ELSE NULL END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) AND (SELECT (CASE WHEN s1.t0 = 'string' AND s1.t1 = 'string' THEN (substr(((n0."properties" -> ('$."' || ? || '"')) ->> '$'), 1, length((? ->> '$'))) = (? ->> '$')) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(?) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN 'map' WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s1)) LIMIT ?
-- values: "name", "age", "1", "age", "1", "age", "1", "age", "age", "1", "1", "age", "1", "30", "age", "30", "age", "name", $p, $p, "name", $p, limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n:Person:Admin) RETURN n.name AS name, n 1`] = `
"MATCH (n:Person:Admin) RETURN n.name AS name, n
-- step 1
SELECT (n0."properties" -> ('$."' || ? || '"')) AS c0, n0."id" AS c1_id, n0."labels" AS c1_labels, n0."properties" AS c1_props FROM "nodes" AS n0 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) LIMIT ?
-- values: "name", "Person", "Admin", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: RETURN 1 AS i, 1.5 AS f, 'x' AS s, [1, null] AS l, {k: true} AS m, $p AS p 1`] = `
"RETURN 1 AS i, 1.5 AS f, 'x' AS s, [1, null] AS l, {k: true} AS m, $p AS p
-- step 1
SELECT ? AS c0, CAST(? AS REAL) AS c1, ? AS c2, ? AS c3, ? AS c4, ? AS c5 LIMIT ?
-- values: "1", 1.5, "x", [1,null], {"k":true}, $p, limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max 1`] = `
"UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max
-- step 1
SELECT (n2."properties" -> ('$."' || ? || '"')) AS c0, (CASE u1.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u1.value WHEN 'object' THEN u1.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u1.value AS f))) ELSE json_quote(u1.value) END) AS c1 FROM json_each(?) AS u0 CROSS JOIN json_each((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END)) AS u1 CROSS JOIN "nodes" AS n2 WHERE NOT (u0.key IS NULL AND u0.type = 'null') AND NOT (u1.key IS NULL AND u1.type = 'null') AND EXISTS (SELECT 1 FROM json_each(n2."labels") WHERE json_each.value = ?) ORDER BY u0.key, u1.key, n2."id" LIMIT ?
-- values: "k", $lists, "N", limit($max)"
`;

exports[`sqlite > read: UNWIND [{a: {b: 1}}] AS m RETURN m.a.b 1`] = `
"UNWIND [{a: {b: 1}}] AS m RETURN m.a.b
-- step 1
SELECT (((CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END) -> ('$."' || ? || '"')) -> ('$."' || ? || '"')) AS c0 FROM json_each(?) AS u0 WHERE NOT (u0.key IS NULL AND u0.type = 'null') ORDER BY u0.key LIMIT ?
-- values: "a", "b", [{"a":{"b":1}}], limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: UNWIND [1, 2] AS x RETURN x 1`] = `
"UNWIND [1, 2] AS x RETURN x
-- step 1
SELECT (CASE u0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN u0.value WHEN 'object' THEN u0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%.15g', f) AS REAL) = f THEN printf('%.15g', f) WHEN CAST(printf('%.16g', f) AS REAL) = f THEN printf('%.16g', f) ELSE printf('%.17g', f) END END AS s FROM (SELECT u0.value AS f))) ELSE json_quote(u0.value) END) AS c0 FROM json_each(?) AS u0 WHERE NOT (u0.key IS NULL AND u0.type = 'null') ORDER BY u0.key LIMIT ?
-- values: [1,2], limit(maxRowsPerStep + 1)"
`;
