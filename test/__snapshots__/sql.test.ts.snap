exports[`postgres > read: UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max 1`] = `
"UNWIND $lists AS l UNWIND l AS x MATCH (n:N) RETURN n.k, x LIMIT $max
-- step 1
SELECT ((n2."properties" -> $1::text))::text AS c0, (u1.value)::text AS c1 FROM LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof(($2::jsonb)) = 'array' THEN ($3::jsonb) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT ($4::jsonb), 1 WHERE jsonb_typeof(($5::jsonb)) NOT IN ('array', 'null')) AS u0 CROSS JOIN LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof(u0.value) = 'array' THEN u0.value END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT u0.value, 1 WHERE jsonb_typeof(u0.value) NOT IN ('array', 'null')) AS u1 CROSS JOIN "nodes" AS n2 WHERE (n2."labels" @> jsonb_build_array($6::text)) ORDER BY u0.ord, u1.ord, n2."id" LIMIT $7
-- values: "k", $lists, $lists, $lists, $lists, "N", limit($max)"
`;

