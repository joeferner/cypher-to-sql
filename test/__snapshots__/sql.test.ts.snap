`;

exports[`sqlite > read: MATCH (a)<-[:T|U]-(b)-[r]-(c) RETURN r.w 1`] = `
"MATCH (a)<-[:T|U]-(b)-[r]-(c) RETURN r.w
-- step 1
SELECT (e4."properties" -> ('$."' || ? || '"')) AS c0 FROM "nodes" AS n0 JOIN "nodes" AS n1 ON 1 JOIN "edges" AS e2 ON 1 JOIN "nodes" AS n3 ON 1 JOIN "edges" AS e4 ON 1 WHERE e2."start_id" = n1."id" AND e2."end_id" = n0."id" AND e2."type" IN (?, ?) AND ((e4."start_id" = n1."id" AND e4."end_id" = n3."id") OR (e4."start_id" = n3."id" AND e4."end_id" = n1."id")) AND e2."id" <> e4."id" LIMIT ?
-- values: "w", "T", "U", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a)-[*]-(b), (b)<-[*0..2]-(c) RETURN count(*) 1`] = `
"MATCH (a)-[*]-(b), (b)<-[*0..2]-(c) RETURN count(*)
-- step 1
SELECT g.x0 AS c0 FROM (SELECT COUNT(*) AS x0 FROM "nodes" AS n0 JOIN "nodes" AS n1 ON 1 JOIN (WITH RECURSIVE v2p(s, t, d, path) AS (SELECT n3."id", n3."id", 0, json_array() FROM "nodes" AS n3 UNION ALL SELECT v2p.s, CASE WHEN e4."start_id" = v2p.t THEN e4."end_id" ELSE e4."start_id" END, v2p.d + 1, json_insert(v2p.path, '$[#]', e4."id") FROM v2p JOIN "edges" AS e4 ON (e4."start_id" = v2p.t OR e4."end_id" = v2p.t) WHERE v2p.d < ? AND NOT EXISTS (SELECT 1 FROM json_each(v2p.path) AS vj WHERE vj.value = e4."id")) SELECT (CASE WHEN row_number() OVER () > ? THEN json_extract('{}', '!cypher:0' || substr(random(), 1, 0)) ELSE v2l.s END) AS s, v2l.t AS t, v2l.path AS path FROM (SELECT s, t, path FROM v2p WHERE d >= 1 LIMIT ?) AS v2l) AS v2 ON 1 JOIN "nodes" AS n5 ON 1 JOIN (WITH RECURSIVE v6p(s, t, d, path) AS (SELECT n7."id", n7."id", 0, json_array() FROM "nodes" AS n7 UNION ALL SELECT v6p.s, e8."start_id", v6p.d + 1, json_insert(v6p.path, '$[#]', e8."id") FROM v6p JOIN "edges" AS e8 ON e8."end_id" = v6p.t WHERE v6p.d < ? AND NOT EXISTS (SELECT 1 FROM json_each(v6p.path) AS vj WHERE vj.value = e8."id")) SELECT (CASE WHEN row_number() OVER () > ? THEN json_extract('{}', '!cypher:1' || substr(random(), 1, 0)) ELSE v6l.s END) AS s, v6l.t AS t, v6l.path AS path FROM (SELECT s, t, path FROM v6p WHERE d >= 0 LIMIT ?) AS v6l) AS v6 ON 1 WHERE v2.s = n0."id" AND v2.t = n1."id" AND v6.s = n1."id" AND v6.t = n5."id" AND NOT EXISTS (SELECT 1 FROM json_each(v2.path) AS vl JOIN json_each(v6.path) AS vr ON vl.value = vr.value)) AS g LIMIT ?
-- values: maxPathDepth, maxRowsPerStep, limit(maxRowsPerStep + 1), depth(2), maxRowsPerStep, limit(maxRowsPerStep + 1), limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a)-[r]->(b) MATCH (b)-[r2]->(c), (c)-[r]->(a) RETURN r2 1`] = `
"MATCH (a)-[r]->(b) MATCH (b)-[r2]->(c), (c)-[r]->(a) RETURN r2
-- step 1
SELECT e4."id" AS c0_id, e4."type" AS c0_type, e4."start_id" AS c0_start, e4."end_id" AS c0_end, e4."properties" AS c0_props FROM "nodes" AS n0 JOIN "nodes" AS n1 ON 1 JOIN "edges" AS e2 ON 1 JOIN "nodes" AS n3 ON 1 JOIN "edges" AS e4 ON 1 WHERE e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND e4."start_id" = n1."id" AND e4."end_id" = n3."id" AND e2."start_id" = n3."id" AND e2."end_id" = n0."id" AND e4."id" <> e2."id" LIMIT ?
-- values: limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a:A {k: 1}), (b:B) MATCH p = shortestPath((a)-[:T* {w: 1}]->(b)) RETURN p 1`] = `
"MATCH (a:A {k: 1}), (b:B) MATCH p = shortestPath((a)-[:T* {w: 1}]->(b)) RETURN p
-- step 1 (node pairs of shortest path search 1)
SELECT DISTINCT n0."id" AS s, n1."id" AS t FROM "nodes" AS n0 JOIN "nodes" AS n1 ON 1 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND likelihood((SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') = ?) ELSE 0 END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0), 0.001) AND EXISTS (SELECT 1 FROM json_each(n1."labels") WHERE json_each.value = ?) LIMIT ?
-- values: "A", "1", "k", "1", "k", "k", "B", limit(maxRowsPerStep + 1)
-- search 1: breadth-first, one step per depth (one shortest path per pair, depth 1..maxPathDepth)
SELECT f, r, t FROM (SELECT e2."start_id" AS f, e2."id" AS r, e2."end_id" AS t FROM "edges" AS e2 WHERE e2."start_id" IN (SELECT value FROM json_each(?)) AND e2."type" = ? AND likelihood((SELECT (CASE WHEN s1.t0 IS NULL OR s1.t0 = 'null' OR ? IS NULL THEN NULL WHEN s1.t0 IN ('integer', 'float') THEN (((e2."properties" -> ('$."' || ? || '"')) ->> '$') = ?) ELSE 0 END) FROM (SELECT (CASE json_type((e2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((e2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s1), 0.001)) AS x ORDER BY r, f LIMIT ?
-- values: frontier, "T", "1", "w", "1", "w", "w", limit(maxRowsPerStep + 1)
-- step 2
SELECT (CASE WHEN n0."id" IS NULL OR v3.path IS NULL THEN NULL ELSE json_object('~cypher', 'path', '~nodes', json((SELECT json_group_array(json(v)) FROM (SELECT (CASE a.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN a.value WHEN 'object' THEN a.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT a.value AS f))) ELSE json_quote(a.value) END) AS v, 0 AS side, a.key AS k FROM json_each(json_array(json(json_patch(n0."properties", json_object('~cypher', 'node', '~id', n0."id", '~labels', json(n0."labels")))))) AS a UNION ALL SELECT (CASE b.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN b.value WHEN 'object' THEN b.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT b.value AS f))) ELSE json_quote(b.value) END), 1, b.key FROM json_each((CASE WHEN v3.nodes IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'node', '~id', ve."id", '~labels', json(ve."labels")))) ORDER BY vj.key) FROM json_each(v3.nodes) AS vj JOIN "nodes" AS ve ON ve."id" = vj.value) END)) AS b ORDER BY side, k))), '~relationships', json((CASE WHEN v3.path IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'relationship', '~id', ve."id", '~type', ve."type", '~start', ve."start_id", '~end', ve."end_id"))) ORDER BY vj.key) FROM json_each(v3.path) AS vj JOIN "edges" AS ve ON ve."id" = vj.value) END))) END) AS c0 FROM "nodes" AS n0 JOIN "nodes" AS n1 ON 1 JOIN (SELECT j.value ->> '$.s' AS s, j.value ->> '$.t' AS t, j.value -> '$.r' AS path, j.value -> '$.n' AS nodes FROM json_each(?) AS j) AS v3 ON 1 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND likelihood((SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') = ?) ELSE 0 END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0), 0.001) AND EXISTS (SELECT 1 FROM json_each(n1."labels") WHERE json_each.value = ?) AND v3.s = n0."id" AND v3.t = n1."id" LIMIT ?
-- values: shortestPaths(search 1), "A", "1", "k", "1", "k", "k", "B", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a:A {k: 1})-[r:T {w: $w}]->(b) RETURN a, r, b 1`] = `
"MATCH (a:A {k: 1})-[r:T {w: $w}]->(b) RETURN a, r, b
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props, e2."id" AS c1_id, e2."type" AS c1_type, e2."start_id" AS c1_start, e2."end_id" AS c1_end, e2."properties" AS c1_props, n1."id" AS c2_id, n1."labels" AS c2_labels, n1."properties" AS c2_props FROM "nodes" AS n0 JOIN "nodes" AS n1 ON 1 JOIN "edges" AS e2 ON 1 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND likelihood((SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') = ?) ELSE 0 END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0), 0.001) AND e2."start_id" = n0."id" AND e2."end_id" = n1."id" AND e2."type" = ? AND likelihood((SELECT (CASE WHEN s1.t0 IS NULL OR s1.t0 = 'null' OR s1.t1 IS NULL OR s1.t1 = 'null' THEN NULL WHEN s1.t0 IN ('integer', 'float') AND s1.t1 IN ('integer', 'float') THEN ((e2."properties" -> ('$."' || ? || '"')) ->> '$') = (? ->> '$') WHEN s1.t0 <> s1.t1 THEN 0 WHEN s1.t0 IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN ((((e2."properties" -> ('$."' || ? || '"')) -> ('$."' || ? || '"')) ->> '$') = ((? -> ('$."' || ? || '"')) ->> '$')) WHEN s1.t0 = 'string' THEN (((e2."properties" -> ('$."' || ? || '"')) ->> '$') = (? ->> '$')) WHEN s1.t0 = 'boolean' THEN (((e2."properties" -> ('$."' || ? || '"')) ->> '$') = (? ->> '$')) ELSE (WITH RECURSIVE w(a, at, b, bt) AS (SELECT CASE WHEN json_type((e2."properties" -> ('$."' || ? || '"'))) IN ('array', 'object') THEN (e2."properties" -> ('$."' || ? || '"')) ELSE (e2."properties" -> ('$."' || ? || '"')) ->> '$' END, json_type((e2."properties" -> ('$."' || ? || '"'))), CASE WHEN json_type(?) IN ('array', 'object') THEN ? ELSE ? ->> '$' END, json_type(?) UNION ALL SELECT x.value, x.type, y.value, y.type FROM w, json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.a END) AS x JOIN json_each(CASE WHEN w.at IN ('array', 'object') AND w.at = w.bt THEN w.b END) AS y ON x.key = y.key) SELECT CASE WHEN SUM(r = 0) > 0 THEN 0 WHEN SUM(r IS NULL) > 0 THEN NULL ELSE 1 END FROM (SELECT CASE WHEN COALESCE(at, 'null') = 'null' OR COALESCE(bt, 'null') = 'null' THEN NULL WHEN CASE at WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE at END <> CASE bt WHEN 'integer' THEN 'number' WHEN 'real' THEN 'number' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' ELSE bt END THEN 0 WHEN at = 'array' THEN json_array_length(a) = json_array_length(b) WHEN at = 'object' THEN (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(a) ORDER BY key)) IS (SELECT group_concat(key, char(0)) FROM (SELECT key FROM json_each(b) ORDER BY key)) WHEN at IN ('true', 'false') THEN at = bt ELSE a = b END AS r FROM w)) END) FROM (SELECT (CASE json_type((e2."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((e2."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(?) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(?, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s1), 0.001) LIMIT ?
-- values: "A", "1", "k", "1", "k", "k", "T", "w", $w, "w", "~k", $w, "~k", "w", $w, "w", $w, "w", "w", "w", "w", $w, $w, $w, $w, "w", "w", $w, $w, limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a:A), (b) RETURN * 1`] = `
"MATCH (a:A), (b) RETURN *
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props, n1."id" AS c1_id, n1."labels" AS c1_labels, n1."properties" AS c1_props FROM "nodes" AS n0 JOIN "nodes" AS n1 ON 1 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) LIMIT ?
-- values: "A", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (a:A)-[r:T*1..3 {k: 1}]->(b)-[s]-(c) RETURN r, b 1`] = `
"MATCH (a:A)-[r:T*1..3 {k: 1}]->(b)-[s]-(c) RETURN r, b
-- step 1
SELECT (CASE WHEN v2.path IS NULL THEN NULL ELSE (SELECT json_group_array(json(json_patch(ve."properties", json_object('~cypher', 'relationship', '~id', ve."id", '~type', ve."type", '~start', ve."start_id", '~end', ve."end_id"))) ORDER BY vj.key) FROM json_each(v2.path) AS vj JOIN "edges" AS ve ON ve."id" = vj.value) END) AS c0, n1."id" AS c1_id, n1."labels" AS c1_labels, n1."properties" AS c1_props FROM "nodes" AS n0 JOIN "nodes" AS n1 ON 1 JOIN (WITH RECURSIVE v2p(s, t, d, path) AS (SELECT n3."id", n3."id", 0, json_array() FROM "nodes" AS n3 WHERE n3."id" IN (SELECT n0."id" FROM "nodes" AS n0 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?)) UNION ALL SELECT v2p.s, e4."end_id", v2p.d + 1, json_insert(v2p.path, '$[#]', e4."id") FROM v2p JOIN "edges" AS e4 ON e4."start_id" = v2p.t WHERE v2p.d < ? AND NOT EXISTS (SELECT 1 FROM json_each(v2p.path) AS vj WHERE vj.value = e4."id") AND e4."type" = ? AND likelihood((SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ? IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN (((e4."properties" -> ('$."' || ? || '"')) ->> '$') = ?) ELSE 0 END) FROM (SELECT (CASE json_type((e4."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((e4."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0), 0.001)) SELECT (CASE WHEN row_number() OVER () > ? THEN json_extract('{}', '!cypher:0' || substr(random(), 1, 0)) ELSE v2l.s END) AS s, v2l.t AS t, v2l.path AS path FROM (SELECT s, t, path FROM v2p WHERE d >= 1 LIMIT ?) AS v2l) AS v2 ON 1 JOIN "nodes" AS n5 ON 1 JOIN "edges" AS e6 ON 1 WHERE EXISTS (SELECT 1 FROM json_each(n0."labels") WHERE json_each.value = ?) AND v2.s = n0."id" AND v2.t = n1."id" AND ((e6."start_id" = n1."id" AND e6."end_id" = n5."id") OR (e6."start_id" = n5."id" AND e6."end_id" = n1."id")) AND NOT EXISTS (SELECT 1 FROM json_each(v2.path) AS vj WHERE vj.value = e6."id") LIMIT ?
-- values: "A", depth(3), "T", "1", "k", "1", "k", "k", maxRowsPerStep, limit(maxRowsPerStep + 1), "A", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) RETURN CASE n.k WHEN 1 THEN 'one' ELSE 'other' END, CASE WHEN n.k > 1 THEN n.k END 1`] = `
"MATCH (n) RETURN CASE n.k WHEN 1 THEN 'one' ELSE 'other' END, CASE WHEN n.k > 1 THEN n.k END
-- step 1
SELECT (SELECT (CASE WHEN (SELECT (CASE WHEN s1.t0 IS NULL OR s1.t0 = 'null' OR ? IS NULL THEN NULL WHEN s1.t0 IN ('integer', 'float') THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') = ?) ELSE 0 END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s1) THEN ? ELSE ? END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) AS c0, (CASE WHEN (SELECT (CASE WHEN s2.t0 IS NULL OR s2.t0 = 'null' OR ? IS NULL THEN NULL WHEN s2.t0 IN ('integer', 'float') THEN (((n0."properties" -> ('$."' || ? || '"')) ->> '$') > ?) ELSE NULL END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s2) THEN (n0."properties" -> ('$."' || ? || '"')) END) AS c1 FROM "nodes" AS n0 LIMIT ?
-- values: "1", "k", "1", "k", "k", "one", "other", "k", "k", "1", "k", "1", "k", "k", "k", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) RETURN DISTINCT n.name AS name ORDER BY name 1`] = `
"MATCH (n) RETURN DISTINCT n.name AS name ORDER BY name
-- step 1
SELECT * FROM (SELECT DISTINCT (n0."properties" -> ('$."' || ? || '"')) AS c0, (CASE (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'datetime' THEN 6 WHEN 'localdatetime' THEN 7 WHEN 'date' THEN 8 WHEN 'time' THEN 9 WHEN 'localtime' THEN 10 WHEN 'duration' THEN 11 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) AS k0, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN (((n0."properties" -> ('$."' || ? || '"')) -> ('$."' || ? || '"')) ->> '$') END) AS k1, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) AS k2, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) AS k3, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) AS k4, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) = 'list' THEN (SELECT COALESCE(group_concat((CASE WHEN lkv.t IN ('integer', 'float') THEN 'I' || (SELECT CASE WHEN f = 0 THEN 'M' WHEN f > 1.7976931348623157e308 THEN 'O' WHEN f < -1.7976931348623157e308 THEN 'K' WHEN f > 0 THEN 'N' || printf('%03d', e + 400) || printf('%.15f', abs(f) / pow(10, e)) ELSE 'L' || printf('%03d', 599 - e) || printf('%.15f', 10 - abs(f) / pow(10, e)) END FROM (SELECT f, max(CASE WHEN abs(f) / pow(10, e0) >= 10 THEN e0 + 1 WHEN abs(f) / pow(10, e0) < 1 THEN e0 - 1 ELSE e0 END, -300) AS e FROM (SELECT f, max(CAST(floor(log10(CASE WHEN f = 0 OR abs(f) > 1.7976931348623157e308 THEN 1 ELSE abs(f) END)) AS INTEGER), -300) AS e0 FROM (SELECT ((lkv.v ->> '$')) AS f)))) WHEN lkv.t = 'string' THEN 'G' || (replace((lkv.v ->> '$'), char(1), char(1, 2)) || char(1, 1)) WHEN lkv.t = 'boolean' THEN 'H' || (CASE WHEN (lkv.v ->> '$') THEN '1' ELSE '0' END) WHEN lkv.t = 'null' THEN 'J' ELSE (CASE lkv.t WHEN 'map' THEN 'B' WHEN 'node' THEN 'C' WHEN 'relationship' THEN 'D' WHEN 'list' THEN 'E' ELSE 'F' END) || (replace(lkv.v, char(1), char(1, 2)) || char(1, 1)) END), '' ORDER BY lkv.o), '') || 'A' FROM (SELECT (CASE lk0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lk0.value WHEN 'object' THEN lk0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lk0.value AS f))) ELSE json_quote(lk0.value) END) AS v, (CASE json_type((CASE lk0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lk0.value WHEN 'object' THEN lk0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lk0.value AS f))) ELSE json_quote(lk0.value) END)) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((CASE lk0.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lk0.value WHEN 'object' THEN lk0.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lk0.value AS f))) ELSE json_quote(lk0.value) END), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t, lk0.key AS o FROM json_each((n0."properties" -> ('$."' || ? || '"'))) AS lk0 WHERE NOT (lk0.key IS NULL AND lk0.type = 'null')) AS lkv) WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('map', 'node', 'relationship', 'path') THEN (n0."properties" -> ('$."' || ? || '"')) END) AS k5 FROM "nodes" AS n0) AS d ORDER BY d.k0 ASC, d.k1 ASC, d.k2 ASC, d.k3 ASC, d.k4 ASC, d.k5 ASC LIMIT ?
-- values: "name", "name", "name", "name", "name", "name", "~k", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", "name", limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) RETURN n LIMIT 10 1`] = `
"MATCH (n) RETURN n LIMIT 10
-- step 1
SELECT n0."id" AS c0_id, n0."labels" AS c0_labels, n0."properties" AS c0_props FROM "nodes" AS n0 LIMIT ?
-- values: limit(10)"
`;

exports[`sqlite > read: MATCH (n) RETURN n.list[0], n.list[1..-1], n[$key], all(x IN [1, 2] WHERE x < n.max) 1`] = `
"MATCH (n) RETURN n.list[0], n.list[1..-1], n[$key], all(x IN [1, 2] WHERE x < n.max)
-- step 1
SELECT (SELECT (CASE WHEN (s0.t0 IS NULL OR s0.t0 = 'null') THEN NULL WHEN s0.t0 = 'list' THEN ((n0."properties" -> ('$."' || ? || '"')) -> ('$[' || CASE WHEN ? < 0 THEN '#' || ? ELSE ? END || ']')) WHEN s0.t0 IN ('map', 'node', 'relationship') THEN json_extract('{}', '!cypher:0' || substr(random(), 1, 0)) WHEN s0.t0 = 'list' THEN json_extract('{}', '!cypher:1' || substr(random(), 1, 0)) ELSE json_extract('{}', '!cypher:2' || substr(random(), 1, 0)) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s0) AS c0, (SELECT (CASE WHEN (s1.t0 IS NULL OR s1.t0 = 'null') THEN NULL WHEN s1.t0 <> 'list' THEN json_extract('{}', '!cypher:3' || substr(random(), 1, 0)) WHEN ? IS NULL OR ? IS NULL THEN NULL ELSE (SELECT json_group_array(json((CASE ls2.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN ls2.value WHEN 'object' THEN ls2.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT ls2.value AS f))) ELSE json_quote(ls2.value) END)) ORDER BY ls2.key) FILTER (WHERE ls2.key >= (CASE WHEN ? < 0 THEN json_array_length((n0."properties" -> ('$."' || ? || '"'))) + ? ELSE ? END) AND ls2.key < (CASE WHEN ? < 0 THEN json_array_length((n0."properties" -> ('$."' || ? || '"'))) + ? ELSE ? END)) FROM json_each((n0."properties" -> ('$."' || ? || '"'))) AS ls2 WHERE NOT (ls2.key IS NULL AND ls2.type = 'null')) END) FROM (SELECT (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s1) AS c1, (SELECT (CASE WHEN (s3.t0 IS NULL OR s3.t0 = 'null') OR (s3.t1 IS NULL OR s3.t1 = 'null') THEN NULL WHEN s3.t0 IN ('map', 'node', 'relationship') AND s3.t1 = 'string' THEN (SELECT (CASE jm.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN jm.value WHEN 'object' THEN jm.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT jm.value AS f))) ELSE json_quote(jm.value) END) FROM json_each(n0."properties") AS jm WHERE json_type(n0."properties") = 'object' AND jm.key = (? ->> '$')) WHEN s3.t0 IN ('map', 'node', 'relationship') THEN json_extract('{}', '!cypher:4' || substr(random(), 1, 0)) ELSE json_extract('{}', '!cypher:5' || substr(random(), 1, 0)) END) FROM (SELECT (CASE json_type(n0."properties") WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(n0."properties", '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0, (CASE json_type(?) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(?, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 LIMIT -1 OFFSET 0) AS s3) AS c2, (SELECT (CASE WHEN s4.t0 = 'list' THEN (SELECT (CASE WHEN SUM(CASE WHEN NOT p THEN 1 ELSE 0 END) > 0 THEN 0 WHEN SUM(CASE WHEN p IS NULL THEN 1 ELSE 0 END) > 0 THEN NULL ELSE 1 END) FROM (SELECT (SELECT (CASE WHEN s6.t1 IS NULL OR s6.t1 = 'null' OR s6.v0 IS NULL THEN NULL WHEN s6.t1 IN ('integer', 'float') THEN (s6.v0 < ((n0."properties" -> ('$."' || ? || '"')) ->> '$')) ELSE NULL END) FROM (SELECT x.v0 AS v0, (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t1 FROM (SELECT ((CASE lq5.type WHEN 'null' THEN 'null' WHEN 'true' THEN 'true' WHEN 'false' THEN 'false' WHEN 'array' THEN lq5.value WHEN 'object' THEN lq5.value WHEN 'real' THEN (SELECT CASE WHEN s IS NULL THEN NULL WHEN s GLOB '*[^0-9-]*' THEN s ELSE s || '.0' END FROM (SELECT CASE WHEN f IS NULL OR abs(f) > 1.7976931348623157e308 THEN NULL ELSE CASE WHEN CAST(printf('%!.15g', f) AS REAL) = f THEN printf('%!.15g', f) WHEN CAST(printf('%!.16g', f) AS REAL) = f THEN printf('%!.16g', f) ELSE printf('%!.17g', f) END END AS s FROM (SELECT lq5.value AS f))) ELSE json_quote(lq5.value) END) ->> '$') AS v0 LIMIT -1 OFFSET 0) AS x LIMIT -1 OFFSET 0) AS s6) AS p FROM json_each(?) AS lq5 WHERE NOT (lq5.key IS NULL AND lq5.type = 'null')) AS q5) WHEN (s4.t0 IS NULL OR s4.t0 = 'null') THEN NULL ELSE json_extract('{}', '!cypher:6' || substr(random(), 1, 0)) END) FROM (SELECT (CASE json_type(?) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract(?, '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) AS t0 LIMIT -1 OFFSET 0) AS s4) AS c3 FROM "nodes" AS n0 LIMIT ?
-- values: "list", "0", "0", "0", "list", "list", "1", "-1", "1", "list", "1", "1", "-1", "list", "-1", "-1", "list", "list", "list", $key, $key, $key, "max", "max", "max", [1,2], [1,2], [1,2], limit(maxRowsPerStep + 1)"
`;

exports[`sqlite > read: MATCH (n) RETURN n.name AS name ORDER BY name DESC, n.age SKIP $s LIMIT 10 1`] = `
"MATCH (n) RETURN n.name AS name ORDER BY name DESC, n.age SKIP $s LIMIT 10
-- step 1
SELECT (n0."properties" -> ('$."' || ? || '"')) AS c0 FROM "nodes" AS n0 ORDER BY (CASE (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'datetime' THEN 6 WHEN 'localdatetime' THEN 7 WHEN 'date' THEN 8 WHEN 'time' THEN 9 WHEN 'localtime' THEN 10 WHEN 'duration' THEN 11 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('date', 'localtime', 'time', 'localdatetime', 'datetime') THEN (((n0."properties" -> ('$."' || ? || '"')) -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN ((n0."properties" -> ('$."' || ? || '"')) ->> '$') END) DESC, (CASE WHEN (CASE json_type((n0."properties" -> ('$."' || ? || '"'))) WHEN 'integer' THEN 'integer' WHEN 'real' THEN 'float' WHEN 'text' THEN 'string' WHEN 'true' THEN 'boolean' WHEN 'false' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(json_extract((n0."properties" -> ('$."' || ? || '"')), '$."~cypher"'), 'map') WHEN 'null' THEN 'null' END) = 'list' THEN (SELECT COALESCE(group_concat((CASE WHEN lkv.t IN ('integer', 'float') THEN 'I' || (SELECT CASE WHEN f = 0 THEN 'M' WHEN f > 1.7976931348623157e308 THEN 'O' WHEN f < -1.7976931348623157e308 THEN 'K' WHEN f > 0 THEN 'N' || printf('%03d', e + 400) || printf('%.15f', abs(f) / pow(10, e)) ELSE 'L' || printf('%03d', 599 - e) || printf('%.15f', 10 - abs(f) / pow(10, e)) END FROM (SELECT f, max(CASE WHEN abs(f) / pow(10, e0) >= 10 THEN e0 + 1 WHEN abs(f) / pow(10, e0) < 1 THEN e0 - 1 ELSE e0 END, -300) AS e FROM (SELECT f, max(CAST(floor(log10(CASE WHEN f = 0 OR abs(f) > 1.7976931348623157e308 THEN 1 ELSE abs(f) END)) AS INTEGER), -300) AS e0 FROM (SELECT ((lkv.v ->> '$')) AS f)))) WHEN lkv.t = 'string' THEN 'G' || (replace((lkv.v ->> '$'), char(1), char(1, 2)) || char(1, 1)) WHEN lkv.t = 'boolean' THEN 'H' || (CASE WHEN (lkv.v ->> '$') THEN '1' ELSE '0' END) WHEN lkv.t = 'null' THEN 'J' ELSE (CASE lkv.t WHEN 'map' THEN 'B' WHEN 'node' THEN 'C' WHEN 'relat