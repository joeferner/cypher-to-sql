olean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE((($5::jsonb)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t1 OFFSET 0) AS s1)) LIMIT $6
