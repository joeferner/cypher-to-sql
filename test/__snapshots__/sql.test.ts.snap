exports[`postgres > create with database ids: MATCH (a:A), (b:B) CREATE (a)-[:T {k: a.k}]->(b), (b)-[:BACK]->(:New) 1`] = `
"MATCH (a:A), (b:B) CREATE (a)-[:T {k: a.k}]->(b), (b)-[:BACK]->(:New)
-- step 1
SELECT n0."id" AS r0, n1."id" AS r1, ((n0."properties" -> $1::text))::text AS r2 FROM "nodes" AS n0 CROSS JOIN "nodes" AS n1 WHERE (n0."labels" @> jsonb_build_array($2::text)) AND (n1."labels" @> jsonb_build_array($3::text)) LIMIT $4
-- values: "k", "A", "B", limit(maxRowsPerStep + 1)
-- step 2 (for each source row)
INSERT INTO "edges" ("start_id", "end_id", "type", "properties") VALUES ($1, $2, $3, ($4::jsonb)) RETURNING "id" AS id
-- values: row.r0, row.r1, "T", {k: row.r2}
-- step 3 (for each source row)
INSERT INTO "nodes" ("labels", "properties") VALUES (($1::jsonb), ($2::jsonb)) RETURNING "id" AS id
-- values: ["New"], {}
-- step 4 (for each source row)
INSERT INTO "edges" ("start_id", "end_id", "type", "properties") VALUES ($1, $2, $3, ($4::jsonb)) RETURNING "id" AS id
-- values: row.r1, id(entity 1), "BACK", {}"
`;

