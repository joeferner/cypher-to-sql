-- step 5 (after the writes, over the written rows: a, b, r)
SELECT n1."id" AS c0_id, (n1."labels")::text AS c0_labels, (n1."properties")::text AS c0_props, e2."id" AS c1_id, e2."type" AS c1_type, e2."start_id" AS c1_start, e2."end_id" AS c1_end, (e2."properties")::text AS c1_props, ((n3."properties" -> $1::text))::text AS c2 FROM (SELECT s.*, row_number() OVER () AS o FROM (SELECT n1."id" AS c0, e3."id" AS c1, n2."id" AS c2 FROM LATERAL (SELECT e.value, e.ord FROM jsonb_array_elements(CASE WHEN jsonb_typeof(($2::jsonb)) = 'array' THEN ($2::jsonb) END) WITH ORDINALITY AS e(value, ord) UNION ALL SELECT ($2::jsonb), 1 WHERE jsonb_typeof(($2::jsonb)) NOT IN ('array', 'null')) AS r0 LEFT JOIN "nodes" AS n1 ON n1."id" = (jsonb_populate_record(NULL::"nodes", jsonb_build_object('id', (r0.value -> $3::text))))."id" LEFT JOIN "nodes" AS n2 ON n2."id" = (jsonb_populate_record(NULL::"nodes", jsonb_build_object('id', (r0.value -> $4::text))))."id" LEFT JOIN "edges" AS e3 ON e3."id" = (jsonb_populate_record(NULL::"edges", jsonb_build_object('id', (r0.value -> $5::text))))."id" ORDER BY r0.ord) AS s) AS w0 LEFT JOIN "nodes" AS n1 ON n1."id" = w0.c0 LEFT JOIN "edges" AS e2 ON e2."id" = w0.c1 LEFT JOIN "nodes" AS n3 ON n3."id" = w0.c2 WHERE (SELECT (CASE WHEN s0.t0 IS NULL OR s0.t0 = 'null' OR ($6::bigint) IS NULL THEN NULL WHEN s0.t0 IN ('integer', 'float') THEN ((CASE WHEN jsonb_typeof((n1."properties" -> $7::text)) = 'number' THEN (n1."properties" -> $7::text) END)::numeric > ($6::bigint)) ELSE CAST(NULL AS boolean) END) FROM (SELECT (CASE jsonb_typeof((n1."properties" -> $7::text)) WHEN 'number' THEN CASE WHEN ((n1."properties" -> $7::text))::text ~ '^-?[0-9]+$' AND ((n1."properties" -> $7::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n1."properties" -> $7::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 OFFSET 0) AS s0) ORDER BY w0.o LIMIT $8
-- values: "w", writtenRows, "a", "b", "r", "1", "v", limit(maxRowsPerStep + 1)"
