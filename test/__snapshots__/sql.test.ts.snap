"MATCH (n) RETURN DISTINCT n.name AS name ORDER BY name
-- step 1
SELECT * FROM (SELECT DISTINCT ((n0."properties" -> $1::text))::text AS c0, (CASE (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) WHEN 'map' THEN 1 WHEN 'node' THEN 2 WHEN 'relationship' THEN 3 WHEN 'list' THEN 4 WHEN 'path' THEN 5 WHEN 'string' THEN 12 WHEN 'boolean' THEN 13 WHEN 'integer' THEN 14 WHEN 'float' THEN 14 ELSE 99 END) AS k0, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('integer', 'float') THEN (CASE WHEN jsonb_typeof((n0."properties" -> $1::text)) = 'number' THEN (n0."properties" -> $1::text) END)::numeric END) AS k1, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('string') THEN (((n0."properties" -> $1::text) #>> '{}') COLLATE "C") END) AS k2, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('boolean') THEN (CASE WHEN jsonb_typeof((n0."properties" -> $1::text)) = 'boolean' THEN (n0."properties" -> $1::text) END)::boolean END) AS k3, (CASE WHEN (CASE jsonb_typeof((n0."properties" -> $1::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $1::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $1::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $1::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) IN ('list', 'map', 'node', 'relationship', 'path') THEN ((n0."properties" -> $1::text))::text END) AS k4 FROM "nodes" AS n0) AS d ORDER BY d.k0 ASC, d.k1 ASC, d.k2 ASC, d.k3 ASC, d.k4 ASC LIMIT $2
-- values: "name", limit(maxRowsPerStep + 1)"
`;

