"MATCH (n) RETURN CASE n.k WHEN 1 THEN 'one' ELSE 'other' END, CASE WHEN n.k > 1 THEN n.k END
-- step 1
SELECT (SELECT (CASE WHEN (SELECT (CASE WHEN s1.t0 IS NULL OR s1.t0 = 'null' OR ($1::bigint) IS NULL THEN NULL WHEN s1.t0 IN ('integer', 'float') THEN ((CASE WHEN jsonb_typeof((n0."properties" -> $2::text)) = 'number' THEN (n0."properties" -> $2::text) END)::numeric = ($1::bigint)) ELSE FALSE END) FROM (SELECT (CASE jsonb_typeof((n0."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 OFFSET 0) AS s1) THEN ($3::text) ELSE ($4::text) END) FROM (SELECT (CASE jsonb_typeof((n0."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 OFFSET 0) AS s0) AS c0, ((CASE WHEN (SELECT (CASE WHEN s2.t0 IS NULL OR s2.t0 = 'null' OR ($1::bigint) IS NULL THEN NULL WHEN s2.t0 IN ('integer', 'float') THEN ((CASE WHEN jsonb_typeof((n0."properties" -> $2::text)) = 'number' THEN (n0."properties" -> $2::text) END)::numeric > ($1::bigint)) ELSE CAST(NULL AS boolean) END) FROM (SELECT (CASE jsonb_typeof((n0."properties" -> $2::text)) WHEN 'number' THEN CASE WHEN ((n0."properties" -> $2::text))::text ~ '^-?[0-9]+$' AND ((n0."properties" -> $2::text))::numeric BETWEEN -9223372036854775808 AND 9223372036854775807 THEN 'integer' ELSE 'float' END WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'array' THEN 'list' WHEN 'object' THEN COALESCE(((n0."properties" -> $2::text)) ->> '~cypher', 'map') WHEN 'null' THEN 'null' END) AS t0 OFFSET 0) AS s2) THEN (n0."properties" -> $2::text) END))::text AS c1 FROM "nodes" AS n0 LIMIT $5
