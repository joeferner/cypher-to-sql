{
  "name": "cypher-to-sql",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Docker CLI that talks to the host's Docker daemon (for PostgreSQL test
    // containers). Bind mounts resolve on the host, which works because the
    // workspace is mounted at the same path as on the host (see below).
    // moby: false installs Docker CE's CLI; the base image is Debian trixie,
    // where the default Moby packages aren't available.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false }
  },
  // Containers started with `npm run db:up` publish their ports on the host, not
  // in this container, so tests reach PostgreSQL through the host gateway.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "containerEnv": {
    "TEST_POSTGRES_URL": "postgres://cypher:cypher@host.docker.internal:55432/cypher",
    "NEO4J_URL": "bolt://host.docker.internal:57687",
    "ARCADEDB_URL": "http://host.docker.internal:52480"
  },
  // Mount the workspace at the same path as on the host. Claude Code keys its
  // session history (~/.claude/projects/<path>) by the absolute project path,
  // so this makes /resume see the same sessions inside and outside the container.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "mounts": [
    // Claude Code: sessions, memory, settings, credentials
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind",
    // Git identity/aliases (read-only; single-file mounts can't be rewritten in place)
    "source=${localEnv:HOME}/.gitconfig,target=/home/node/.gitconfig,type=bind,readonly",
    // Global git ignore etc.
    "source=${localEnv:HOME}/.config/git,target=/home/node/.config/git,type=bind,readonly",
    // gh auth, used by the git credential helper in .gitconfig
    "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bierner.markdown-emoji",
        "smulyono.reveal",
        "streetsidesoftware.code-spell-checker",
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },
  "postCreateCommand": "git submodule update --init && npm install",
  "remoteUser": "node"
}
